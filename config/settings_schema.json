[
  {
    "name": "theme_info",
    "theme_name": "MT-MUSE",
    "theme_version": "1.0.0",
    "theme_author": "MT-MUSE",
    "theme_documentation_url": "https://muse-rtd.com",
    "theme_support_url": "https://muse-rtd.com"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "color",
        "id": "brand_gold",
        "label": "MUSE Gold",
        "default": "#EFA527"
      },
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Default social share image",
        "info": "Used for Open Graph / Twitter when a page has no image of its own."
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Fonts"
      },
      {
        "type": "paragraph",
        "content": "The site default is Neue Haas Display Light (local file). The Adobe options require the matching families in your Adobe Fonts kit."
      },
      {
        "type": "select",
        "id": "heading_font",
        "label": "Heading font",
        "options": [
          { "value": "site", "label": "Neue Haas Display Light - site default" },
          { "value": "display", "label": "Neue Haas Grotesk Display - Adobe" },
          { "value": "ogg", "label": "Ogg Text - Adobe (serif)" }
        ],
        "default": "site"
      },
      {
        "type": "select",
        "id": "body_font",
        "label": "Body font",
        "options": [
          { "value": "site", "label": "Neue Haas Display Light - site default" },
          { "value": "text", "label": "Neue Haas Grotesk Text - Adobe" }
        ],
        "default": "site"
      }
    ]
  },
  {
    "name": "Coming soon",
    "settings": [
      {
        "type": "paragraph",
        "content": "Tag any product with the tag below to mark it 'coming soon' - a badge appears on its cards and product page, and (optionally) its Add-to-cart button is disabled. Individual sections also have their own 'Show coming soon badge' toggle."
      },
      {
        "type": "text",
        "id": "coming_soon_tag",
        "label": "Product tag that marks 'coming soon'",
        "default": "coming-soon"
      },
      {
        "type": "text",
        "id": "badge_text",
        "label": "Badge text",
        "default": "Coming Soon"
      },
      {
        "type": "checkbox",
        "id": "coming_soon_disable_cart",
        "label": "Disable Add-to-cart for coming-soon products",
        "default": true
      }
    ]
  },
  {
    "name": "Header",
    "settings": [
      {
        "type": "paragraph",
        "content": "Applies site-wide to the standard header (State 1, the top-of-page bar)."
      },
      {
        "type": "range",
        "id": "nav_bg_opacity",
        "label": "Nav bar background opacity",
        "min": 0,
        "max": 100,
        "step": 5,
        "unit": "%",
        "default": 100,
        "info": "Lower values let the page show through the top nav bar. 100 = solid."
      }
    ]
  },
  {
    "name": "Footer",
    "settings": [
      {
        "type": "header",
        "content": "Navigation bar"
      },
      {
        "type": "paragraph",
        "content": "A horizontal row of links shown across the footer on every page. Set here so it stays consistent site-wide."
      },
      {
        "type": "checkbox",
        "id": "footer_show_nav",
        "label": "Show footer navigation bar",
        "default": false
      },
      {
        "type": "link_list",
        "id": "footer_nav_menu",
        "label": "Navigation menu",
        "info": "e.g. Home, Terms, Privacy, Contact, FAQs."
      },
      {
        "type": "select",
        "id": "footer_nav_align",
        "label": "Navigation alignment",
        "options": [
          { "value": "left", "label": "Left" },
          { "value": "center", "label": "Center" },
          { "value": "right", "label": "Right" }
        ],
        "default": "center"
      }
    ]
  }
]
