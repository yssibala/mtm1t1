[
  {
    "name": "theme_info",
    "theme_name": "MT-MUSE",
    "theme_version": "1.0.0",
    "theme_author": "MT-MUSE",
    "theme_documentation_url": "https://muse-rtd.com",
    "theme_support_url": "https://muse-rtd.com"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "color",
        "id": "brand_gold",
        "label": "MUSE Gold",
        "default": "#EFA527"
      },
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Default social share image",
        "info": "Used for Open Graph / Twitter when a page has no image of its own."
      }
    ]
  },
  {
    "name": "Wording & brand voice",
    "settings": [
      {
        "type": "paragraph",
        "content": "Site-wide text used in more than one place. Change it here once and every section that inherits it updates. Individual sections can still override with their own text."
      },
      {
        "type": "header",
        "content": "Brand voice"
      },
      {
        "type": "text",
        "id": "brand_eyebrow",
        "label": "Brand eyebrow / tagline",
        "default": "Amongst the Clouds",
        "info": "Small line used above headings (e.g. on the Coming Soon page)."
      },
      {
        "type": "text",
        "id": "age_statement",
        "label": "Responsibility / age line",
        "default": "Enjoy Responsibly · 21+"
      },
      {
        "type": "header",
        "content": "Newsletter"
      },
      {
        "type": "text",
        "id": "newsletter_name",
        "label": "Newsletter name",
        "default": "The Cloud Dispatch",
        "info": "e.g. shown as the signup heading on the Share Your Muse page."
      },
      {
        "type": "text",
        "id": "newsletter_button",
        "label": "Default signup button label",
        "default": "Subscribe"
      },
      {
        "type": "textarea",
        "id": "newsletter_consent",
        "label": "Newsletter consent line",
        "default": "Yes, send me launches, events & the occasional note from amongst the clouds. 21+ only."
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Fonts"
      },
      {
        "type": "paragraph",
        "content": "The site default is Neue Haas Display Light (local file). The Adobe options require the matching families in your Adobe Fonts kit."
      },
      {
        "type": "select",
        "id": "heading_font",
        "label": "Heading font",
        "options": [
          { "value": "site", "label": "Neue Haas Display Light - site default" },
          { "value": "display", "label": "Neue Haas Grotesk Display - Adobe" },
          { "value": "ogg", "label": "Ogg Text - Adobe (serif)" }
        ],
        "default": "site"
      },
      {
        "type": "select",
        "id": "body_font",
        "label": "Body font",
        "options": [
          { "value": "site", "label": "Neue Haas Display Light - site default" },
          { "value": "text", "label": "Neue Haas Grotesk Text - Adobe" }
        ],
        "default": "site"
      }
    ]
  },
  {
    "name": "Age verification",
    "settings": [
      {
        "type": "paragraph",
        "content": "A site-wide overlay that asks visitors to confirm their date of birth before entering. Remembered per browser. Does not show in the theme editor or on the password page. Note: a client-side gate is standard for 21+ brands but can be bypassed by clearing browser storage."
      },
      {
        "type": "checkbox",
        "id": "age_gate_enable",
        "label": "Enable age verification gate",
        "default": false
      },
      {
        "type": "range",
        "id": "age_min",
        "label": "Minimum age",
        "min": 18,
        "max": 25,
        "step": 1,
        "unit": "yrs",
        "default": 21
      },
      {
        "type": "checkbox",
        "id": "age_show_monogram",
        "label": "Show floating monogram",
        "default": true
      },
      {
        "type": "text",
        "id": "age_kicker",
        "label": "Preheader",
        "default": "Amongst the Clouds"
      },
      {
        "type": "text",
        "id": "age_heading",
        "label": "Heading",
        "default": "Are you 21 or older?"
      },
      {
        "type": "textarea",
        "id": "age_text",
        "label": "Text",
        "default": "You must be of legal drinking age to enter."
      },
      {
        "type": "text",
        "id": "age_placeholder",
        "label": "Date field placeholder",
        "default": "MM/DD/YYYY"
      },
      {
        "type": "text",
        "id": "age_button",
        "label": "Button label",
        "default": "Enter"
      },
      {
        "type": "text",
        "id": "age_error",
        "label": "Invalid-date message",
        "default": "Please enter a valid date in MM/DD/YYYY format."
      },
      {
        "type": "textarea",
        "id": "age_deny",
        "label": "Under-age message",
        "default": "Sorry — you must be of legal drinking age to enter."
      },
      {
        "type": "text",
        "id": "age_foot",
        "label": "Footer line",
        "default": "Please enjoy responsibly."
      }
    ]
  },
  {
    "name": "Coming soon",
    "settings": [
      {
        "type": "paragraph",
        "content": "Tag any product with the tag below to mark it 'coming soon' - a badge appears on its cards and product page, and (optionally) its Add-to-cart button is disabled. Individual sections also have their own 'Show coming soon badge' toggle."
      },
      {
        "type": "text",
        "id": "coming_soon_tag",
        "label": "Product tag that marks 'coming soon'",
        "default": "coming-soon"
      },
      {
        "type": "text",
        "id": "badge_text",
        "label": "Badge text",
        "default": "Coming Soon"
      },
      {
        "type": "checkbox",
        "id": "coming_soon_disable_cart",
        "label": "Disable Add-to-cart for coming-soon products",
        "default": true
      }
    ]
  },
  {
    "name": "Header",
    "settings": [
      {
        "type": "paragraph",
        "content": "Applies site-wide to the standard header (State 1, the top-of-page bar)."
      },
      {
        "type": "range",
        "id": "nav_bg_opacity",
        "label": "Nav bar background opacity",
        "min": 0,
        "max": 100,
        "step": 5,
        "unit": "%",
        "default": 100,
        "info": "Lower values let the page show through the top nav bar. 100 = solid."
      }
    ]
  },
  {
    "name": "Footer",
    "settings": [
      {
        "type": "header",
        "content": "Navigation bar"
      },
      {
        "type": "paragraph",
        "content": "A horizontal row of links shown across the footer on every page. Set here so it stays consistent site-wide."
      },
      {
        "type": "checkbox",
        "id": "footer_show_nav",
        "label": "Show footer navigation bar",
        "default": false
      },
      {
        "type": "link_list",
        "id": "footer_nav_menu",
        "label": "Navigation menu",
        "info": "e.g. Home, Terms, Privacy, Contact, FAQs."
      },
      {
        "type": "select",
        "id": "footer_nav_align",
        "label": "Navigation alignment",
        "options": [
          { "value": "left", "label": "Left" },
          { "value": "center", "label": "Center" },
          { "value": "right", "label": "Right" }
        ],
        "default": "center"
      }
    ]
  }
]
