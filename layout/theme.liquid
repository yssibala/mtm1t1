<!doctype html>
<html lang="{{ request.locale }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ page_title }}</title>
    {% render 'meta-tags' %}

    <!-- Adobe Fonts (Typekit) — replace the kit ID below with your Adobe Fonts project embed URL -->
    <link rel="preconnect" href="https://use.typekit.net" crossorigin>
    <link rel="stylesheet" href="https://use.typekit.net/jyd8pzu.css">

    <!-- Local font: NeueHaasDisplayLight (served from assets/) -->
    <link rel="preload" href="{{ 'neuehaasdisplaylight.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    {% style %}
      @font-face {
        font-family: 'neuehaasdisplaylight';
        src: url({{ 'neuehaasdisplaylight.woff2' | asset_url }}) format('woff2');
        font-weight: normal;
        font-style: normal;
        font-display: swap;
      }
    {% endstyle %}

    <!-- Theme CSS -->
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    <!-- Merchant-configurable overrides (Settings > Typography / Brand).
         Placed after theme.css so editor choices win over the defaults. -->
    {% style %}
      :root {
        {% if settings.body_font != blank %}--font-text: {%- render 'font-stack', key: settings.body_font -%};{% endif %}
        {% if settings.heading_font != blank %}--font-display: {%- render 'font-stack', key: settings.heading_font -%};{% endif %}
        {% if settings.brand_gold != blank %}--muse-gold-1: {{ settings.brand_gold }};{% endif %}
        --nav-alpha: {{ settings.nav_bg_opacity | default: 100 | divided_by: 100.0 }};
        --carousel-arrow-out: {{ settings.carousel_arrow_offset | default: 24 }}px;
        --carousel-arrow-size: {{ settings.carousel_arrow_size | default: 30 }}px;
      }
    {% endstyle %}

    {{ content_for_header }}
  </head>
  <body class="{{ template | replace: '.', '-' }}">
    {% render 'age-gate' %}
    {% section 'announcement-bar' %}
    {%- comment -%} Per-template nav: product pages use the SPC carousel nav, all others use the standard nav. {%- endcomment -%}
    {%- case template.name -%}
      {%- when 'product' -%}
        {% section 'header-spc' %}
      {%- else -%}
        {% section 'header' %}
    {%- endcase -%}
    <main role="main" class="main-content">
      {{ content_for_layout }}
    </main>
    {% section 'footer' %}
    {% render 'cart-drawer' %}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
