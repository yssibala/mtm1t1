<!doctype html>
<html lang="{{ request.locale }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ page_title }}</title>
    {% render 'meta-tags' %}

    <link rel="preconnect" href="https://use.typekit.net" crossorigin>
    <link rel="stylesheet" href="https://use.typekit.net/jyd8pzu.css">
    <link rel="preload" href="{{ 'neuehaasdisplaylight.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    {% style %}
      @font-face {
        font-family: 'neuehaasdisplaylight';
        src: url({{ 'neuehaasdisplaylight.woff2' | asset_url }}) format('woff2');
        font-weight: normal; font-style: normal; font-display: swap;
      }
    {% endstyle %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {% style %}
      :root {
        {% if settings.body_font != blank %}--font-text: {{ settings.body_font }};{% endif %}
        {% if settings.heading_font != blank %}--font-display: {{ settings.heading_font }};{% endif %}
        {% if settings.brand_gold != blank %}--muse-gold-1: {{ settings.brand_gold }};{% endif %}
      }
    {% endstyle %}
    {{ content_for_header }}
  </head>
  <body class="template-password">
    {{ content_for_layout }}
  </body>
</html>
