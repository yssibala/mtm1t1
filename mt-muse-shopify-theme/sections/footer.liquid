{%- liquid
  assign s = section.settings
-%}
<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand footer-brand--{{ s.brand_align | default: 'left' }}">
        {%- if settings.logo != blank -%}
          <img src="{{ settings.logo | image_url: width: 240 }}" alt="{{ shop.name | escape }}" width="120" height="{{ 120 | times: settings.logo.height | divided_by: settings.logo.width }}">
        {%- else -%}
          <img src="{{ 'muse-name-logo-blk.svg' | asset_url }}" alt="{{ shop.name | escape }}" width="140" height="34">
        {%- endif -%}
        {%- if s.tagline != blank -%}<p class="footer-tagline">{{ s.tagline }}</p>{%- endif -%}
        {%- if s.show_social -%}
          <div class="footer-social">
            {%- if s.instagram != blank -%}<a href="{{ s.instagram }}" aria-label="Instagram" target="_blank" rel="noopener"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a>{%- endif -%}
            {%- if s.tiktok != blank -%}<a href="{{ s.tiktok }}" aria-label="TikTok" target="_blank" rel="noopener"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M16 3c.3 2.2 1.7 3.7 3.8 4v2.7c-1.4.1-2.7-.3-3.8-1v5.6a5.6 5.6 0 1 1-5.6-5.6c.3 0 .6 0 .9.1v2.8a2.8 2.8 0 1 0 2 2.7V3H16Z"/></svg></a>{%- endif -%}
            {%- if s.facebook != blank -%}<a href="{{ s.facebook }}" aria-label="Facebook" target="_blank" rel="noopener"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M14 9h3V6h-3c-1.9 0-3 1.4-3 3.2V11H9v3h2v6h3v-6h2.5l.5-3H14V9.5c0-.3.2-.5.6-.5Z"/></svg></a>{%- endif -%}
            {%- if s.twitter != blank -%}<a href="{{ s.twitter }}" aria-label="X" target="_blank" rel="noopener"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18 3h3l-7 8 8 10h-6l-5-6-5 6H3l8-9L3 3h6l4 5 5-5Z"/></svg></a>{%- endif -%}
            {%- if s.youtube != blank -%}<a href="{{ s.youtube }}" aria-label="YouTube" target="_blank" rel="noopener"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12s0-3-.4-4.4a2.5 2.5 0 0 0-1.8-1.8C18.4 5.5 12 5.5 12 5.5s-6.4 0-7.8.3A2.5 2.5 0 0 0 2.4 7.6C2 9 2 12 2 12s0 3 .4 4.4a2.5 2.5 0 0 0 1.8 1.8c1.4.3 7.8.3 7.8.3s6.4 0 7.8-.3a2.5 2.5 0 0 0 1.8-1.8C22 15 22 12 22 12Zm-12 3V9l5 3-5 3Z"/></svg></a>{%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div class="footer-cols">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'menu' -%}
              {%- assign fmenu = linklists[block.settings.menu] -%}
              <div class="footer-col" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}<h3 class="footer-col__head">{{ block.settings.heading }}</h3>{%- endif -%}
                <ul>
                  {%- for link in fmenu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
                </ul>
              </div>
            {%- when 'text' -%}
              <div class="footer-col" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}<h3 class="footer-col__head">{{ block.settings.heading }}</h3>{%- endif -%}
                <div class="rte footer-col__text">{{ block.settings.text }}</div>
              </div>
          {%- endcase -%}
        {%- endfor -%}

        {%- if s.show_newsletter -%}
          <div class="footer-col footer-newsletter">
            {%- if s.newsletter_heading != blank -%}<h3 class="footer-col__head">{{ s.newsletter_heading }}</h3>{%- endif -%}
            {%- form 'customer' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              {%- if form.posted_successfully? -%}
                <p class="footer-newsletter__ok">Thanks for subscribing.</p>
              {%- else -%}
                <div class="footer-newsletter__row">
                  <input type="email" name="contact[email]" placeholder="Email address" aria-label="Email" required>
                  <button type="submit" class="muse-pill muse-cta">Join</button>
                </div>
              {%- endif -%}
            {%- endform -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- if settings.footer_show_nav and settings.footer_nav_menu != blank -%}
      <nav class="footer-nav" style="text-align:{{ settings.footer_nav_align | default: 'center' }};">
        {%- for link in linklists[settings.footer_nav_menu].links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
      </nav>
    {%- endif -%}

    <div class="footer-bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ s.copyright_extra }}</p>
      {%- if s.show_payment_icons -%}
        <div class="footer-payments">
          {%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag: class: 'payment-icon' }}{%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Live the legends we'll tell." },
    { "type": "select", "id": "brand_align", "label": "Brand alignment (logo + tagline)", "options": [
        { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ], "default": "left" },
    { "type": "paragraph", "content": "The footer navigation bar is now set in Theme settings > Footer, so it stays consistent site-wide." },
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter signup", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "Join the muse list" },
    { "type": "header", "content": "Social links" },
    { "type": "checkbox", "id": "show_social", "label": "Show social icons", "default": true },
    { "type": "url", "id": "instagram", "label": "Instagram" },
    { "type": "url", "id": "tiktok", "label": "TikTok" },
    { "type": "url", "id": "facebook", "label": "Facebook" },
    { "type": "url", "id": "twitter", "label": "X / Twitter" },
    { "type": "url", "id": "youtube", "label": "YouTube" },
    { "type": "header", "content": "Bottom bar" },
    { "type": "text", "id": "copyright_extra", "label": "Extra copyright text" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    { "type": "menu", "name": "Menu column", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
      { "type": "link_list", "id": "menu", "label": "Menu" } ] },
    { "type": "text", "name": "Text column", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "About" },
      { "type": "richtext", "id": "text", "label": "Text" } ] }
  ],
  "max_blocks": 4
}
{% endschema %}
