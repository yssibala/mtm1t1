{%- comment -%}
  Nutrition SPC nav — used on the product nutrition-table pages.
  Same two-state behaviour as header-spc, but the center carousel cycles a
  NAVIGATION MENU of nutrition pages (Clio / Ourania / Thalia) instead of a
  product collection, so it jumps between the flavours' nutrition tables and
  starts on the current page.
{%- endcomment -%}

{%- liquid
  assign menu_left = linklists[section.settings.menu_left]
  assign menu_right = linklists[section.settings.menu_right]
  assign threshold = section.settings.scroll_threshold
  assign switch_menu = linklists[section.settings.switcher_menu]
-%}

{%- capture spc_json -%}[{%- for l in switch_menu.links limit: 24 -%}{"name":{{ l.title | json }},"url":{{ l.url | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]{%- endcapture -%}

<nav id="site-nav" class="nav--spc" style="{%- render 'nav-style-vars', s: section.settings -%}">

  {%- render 'nav-state1',
    menu_left: menu_left, menu_right: menu_right,
    section_logo: section.settings.logo,
    show_account: section.settings.show_account,
    show_search: section.settings.show_search -%}

  <!-- STATE 2 (SPC grid: left | switcher | right) -->
  <div id="nav-state2" class="nav-bar nav-bar--2">
    <div style="display:flex;align-items:center;gap:24px;justify-self:start;">
      {%- render 'nav-logo', section_logo: section.settings.logo -%}
      <div class="nav-links">
        {%- render 'nav-links', menu: menu_left, fallback: 'left' -%}
      </div>
    </div>

    <div class="spc-switcher" style="justify-self:center;">
      <button class="spc-arrow js-spc-prev" aria-label="Previous nutrition table"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m15 18-6-6 6-6"/></svg></button>
      <a class="spc-name js-spc-name" href="{{ switch_menu.links.first.url | default: routes.all_products_collection_url }}">{{ switch_menu.links.first.title | default: 'NUTRITION' }}</a>
      <button class="spc-arrow js-spc-next" aria-label="Next nutrition table"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m9 18 6-6-6-6"/></svg></button>
    </div>

    <div style="display:flex;align-items:center;justify-content:flex-end;gap:24px;justify-self:end;">
      <div class="nav-links">
        {%- render 'nav-links', menu: menu_right, fallback: 'right' -%}
      </div>
      {%- render 'nav-icons', show_account: section.settings.show_account, show_search: section.settings.show_search -%}
    </div>
  </div>

  <!-- MOBILE (hamburger | logo + switcher | cart) -->
  <div id="nav-mobile">
    <button id="mob-hamburger" aria-label="Open menu" aria-expanded="false"><span></span><span></span><span></span></button>
    {%- render 'nav-logo', section_logo: section.settings.logo -%}
    <a href="{{ routes.cart_url }}" class="nav-icon" data-cart-open aria-label="Cart">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
      <span class="cart-badge" data-cart-count{% if cart.item_count == 0 %} style="display:none;"{% endif %}>{{ cart.item_count }}</span>
    </a>
  </div>
  <div class="spc-mobile-bar">
    <button class="spc-arrow js-spc-prev" aria-label="Previous nutrition table"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m15 18-6-6 6-6"/></svg></button>
    <a class="spc-name js-spc-name" href="{{ switch_menu.links.first.url | default: routes.all_products_collection_url }}">{{ switch_menu.links.first.title | default: 'NUTRITION' }}</a>
    <button class="spc-arrow js-spc-next" aria-label="Next nutrition table"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m9 18 6-6-6-6"/></svg></button>
  </div>
  {%- render 'nav-mobile-menu', menu_left: menu_left, menu_right: menu_right -%}

</nav>

<script>
  (function () {
    var nav = document.getElementById('site-nav');
    if (!nav) return;
    var threshold = {{ threshold | default: 40 | json }};
    function applyOverride() {
      var ov = document.querySelector('[data-nav-threshold]');
      if (ov) { var v = parseInt(ov.getAttribute('data-nav-threshold'), 10); if (!isNaN(v) && v >= 0) { threshold = v; } }
    }
    function compute() {
      if (window.scrollY > threshold) { nav.classList.add('nav--scrolled'); }
      else { nav.classList.remove('nav--scrolled'); }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () { applyOverride(); compute(); });
    } else { applyOverride(); }
    window.addEventListener('scroll', compute, { passive: true });
    window.addEventListener('pageshow', compute);
    compute();

    var burger = document.getElementById('mob-hamburger');
    var menu = document.getElementById('nav-mobile-menu');
    if (burger && menu) {
      burger.addEventListener('click', function () {
        var open = menu.classList.toggle('is-open');
        burger.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    }

    // ---- Nutrition-table switcher ----
    var items = {{ spc_json }};
    if (!items.length) return;
    var current = {{ request.path | json }};
    var idx = 0;
    for (var i = 0; i < items.length; i++) {
      var u = (items[i].url || '').split('?')[0];
      if (u === current || (current && u && u.replace(/\/$/, '') === current.replace(/\/$/, ''))) { idx = i; break; }
    }

    var names = nav.querySelectorAll('.js-spc-name');

    function apply() {
      var it = items[idx];
      for (var n = 0; n < names.length; n++) { names[n].textContent = it.name; names[n].setAttribute('href', it.url); }
    }
    // Arrows navigate straight to the previous/next nutrition page
    function go(d) {
      var ni = (idx + d + items.length) % items.length;
      if (items[ni]) window.location.href = items[ni].url;
    }
    var prevs = nav.querySelectorAll('.js-spc-prev');
    var nexts = nav.querySelectorAll('.js-spc-next');
    for (var a = 0; a < prevs.length; a++) { prevs[a].addEventListener('click', function () { go(-1); }); }
    for (var b = 0; b < nexts.length; b++) { nexts[b].addEventListener('click', function () { go(1); }); }

    document.addEventListener('keydown', function (e) {
      if (!nav.classList.contains('nav--scrolled')) return;
      if (e.key === 'ArrowLeft') { go(-1); }
      else if (e.key === 'ArrowRight') { go(1); }
    });

    apply();
  })();
</script>

{% schema %}
{
  "name": "Header (Nutrition SPC)",
  "settings": [
    { "type": "paragraph", "content": "Nutrition-table nav. Auto-used on pages whose template contains \"nutrition\". State 2 shows a carousel that jumps between the flavours' nutrition tables." },
    { "type": "header", "content": "Menus" },
    { "type": "link_list", "id": "menu_left", "label": "Left menu", "info": "Falls back to About / Gallery / Contact." },
    { "type": "link_list", "id": "menu_right", "label": "Right menu", "info": "Falls back to Products / Shop / Log in." },
    { "type": "header", "content": "Nutrition switcher" },
    { "type": "link_list", "id": "switcher_menu", "label": "Nutrition pages menu", "info": "Build a menu in Navigation listing the nutrition pages (Clio / Ourania / Thalia). The center carousel cycles these and starts on the current page." },
    { "type": "header", "content": "Logo" },
    { "type": "image_picker", "id": "logo", "label": "Logo (overrides theme logo)" },
    { "type": "header", "content": "Icons" },
    { "type": "checkbox", "id": "show_account", "label": "Show account icon", "default": true },
    { "type": "checkbox", "id": "show_search", "label": "Show search icon", "default": true },
    { "type": "header", "content": "Nav text" },
    { "type": "select", "id": "nav_font", "label": "Font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" },
        { "value": "display", "label": "Neue Haas Grotesk Display" },
        { "value": "text", "label": "Neue Haas Grotesk Text" },
        { "value": "ogg", "label": "Ogg Text (serif)" } ], "default": "site" },
    { "type": "select", "id": "nav_weight", "label": "Weight", "options": [
        { "value": "300", "label": "Light (300)" },
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semibold (600)" },
        { "value": "700", "label": "Bold (700)" } ], "default": "500" },
    { "type": "range", "id": "nav_size", "label": "Size", "min": 10, "max": 18, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "nav_ls", "label": "Letter spacing", "info": "1 = theme default, up to 10x.", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },
    { "type": "select", "id": "nav_transform", "label": "Text case", "options": [
        { "value": "uppercase", "label": "UPPERCASE" },
        { "value": "none", "label": "As typed" },
        { "value": "capitalize", "label": "Capitalize" } ], "default": "uppercase" },
    { "type": "color", "id": "nav_color", "label": "Color", "info": "Blank = theme default." },
    { "type": "color", "id": "nav_hover_color", "label": "Hover color", "info": "Blank = theme gold." },
    { "type": "header", "content": "Behavior" },
    { "type": "range", "id": "scroll_threshold", "label": "Scroll distance before compact state (px)", "min": 0, "max": 400, "step": 10, "default": 40 }
  ]
}
{% endschema %}
