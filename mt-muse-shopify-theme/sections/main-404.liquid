{%- liquid
  assign s = section.settings
  assign align = s.text_align | default: 'center'
  assign flex_align = 'center'
  if align == 'left'
    assign flex_align = 'flex-start'
  elsif align == 'right'
    assign flex_align = 'flex-end'
  endif
  assign side_margin = 'auto'
  if align == 'left'
    assign side_margin = '0'
  endif
-%}
<div class="cloud-page" style="align-items:{{ flex_align }};text-align:{{ align }};{% if s.bg_color != blank %}background:{{ s.bg_color }};{% endif %}{% if s.bg_image != blank %}background-image:url('{{ s.bg_image | image_url: width: 2200 }}');background-size:cover;background-position:center;{% endif %}{% if s.padding_top %}padding-top:{{ s.padding_top }}px;{% endif %}{% if s.padding_bottom %}padding-bottom:{{ s.padding_bottom }}px;{% endif %}">
  {%- if s.show_watermark -%}
    <div class="cloud-watermark" aria-hidden="true"{% if s.watermark_color != blank %} style="color:{{ s.watermark_color }};"{% endif %}>{{ s.watermark_text | default: '404' }}</div>
  {%- endif -%}
  {%- if s.show_monogram -%}
    <img class="cloud-monogram" src="{{ 'muse-monogram-solo-gld.png' | asset_url }}" alt="{{ shop.name | escape }}" width="497" height="477" style="height:clamp(64px,8vw,{{ s.monogram_size | default: 88 }}px);">
  {%- endif -%}
  {%- if s.kicker != blank -%}
    <div class="cloud-kicker" style="font-family:{%- render 'font-stack', key: s.preheader_font -%};{% if s.accent_color != blank %}color:{{ s.accent_color }};{% endif %}margin-bottom:{{ s.space_preheader | default: 16 }}px;{%- render 'letter-spacing', mult: s.ls_preheader, base: '0.32em' -%}">{{ s.kicker }}</div>
  {%- endif -%}
  <h1 class="cloud-title" style="font-family:{%- render 'font-stack', key: s.heading_font -%};{%- render 'font-variant', key: s.heading_weight, font: s.heading_font -%}{%- render 'letter-spacing', mult: s.ls_heading, base: '0.01em' -%}{% if s.heading_color != blank %}color:{{ s.heading_color }};{% endif %}{% if s.heading_size > 0 %}font-size:{{ s.heading_size }}px;{% endif %}{% unless align == 'center' %}max-width:none;{% endunless %}">{{ s.heading | default: 'Something Went Awry' | newline_to_br }}</h1>
  {%- if s.text != blank -%}
    <p class="cloud-text" style="font-family:{%- render 'font-stack', key: s.body_font -%};{%- render 'letter-spacing', mult: s.ls_body, base: '0.03em' -%}{% if s.body_color != blank %}color:{{ s.body_color }};{% endif %}{% if s.body_size > 0 %}font-size:{{ s.body_size }}px;{% endif %}margin-top:{{ s.space_heading | default: 20 }}px;margin-left:{{ side_margin }};margin-right:{% if align == 'right' %}0{% else %}{{ side_margin }}{% endif %};">{{ s.text | newline_to_br }}</p>
  {%- endif -%}
  {%- if s.btn1_label != blank or s.btn2_label != blank -%}
    <div class="cloud-actions">
      {%- if s.btn1_label != blank -%}<a href="{{ s.btn1_link | default: routes.root_url }}" class="muse-pill {% if s.btn1_style == 'ghost' %}muse-ghost{% else %}muse-cta{% endif %}">{{ s.btn1_label }}</a>{%- endif -%}
      {%- if s.btn2_label != blank -%}<a href="{{ s.btn2_link | default: routes.all_products_collection_url }}" class="muse-pill {% if s.btn2_style == 'ghost' %}muse-ghost{% else %}muse-cta{% endif %}">{{ s.btn2_label }}</a>{%- endif -%}
    </div>
  {%- endif -%}
</div>
{% schema %}
{
  "name": "404",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Preheader", "default": "Lost in the Clouds" },
    { "type": "textarea", "id": "heading", "label": "Heading", "info": "Press Enter for a line break.", "default": "Something Went Awry" },
    { "type": "textarea", "id": "text", "label": "Text", "info": "Press Enter for a line break.", "default": "We couldn’t pour this page just now. The skies should clear shortly — give it another moment, or head back to firmer ground." },
    { "type": "select", "id": "text_align", "label": "Alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ], "default": "center" },
    { "type": "header", "content": "Watermark" },
    { "type": "checkbox", "id": "show_watermark", "label": "Show large watermark", "default": true },
    { "type": "text", "id": "watermark_text", "label": "Watermark text", "default": "404" },
    { "type": "color", "id": "watermark_color", "label": "Watermark color", "info": "Blank = faint theme gold." },
    { "type": "header", "content": "Monogram" },
    { "type": "checkbox", "id": "show_monogram", "label": "Show floating monogram", "default": true },
    { "type": "range", "id": "monogram_size", "label": "Monogram max size", "min": 48, "max": 200, "step": 4, "unit": "px", "default": 88 },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "btn1_label", "label": "Button 1 label", "default": "Back to homepage" },
    { "type": "url", "id": "btn1_link", "label": "Button 1 link", "info": "Blank = homepage." },
    { "type": "select", "id": "btn1_style", "label": "Button 1 style", "options": [ { "value": "primary", "label": "Gold (filled)" }, { "value": "ghost", "label": "Outline" } ], "default": "primary" },
    { "type": "text", "id": "btn2_label", "label": "Button 2 label", "default": "Shop all" },
    { "type": "url", "id": "btn2_link", "label": "Button 2 link", "info": "Blank = all products." },
    { "type": "select", "id": "btn2_style", "label": "Button 2 style", "options": [ { "value": "primary", "label": "Gold (filled)" }, { "value": "ghost", "label": "Outline" } ], "default": "ghost" },
    { "type": "header", "content": "Typography" },
    { "type": "select", "id": "preheader_font", "label": "Preheader font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" },
        { "value": "display", "label": "Neue Haas Grotesk Display (Adobe)" },
        { "value": "text", "label": "Neue Haas Grotesk Text (Adobe)" },
        { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "site" },
    { "type": "color", "id": "accent_color", "label": "Preheader color", "info": "Blank = theme gold." },
    { "type": "select", "id": "heading_font", "label": "Heading font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" },
        { "value": "display", "label": "Neue Haas Grotesk Display (Adobe)" },
        { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "ogg" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "info": "0 = responsive (auto).", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 0 },
    { "type": "color", "id": "heading_color", "label": "Heading color", "info": "Blank = theme default." },
    { "type": "select", "id": "heading_weight", "label": "Heading weight & style", "options": [
        { "value": "inherit", "label": "Theme default" },
        { "value": "thin", "label": "Thin (200)" },
        { "value": "book", "label": "Book / Light (300)" },
        { "value": "book-italic", "label": "Book Italic (300)" },
        { "value": "roman", "label": "Roman / Regular (400)" },
        { "value": "roman-italic", "label": "Roman Italic (400)" },
        { "value": "medium", "label": "Medium (500)" },
        { "value": "medium-italic", "label": "Medium Italic (500)" },
        { "value": "bold", "label": "Bold (700)" },
        { "value": "black", "label": "Black (800)" } ], "default": "inherit" },
    { "type": "select", "id": "body_font", "label": "Body font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" },
        { "value": "text", "label": "Neue Haas Grotesk Text (Adobe)" },
        { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "site" },
    { "type": "range", "id": "body_size", "label": "Body text size", "info": "0 = responsive (auto).", "min": 0, "max": 28, "step": 1, "unit": "px", "default": 0 },
    { "type": "color", "id": "body_color", "label": "Body color", "info": "Blank = theme default." },
    { "type": "header", "content": "Text spacing" },
    { "type": "range", "id": "space_preheader", "label": "Space after preheader", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "space_heading", "label": "Space after heading", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 20 },
    { "type": "header", "content": "Letter spacing" },
    { "type": "range", "id": "ls_preheader", "label": "Preheader letter spacing", "info": "1 = theme default, up to 10x wider.", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },
    { "type": "range", "id": "ls_heading", "label": "Heading letter spacing", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },
    { "type": "range", "id": "ls_body", "label": "Body letter spacing", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },
    { "type": "header", "content": "Background" },
    { "type": "color", "id": "bg_color", "label": "Background color", "info": "Blank = theme default." },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "header", "content": "Spacing & height" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 40 }
  ]
}
{% endschema %}
