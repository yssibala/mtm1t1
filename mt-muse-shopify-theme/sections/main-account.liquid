{%- liquid assign s = section.settings -%}
<div class="section-wrap account-page{% if s.extend_behind_header %} section-wrap--bleed{% endif %}" style="{%- render 'section-style', st: s -%}">
  <div class="container">
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;">
      <h1 style="font-family:{%- render 'font-stack', key: s.heading_font -%};{%- render 'font-variant', key: s.heading_weight, font: s.heading_font -%}{% if s.heading_color != blank %}color:{{ s.heading_color }};{% endif %}font-size:{{ s.heading_size | default: 44 }}px;">{{ s.heading | default: 'My account' }}</h1>
      <div style="display:flex;gap:12px;">
        <a href="{{ routes.account_addresses_url }}" class="muse-pill muse-ghost">{{ s.addresses_label | default: 'Addresses' }}</a>
        <a href="{{ routes.account_logout_url }}" class="muse-pill muse-ghost">{{ s.logout_label | default: 'Log out' }}</a>
      </div>
    </div>
    <p style="color:var(--text-meta);">{{ s.welcome_text | default: 'Welcome' }}{% if customer.first_name %}, {{ customer.first_name }}{% endif %}.</p>

    <h2 style="font-size:var(--fs-h3);margin-top:32px;">{{ s.orders_heading | default: 'Order history' }}</h2>
    {%- paginate customer.orders by 20 -%}
      {%- if customer.orders.size > 0 -%}
        <table style="width:100%;border-collapse:collapse;">
          <thead><tr style="text-align:left;border-bottom:1px solid var(--sand-border);">
            <th style="padding:10px 8px;">Order</th><th>Date</th><th>Total</th><th>Status</th>
          </tr></thead>
          <tbody>
            {%- for order in customer.orders -%}
              <tr style="border-bottom:1px solid var(--sand-border);">
                <td style="padding:10px 8px;"><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
                <td>{{ order.created_at | date: '%b %d, %Y' }}</td>
                <td>{{ order.total_price | money }}</td>
                <td>{{ order.financial_status_label }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
        {{ paginate | default_pagination }}
      {%- else -%}
        <p>{{ s.no_orders_text | default: 'You haven’t placed any orders yet.' }}</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>
{% schema %}
{
  "name": "Account",
  "settings": [
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "My account" },
    { "type": "text", "id": "welcome_text", "label": "Welcome text", "default": "Welcome" },
    { "type": "text", "id": "orders_heading", "label": "Orders heading", "default": "Order history" },
    { "type": "text", "id": "no_orders_text", "label": "No-orders text", "default": "You haven’t placed any orders yet." },
    { "type": "text", "id": "addresses_label", "label": "Addresses button", "default": "Addresses" },
    { "type": "text", "id": "logout_label", "label": "Log-out button", "default": "Log out" },
    { "type": "header", "content": "Typography" },
    { "type": "select", "id": "heading_font", "label": "Heading font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" },
        { "value": "display", "label": "Neue Haas Grotesk Display (Adobe)" },
        { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "site" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 80, "step": 2, "unit": "px", "default": 44 },
    { "type": "color", "id": "heading_color", "label": "Heading color", "info": "Blank = theme default." },
    { "type": "select", "id": "heading_weight", "label": "Heading weight & style", "options": [
        { "value": "inherit", "label": "Theme default" },
        { "value": "thin", "label": "Thin (200)" },
        { "value": "book", "label": "Book / Light (300)" },
        { "value": "roman", "label": "Roman / Regular (400)" },
        { "value": "medium", "label": "Medium (500)" },
        { "value": "bold", "label": "Bold (700)" },
        { "value": "black", "label": "Black (800)" } ], "default": "inherit" },
    { "type": "header", "content": "Background" },
    { "type": "select", "id": "bg_type", "label": "Background type", "options": [ { "value": "none", "label": "None" }, { "value": "solid", "label": "Solid color" }, { "value": "gradient", "label": "Gradient" }, { "value": "image", "label": "Image" } ], "default": "none" },
    { "type": "color", "id": "bg_color", "label": "Solid color", "default": "#FBF6EE" },
    { "type": "color", "id": "bg_gradient_start", "label": "Gradient start", "default": "#FBF6EE" },
    { "type": "color", "id": "bg_gradient_end", "label": "Gradient end", "default": "#E7DAC4" },
    { "type": "range", "id": "bg_gradient_angle", "label": "Gradient angle", "min": 0, "max": 360, "step": 10, "unit": "deg", "default": 180 },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "header", "content": "Spacing & height" },
    { "type": "checkbox", "id": "extend_behind_header", "label": "Extend background behind header", "default": false },
    { "type": "select", "id": "content_valign", "label": "Vertical content position", "info": "Applies when a minimum height is set.", "options": [ { "value": "top", "label": "Top" }, { "value": "center", "label": "Center" }, { "value": "bottom", "label": "Bottom" } ], "default": "top" },
    { "type": "range", "id": "min_height", "label": "Minimum height", "min": 0, "max": 1000, "step": 20, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 40 }
  ]
}
{% endschema %}
