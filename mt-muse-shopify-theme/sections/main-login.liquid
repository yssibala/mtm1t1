{%- liquid
  assign s = section.settings
  assign align = s.text_align | default: 'center'
  assign mode = s.page_mode | default: 'login'
-%}
<div class="section-wrap account-page{% if s.extend_behind_header %} section-wrap--bleed{% endif %}{% if s.coming_soon %} is-coming-soon{% endif %}"{% if s.coming_soon %} data-cs-label="{{ settings.badge_text | default: 'Coming Soon' | escape }}"{% endif %} style="{%- render 'section-style', st: s -%}">
  <div class="container">
    <div class="page-contact__head" style="text-align:{{ align }};margin-left:auto;margin-right:auto;">
      {%- if s.preheader != blank -%}<div class="kicker" style="font-family:{%- render 'font-stack', key: s.preheader_font -%};{% if s.accent_color != blank %}color:{{ s.accent_color }};{% endif %}margin-bottom:{{ s.space_preheader | default: 10 }}px;{%- render 'letter-spacing', mult: s.ls_preheader, base: '0.18em' -%}{% if align == 'center' %}text-align:center;{% endif %}">{{ s.preheader }}</div>{%- endif -%}
      <h1 style="font-family:{%- render 'font-stack', key: s.heading_font -%};{%- render 'font-variant', key: s.heading_weight, font: s.heading_font -%}{%- render 'letter-spacing', mult: s.ls_heading, base: '0.05em' -%}{% if s.heading_color != blank %}color:{{ s.heading_color }};{% endif %}font-size:{{ s.heading_size | default: 44 }}px;margin-bottom:{{ s.space_heading | default: 12 }}px;">{{ s.heading | default: 'Log in' }}</h1>
      {%- if s.intro_text != blank -%}<div class="rte page-contact__intro" style="font-family:{%- render 'font-stack', key: s.body_font -%};{% if s.body_color != blank %}color:{{ s.body_color }};{% endif %}{% if s.body_size > 0 %}font-size:{{ s.body_size }}px;{% endif %}{% if align == 'center' %}margin-left:auto;margin-right:auto;{% endif %}">{{ s.intro_text }}</div>{%- endif -%}
    </div>

    <div class="account-wrap">
      <div class="account-card{% if s.card_border == false %} account-card--noborder{% endif %}"{% if s.card_bg != blank %} style="background:{{ s.card_bg }};"{% endif %}>
        {%- if mode == 'coming_soon' -%}
          <p class="page-contact__intro" style="text-align:{{ align }};margin:0;">{{ s.coming_soon_text | default: 'Member accounts are coming soon. Check back closer to launch.' }}</p>
          {%- if s.coming_soon_link != blank -%}<div style="text-align:{{ align }};margin-top:20px;"><a href="{{ s.coming_soon_link }}" class="muse-pill muse-cta">{{ s.coming_soon_button | default: 'Back home' }}</a></div>{%- endif -%}
        {%- else -%}
          <div class="account-form">
            {%- form 'customer_login' -%}
              {{ form.errors | default_errors }}
              <label for="ci-email">{{ s.email_label | default: 'Email' }}</label>
              <input type="email" name="customer[email]" id="ci-email" autocomplete="email" required>
              {%- if form.password_needed -%}
                <label for="ci-pass">{{ s.password_label | default: 'Password' }}</label>
                <input type="password" name="customer[password]" id="ci-pass" autocomplete="current-password">
                <a href="#recover" onclick="document.getElementById('recover').style.display='block';return false;" style="display:inline-block;margin:10px 0;font-size:var(--fs-small);">{{ s.forgot_label | default: 'Forgot your password?' }}</a>
              {%- endif -%}
              <button type="submit" class="muse-pill muse-cta" style="width:100%;margin-top:12px;">{{ s.signin_label | default: 'Sign in' }}</button>
            {%- endform -%}
          </div>

          <div id="recover" style="display:none;margin-top:24px;">
            <h2 style="font-size:var(--fs-h3);">{{ s.recover_heading | default: 'Reset your password' }}</h2>
            {%- form 'recover_customer_password' -%}
              {{ form.errors | default_errors }}
              {%- if form.posted_successfully? -%}<p>{{ s.recover_success | default: 'We’ve sent you an email with a link to reset your password.' }}</p>{%- endif -%}
              <div class="account-form">
                <label for="rc-email">{{ s.email_label | default: 'Email' }}</label>
                <input type="email" name="email" id="rc-email" autocomplete="email" required>
                <button type="submit" class="muse-pill muse-ghost" style="margin-top:12px;">{{ s.recover_button | default: 'Send reset link' }}</button>
              </div>
            {%- endform -%}
          </div>

          {%- if s.show_register -%}<p style="text-align:center;margin-top:24px;">{{ s.register_prompt | default: 'New here?' }} <a href="{{ routes.account_register_url }}">{{ s.register_label | default: 'Create an account' }}</a></p>{%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Login",
  "settings": [
    { "type": "header", "content": "Coming soon" },
    { "type": "checkbox", "id": "coming_soon", "label": "Grey out + show \"coming soon\" badge", "default": false },
    { "type": "select", "id": "page_mode", "label": "Mode", "info": "\"Login form\" shows the sign-in form. \"Coming soon message\" hides it and shows a message instead (accounts not yet live).", "options": [
        { "value": "login", "label": "Login form" },
        { "value": "coming_soon", "label": "Coming soon message" } ], "default": "login" },
    { "type": "header", "content": "Header" },
    { "type": "text", "id": "preheader", "label": "Preheader", "default": "Members" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Log in" },
    { "type": "richtext", "id": "intro_text", "label": "Intro / body text" },
    { "type": "select", "id": "text_align", "label": "Header alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ], "default": "center" },
    { "type": "header", "content": "Coming soon message" },
    { "type": "textarea", "id": "coming_soon_text", "label": "Message", "default": "Member accounts are coming soon. Check back closer to launch." },
    { "type": "url", "id": "coming_soon_link", "label": "Button link" },
    { "type": "text", "id": "coming_soon_button", "label": "Button label", "default": "Back home" },
    { "type": "header", "content": "Login form labels" },
    { "type": "text", "id": "email_label", "label": "Email label", "default": "Email" },
    { "type": "text", "id": "password_label", "label": "Password label", "default": "Password" },
    { "type": "text", "id": "signin_label", "label": "Sign-in button", "default": "Sign in" },
    { "type": "text", "id": "forgot_label", "label": "Forgot-password link", "default": "Forgot your password?" },
    { "type": "text", "id": "recover_heading", "label": "Reset heading", "default": "Reset your password" },
    { "type": "text", "id": "recover_button", "label": "Reset button", "default": "Send reset link" },
    { "type": "checkbox", "id": "show_register", "label": "Show \"create an account\" link", "default": true },
    { "type": "text", "id": "register_prompt", "label": "Register prompt", "default": "New here?" },
    { "type": "text", "id": "register_label", "label": "Register link", "default": "Create an account" },
    { "type": "header", "content": "Card" },
    { "type": "checkbox", "id": "card_border", "label": "Card border & shadow", "default": true },
    { "type": "color", "id": "card_bg", "label": "Card background", "info": "Blank = theme default." },
    { "type": "header", "content": "Typography" },
    { "type": "select", "id": "preheader_font", "label": "Preheader font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" },
        { "value": "display", "label": "Neue Haas Grotesk Display (Adobe)" },
        { "value": "text", "label": "Neue Haas Grotesk Text (Adobe)" },
        { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "site" },
    { "type": "color", "id": "accent_color", "label": "Preheader color", "info": "Blank = theme default." },
    { "type": "select", "id": "heading_font", "label": "Heading font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" },
        { "value": "display", "label": "Neue Haas Grotesk Display (Adobe)" },
        { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "ogg" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 80, "step": 2, "unit": "px", "default": 44 },
    { "type": "color", "id": "heading_color", "label": "Heading color", "info": "Blank = theme default." },
    { "type": "select", "id": "heading_weight", "label": "Heading weight & style", "options": [
        { "value": "inherit", "label": "Theme default" },
        { "value": "thin", "label": "Thin (200)" },
        { "value": "book", "label": "Book / Light (300)" },
        { "value": "book-italic", "label": "Book Italic (300)" },
        { "value": "roman", "label": "Roman / Regular (400)" },
        { "value": "roman-italic", "label": "Roman Italic (400)" },
        { "value": "medium", "label": "Medium (500)" },
        { "value": "medium-italic", "label": "Medium Italic (500)" },
        { "value": "bold", "label": "Bold (700)" },
        { "value": "black", "label": "Black (800)" } ], "default": "inherit" },
    { "type": "select", "id": "body_font", "label": "Intro text font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" },
        { "value": "text", "label": "Neue Haas Grotesk Text (Adobe)" },
        { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "site" },
    { "type": "range", "id": "body_size", "label": "Intro text size", "info": "0 = theme default.", "min": 0, "max": 28, "step": 1, "unit": "px", "default": 0 },
    { "type": "color", "id": "body_color", "label": "Intro text color", "info": "Blank = theme default." },
    { "type": "header", "content": "Text spacing" },
    { "type": "range", "id": "space_preheader", "label": "Space after preheader", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 10 },
    { "type": "range", "id": "space_heading", "label": "Space after heading", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 12 },
    { "type": "header", "content": "Letter spacing" },
    { "type": "range", "id": "ls_preheader", "label": "Preheader letter spacing", "info": "1 = theme default, up to 10x wider.", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },
    { "type": "range", "id": "ls_heading", "label": "Heading letter spacing", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },
    { "type": "header", "content": "Background" },
    { "type": "select", "id": "bg_type", "label": "Background type", "options": [ { "value": "none", "label": "None" }, { "value": "solid", "label": "Solid color" }, { "value": "gradient", "label": "Gradient" }, { "value": "image", "label": "Image" } ], "default": "none" },
    { "type": "color", "id": "bg_color", "label": "Solid color", "default": "#FBF6EE" },
    { "type": "color", "id": "bg_gradient_start", "label": "Gradient start", "default": "#FBF6EE" },
    { "type": "color", "id": "bg_gradient_end", "label": "Gradient end", "default": "#E7DAC4" },
    { "type": "range", "id": "bg_gradient_angle", "label": "Gradient angle", "min": 0, "max": 360, "step": 10, "unit": "deg", "default": 180 },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "header", "content": "Spacing & height" },
    { "type": "checkbox", "id": "extend_behind_header", "label": "Extend background behind header", "info": "Pulls the section up so its background sits under the nav bar. Add Top padding to keep content clear of the nav.", "default": false },
    { "type": "select", "id": "content_valign", "label": "Vertical content position", "info": "Applies when a minimum height is set.", "options": [ { "value": "top", "label": "Top" }, { "value": "center", "label": "Center" }, { "value": "bottom", "label": "Bottom" } ], "default": "top" },
    { "type": "range", "id": "min_height", "label": "Minimum height", "min": 0, "max": 1000, "step": 20, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 96 }
  ]
}
{% endschema %}
