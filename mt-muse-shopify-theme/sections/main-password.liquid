{%- liquid
  assign s = section.settings
  comment
    'presale'  = storefront is locked; show the Shopify password field + email capture.
    'launched' = store is open; hide the password field entirely (use this section on a
                 normal page, since the password template only renders while locked).
    'message'  = announcement only; no password field and no signup form.
  endcomment
  assign mode = s.page_mode | default: 'presale'
  assign show_password = false
  if mode == 'presale' and template.name == 'password'
    assign show_password = true
  endif
  assign show_newsletter = false
  if s.show_newsletter and mode != 'message'
    assign show_newsletter = true
  endif
-%}
<div class="cloud-page">
  <img class="cloud-monogram" src="{{ 'muse-monogram-solo-gld.png' | asset_url }}" alt="{{ shop.name | escape }}" width="497" height="477" style="height:clamp(108px,14vw,150px);">
  <div class="cloud-kicker">{{ s.kicker | default: 'Amongst the Clouds' }}</div>
  <h1 class="cloud-title">{{ s.heading | default: 'Coming Soon' }}</h1>
  <p class="cloud-text">{{ s.text | default: "We’re crafting something worth celebrating. This page is still amongst the clouds — check back soon to raise a glass with us." }}</p>

  {%- if show_newsletter -%}
    <div style="margin-top:28px;position:relative;z-index:1;width:100%;max-width:460px;">
      {%- form 'customer' -%}
        <input type="hidden" name="contact[tags]" value="newsletter, prelaunch">
        {%- if form.posted_successfully? -%}
          <p class="cloud-text" style="margin-top:0;">{{ s.success_text | default: 'Thank you — we’ll be in touch soon.' }}</p>
        {%- else -%}
          <div class="cloud-password">
            <input type="email" name="contact[email]" placeholder="{{ s.email_label | default: 'Email address' }}" aria-label="Email" required>
            <button type="submit" class="muse-pill muse-cta">{{ s.newsletter_button | default: 'Notify me' }}</button>
          </div>
          {%- if s.show_consent -%}
            <label class="cloud-consent">
              <input type="checkbox" name="contact[accepts_marketing]" value="true" required>
              <span>{{ s.consent_text | default: 'Email me about the launch. I can unsubscribe at any time.' }}</span>
            </label>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
  {%- endif -%}

  {%- if show_password -%}
    <div style="margin-top:34px;position:relative;z-index:1;">
      {%- form 'storefront_password' -%}
        {{ form.errors | default_errors }}
        <div class="cloud-password">
          <input type="password" name="password" placeholder="{{ s.password_label | default: 'Enter store password' }}" aria-label="Store password">
          <button type="submit" class="muse-pill muse-ghost">Enter</button>
        </div>
      {%- endform -%}
    </div>
  {%- endif -%}

  <div class="cloud-foot">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }} &middot; Enjoy Responsibly &middot; 21+</div>
</div>
{% schema %}
{
  "name": "Coming soon / Password",
  "settings": [
    { "type": "select", "id": "page_mode", "label": "Version", "info": "Presale shows the store-password field (Password template only). Launched hides it — use that version on a normal page once the store is open. Message only shows no forms at all.", "options": [
        { "value": "presale", "label": "Presale — password + email signup" },
        { "value": "launched", "label": "Launched — email signup, no password" },
        { "value": "message", "label": "Message only — no password, no email" } ], "default": "presale" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Amongst the Clouds" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Coming Soon" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "We’re crafting something worth celebrating. This page is still amongst the clouds — check back soon to raise a glass with us." },
    { "type": "header", "content": "Email signup" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show email signup", "info": "Ignored in \"Message only\" mode.", "default": true },
    { "type": "text", "id": "email_label", "label": "Email field placeholder", "default": "Email address" },
    { "type": "text", "id": "newsletter_button", "label": "Signup button label", "default": "Notify me" },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "Thank you — we’ll be in touch soon." },
    { "type": "checkbox", "id": "show_consent", "label": "Require marketing-consent checkbox", "info": "Visitors must tick this before the form will submit — makes opt-in explicit.", "default": true },
    { "type": "textarea", "id": "consent_text", "label": "Consent text", "default": "Email me about the launch. I can unsubscribe at any time." },
    { "type": "header", "content": "Password field" },
    { "type": "text", "id": "password_label", "label": "Password field placeholder", "default": "Enter store password" }
  ],
  "presets": [{ "name": "Coming soon" }]
}
{% endschema %}
