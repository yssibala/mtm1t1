{%- liquid
  assign s = section.settings
  assign align = s.text_align | default: 'center'
-%}
<div class="section-wrap search-hero{% if s.extend_behind_header %} section-wrap--bleed{% endif %}{% if s.coming_soon %} is-coming-soon{% endif %}"{% if s.coming_soon %} data-cs-label="{{ settings.badge_text | default: 'Coming Soon' | escape }}"{% endif %} style="{%- render 'section-style', st: s -%}text-align:{{ align }};">
  <div class="container search-hero__inner">
    {%- if s.preheader != blank -%}
      <div class="kicker" style="font-family:{%- render 'font-stack', key: s.preheader_font -%};color:{{ s.accent_color | default: '#C9851A' }};margin-bottom:{{ s.space_preheader | default: 12 }}px;{%- render 'letter-spacing', mult: s.ls_preheader, base: '0.18em' -%}{% if align == 'center' %}text-align:center;{% endif %}">{{ s.preheader }}</div>
    {%- endif -%}
    {%- if s.heading != blank -%}
      <h1 class="{%- render 'mb-size', val: s.heading_size, def: 56, cls: 'mb-h' -%}" style="font-family:{%- render 'font-stack', key: s.heading_font -%};{%- render 'font-variant', key: s.heading_weight, font: s.heading_font -%}{%- render 'letter-spacing', mult: s.ls_heading, base: '0.05em' -%}{% if s.heading_color != blank %}color:{{ s.heading_color }};{% endif %}font-size:{{ s.heading_size }}px;margin-bottom:{{ s.space_heading | default: 16 }}px;">{{ s.heading | newline_to_br }}</h1>
    {%- endif -%}
    {%- if s.subheading != blank -%}
      <p class="{%- render 'mb-size', val: s.body_size, def: 18, cls: 'mb-body' -%}" style="max-width:620px;{% if align == 'center' %}margin-left:auto;margin-right:auto;{% endif %}font-family:{%- render 'font-stack', key: s.body_font -%};{%- render 'font-variant', key: s.body_weight, font: s.body_font -%}{%- render 'letter-spacing', mult: s.ls_body, base: '0.03em' -%}{% if s.body_color != blank %}color:{{ s.body_color }};{% endif %}font-size:{{ s.body_size | default: 18 }}px;margin-bottom:0;">{{ s.subheading | newline_to_br }}</p>
    {%- endif -%}

    <form action="{{ routes.search_url }}" method="get" role="search" class="search-hero__form" style="margin-top:{{ s.space_search | default: 28 }}px;{% if align == 'center' %}margin-left:auto;margin-right:auto;{% elsif align == 'right' %}margin-left:auto;{% endif %}max-width:{{ s.search_width | default: 620 }}px;">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ s.search_placeholder | default: 'Search products' }}" aria-label="Search" style="font-family:{%- render 'font-stack', key: s.body_font -%};">
      <button type="submit" class="muse-pill muse-cta" style="{% if s.button_style == 'ghost' %}{% endif %}">{{ s.button_label | default: 'Search' }}</button>
    </form>
  </div>

  {%- if search.performed -%}
    <div class="container" style="margin-top:var(--space-xl);text-align:left;">
      <p class="kicker" style="margin-bottom:var(--space-lg);">{{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %} for &ldquo;{{ search.terms | escape }}&rdquo;</p>
      {%- if search.results_count > 0 -%}
        <div class="grid search-hero__results">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {%- render 'product-card', product: item -%}
            {%- else -%}
              <a href="{{ item.url }}" class="search-hero__link">{{ item.title }}</a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>
{% schema %}
{
  "name": "Search",
  "settings": [
    { "type": "header", "content": "Coming soon" },
    { "type": "checkbox", "id": "coming_soon", "label": "Grey out + show \"coming soon\" badge", "default": false },
    { "type": "text", "id": "preheader", "label": "Preheader (eyebrow)", "default": "Find your MUSE" },
    { "type": "color", "id": "accent_color", "label": "Preheader color", "default": "#C9851A" },
    { "type": "textarea", "id": "heading", "label": "Heading", "info": "Press Enter for a line break.", "default": "Search" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "info": "Press Enter for a line break." },
    { "type": "select", "id": "text_align", "label": "Alignment", "options": [
        { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ], "default": "center" },
    { "type": "header", "content": "Search bar" },
    { "type": "text", "id": "search_placeholder", "label": "Placeholder", "default": "Search products" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Search" },
    { "type": "range", "id": "search_width", "label": "Search bar max width", "min": 320, "max": 900, "step": 20, "unit": "px", "default": 620 },
    { "type": "header", "content": "Typography" },
    { "type": "select", "id": "preheader_font", "label": "Preheader font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" },
        { "value": "display", "label": "Neue Haas Grotesk Display (Adobe)" },
        { "value": "text", "label": "Neue Haas Grotesk Text (Adobe)" },
        { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "site" },
    { "type": "select", "id": "heading_font", "label": "Heading font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" },
        { "value": "display", "label": "Neue Haas Grotesk Display (Adobe)" },
        { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "ogg" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 28, "max": 96, "step": 2, "unit": "px", "default": 56 },
    { "type": "color", "id": "heading_color", "label": "Heading color", "info": "Leave blank to use the theme default." },
    { "type": "select", "id": "heading_weight", "label": "Heading weight & style", "options": [
        { "value": "inherit", "label": "Theme default" },
        { "value": "thin", "label": "Thin (200)" },
        { "value": "book", "label": "Book / Light (300)" },
        { "value": "book-italic", "label": "Book Italic (300)" },
        { "value": "roman", "label": "Roman / Regular (400)" },
        { "value": "roman-italic", "label": "Roman Italic (400)" },
        { "value": "medium", "label": "Medium (500)" },
        { "value": "medium-italic", "label": "Medium Italic (500)" },
        { "value": "bold", "label": "Bold (700)" },
        { "value": "black", "label": "Black (800)" } ], "default": "inherit" },
    { "type": "select", "id": "body_font", "label": "Body font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" },
        { "value": "text", "label": "Neue Haas Grotesk Text (Adobe)" },
        { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "site" },
    { "type": "range", "id": "body_size", "label": "Body text size", "min": 14, "max": 28, "step": 1, "unit": "px", "default": 18 },
    { "type": "color", "id": "body_color", "label": "Subheading color", "info": "Leave blank to use the theme default." },
    { "type": "select", "id": "body_weight", "label": "Body weight & style", "options": [
        { "value": "inherit", "label": "Theme default" },
        { "value": "thin", "label": "Thin (200)" },
        { "value": "book", "label": "Book / Light (300)" },
        { "value": "book-italic", "label": "Book Italic (300)" },
        { "value": "roman", "label": "Roman / Regular (400)" },
        { "value": "roman-italic", "label": "Roman Italic (400)" },
        { "value": "medium", "label": "Medium (500)" },
        { "value": "medium-italic", "label": "Medium Italic (500)" },
        { "value": "bold", "label": "Bold (700)" },
        { "value": "black", "label": "Black (800)" } ], "default": "inherit" },
    { "type": "header", "content": "Text spacing" },
    { "type": "range", "id": "space_preheader", "label": "Space after preheader", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "space_heading", "label": "Space after heading", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "space_search", "label": "Space above search bar", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 28 },
    { "type": "header", "content": "Letter spacing" },
    { "type": "range", "id": "ls_preheader", "label": "Preheader letter spacing", "info": "1 = theme default, up to 10x wider.", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },
    { "type": "range", "id": "ls_heading", "label": "Heading letter spacing", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },
    { "type": "range", "id": "ls_body", "label": "Body letter spacing", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },
    { "type": "header", "content": "Background" },
    { "type": "select", "id": "bg_type", "label": "Background type", "options": [
        { "value": "none", "label": "None" }, { "value": "solid", "label": "Solid color" }, { "value": "gradient", "label": "Gradient" }, { "value": "image", "label": "Image" } ], "default": "none" },
    { "type": "color", "id": "bg_color", "label": "Solid color", "default": "#FBF6EE" },
    { "type": "color", "id": "bg_gradient_start", "label": "Gradient start", "default": "#FBF6EE" },
    { "type": "color", "id": "bg_gradient_end", "label": "Gradient end", "default": "#E7DAC4" },
    { "type": "range", "id": "bg_gradient_angle", "label": "Gradient angle", "min": 0, "max": 360, "step": 10, "unit": "deg", "default": 180 },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "header", "content": "Spacing & height" },
    { "type": "checkbox", "id": "extend_behind_header", "label": "Extend background behind header", "info": "Pulls the section up so its background sits under the nav bar (no gap above it). Add Top padding below to keep content clear of the nav.", "default": false },
    { "type": "select", "id": "content_valign", "label": "Vertical content position", "info": "Applies when a minimum height is set.", "options": [ { "value": "top", "label": "Top" }, { "value": "center", "label": "Center" }, { "value": "bottom", "label": "Bottom" } ], "default": "top" },
    { "type": "range", "id": "min_height", "label": "Minimum height", "min": 0, "max": 1000, "step": 20, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 96 }
  ]
}
{% endschema %}
