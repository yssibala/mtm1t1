<div class="container" style="padding:var(--section-pad) 0;">
  <h1>Search</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" style="display:flex;gap:12px;max-width:560px;margin-bottom:32px;">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products" style="flex:1;padding:12px 16px;border:1px solid var(--sand-border);border-radius:var(--radius-card);font-family:var(--font-text);">
    <button type="submit" class="muse-pill muse-cta">Search</button>
  </form>
  {%- if search.performed -%}
    <p style="color:var(--text-meta);">{{ search.results_count }} result(s) for &ldquo;{{ search.terms | escape }}&rdquo;</p>
    <div class="grid">
      {%- for item in search.results -%}
        {%- if item.object_type == 'product' -%}
          {%- render 'product-card', product: item -%}
        {%- else -%}
          <a href="{{ item.url }}" style="color:var(--near-black);">{{ item.title }}</a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>
{% schema %}
{ "name": "Search", "settings": [] }
{% endschema %}
