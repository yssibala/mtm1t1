{%- comment -%}
  Nutrition & Ingredients section (product-specific).
  Schema is grouped BY ELEMENT (each element's copy + its own font/color/size/
  letter-spacing together). Two zones:
    INTRO   = back link + preheader + title + subtitle + tagline + intro body
              (togglable via show_intro — hide it to place a Hero above).
    CONTENT = Nutrition Facts heading + FDA label blocks + Ingredients + Warning.
  Fonts/colors/sizes/letter-spacing are applied INLINE on each element (the
  theme's proven pattern) — do NOT move font-stack into the {% style %} block,
  Ogg silently falls back to the global heading font there.
  Letter-spacing bases MUST be non-zero, or calc(base*mult) is always 0.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign accent = s.accent | default: '#C9851A'
  assign c_pre  = s.preheader_color | default: accent
  assign c_head = s.heading_color | default: '#0A0B0C'
  assign c_sub  = s.subtitle_color | default: '#9A8F7C'
  assign c_tag  = s.tagline_color | default: '#6B6156'
  assign c_intro_body = s.intro_body_color | default: '#6B6156'
  assign c_nfk   = s.content_kicker_color | default: accent
  assign c_chead = s.content_heading_color | default: '#0A0B0C'
  assign c_cbody = s.content_body_color | default: '#6B6156'
  assign c_warn  = s.warning_color | default: '#8A8378'
  assign ul_color = s.back_underline_color | default: accent
  assign labels = section.blocks | where: 'type', 'label'
  assign stats = section.blocks | where: 'type', 'stat'
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .nutrition-facts {
    --nf-accent: {{ accent }};
    background: {{ s.bg_color | default: '#FBF6EE' }};
    padding: {{ s.padding_top | default: 72 }}px clamp(20px,5vw,48px) {{ s.padding_bottom | default: 72 }}px;
    color: var(--near-black, #0A0B0C);
  }
  #shopify-section-{{ section.id }} .nf-wrap { max-width: 1080px; margin: 0 auto; }
  #shopify-section-{{ section.id }} .nf-back { display: inline-flex; align-items: center; gap: 6px; text-decoration: none; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; font-weight: 600; margin-bottom: 28px; transition: opacity .25s ease; }
  #shopify-section-{{ section.id }} .nf-back:hover { opacity: .7; }
  #shopify-section-{{ section.id }} .nf-back-label { padding-bottom: 2px; }
  #shopify-section-{{ section.id }} .nf-head { text-align: center; margin-bottom: clamp(32px,5vw,56px); }
  #shopify-section-{{ section.id }} .nf-preheader { font-size: 11px; letter-spacing: .26em; text-transform: uppercase; font-weight: 600; margin-bottom: 14px; }
  #shopify-section-{{ section.id }} .nf-title { font-size: clamp(40px,7vw,72px); line-height: 1.02; margin: 0 0 10px; }
  #shopify-section-{{ section.id }} .nf-subtitle { font-size: 13px; letter-spacing: .22em; text-transform: uppercase; margin: 0 0 12px; }
  #shopify-section-{{ section.id }} .nf-tagline { font-size: 16px; font-style: italic; margin: 0 0 12px; }
  #shopify-section-{{ section.id }} .nf-intro-body { font-size: 15px; line-height: 1.7; margin: 12px auto 0; max-width: 640px; }
  #shopify-section-{{ section.id }} .nf-meta { display: grid; grid-template-columns: repeat({{ stats.size | default: 4 }}, 1fr); gap: 16px; max-width: 760px; margin: 0 auto clamp(40px,6vw,64px); border-top: 1px solid var(--sand-border,#E7DAC4); border-bottom: 1px solid var(--sand-border,#E7DAC4); padding: 26px 0; }
  @media (max-width: 640px){ #shopify-section-{{ section.id }} .nf-meta { grid-template-columns: repeat(2,1fr); gap: 24px 16px; } }
  #shopify-section-{{ section.id }} .nf-stat { text-align: center; }
  #shopify-section-{{ section.id }} .nf-stat-val { font-size: clamp(26px,3.4vw,34px); line-height: 1; }
  #shopify-section-{{ section.id }} .nf-stat-lbl { font-size: 10px; letter-spacing: .16em; text-transform: uppercase; color: var(--text-meta,#9A8F7C); margin-top: 8px; }
  #shopify-section-{{ section.id }} .nf-sec-kicker { text-align: center; font-size: 11px; letter-spacing: .26em; text-transform: uppercase; font-weight: 600; margin-bottom: 8px; }
  #shopify-section-{{ section.id }} .nf-sec-heading { font-size: clamp(28px,3.6vw,42px); text-align: center; margin: 0 0 44px; }
  #shopify-section-{{ section.id }} .nf-labels { display: flex; flex-wrap: wrap; justify-content: center; gap: clamp(28px,5vw,64px); }
  #shopify-section-{{ section.id }} .nf-col { flex: 0 1 340px; }
  #shopify-section-{{ section.id }} .nf-col-title { font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; text-align: center; margin: 0 0 14px; color: var(--text-muted,#8A8378); }
  #shopify-section-{{ section.id }} .nf-box { background: #fff; color: #000; border: 1px solid #000; padding: 10px 14px; font-family: 'Helvetica Neue', Arial, sans-serif; }
  #shopify-section-{{ section.id }} .nf-nm { font-size: 32px; font-weight: 900; line-height: 1; margin-bottom: 2px; }
  #shopify-section-{{ section.id }} .nf-servings { font-size: 12px; margin-bottom: 2px; }
  #shopify-section-{{ section.id }} .nf-serving-size { font-size: 14px; font-weight: 700; margin-bottom: 4px; display: flex; justify-content: space-between; }
  #shopify-section-{{ section.id }} .nf-bar-thick { border-top: 8px solid #000; margin: 4px 0; }
  #shopify-section-{{ section.id }} .nf-bar-med { border-top: 4px solid #000; margin: 2px 0; }
  #shopify-section-{{ section.id }} .nf-bar-thin { border-top: 1px solid #000; margin: 2px 0; }
  #shopify-section-{{ section.id }} .nf-amt-hd { font-size: 11px; font-weight: 700; }
  #shopify-section-{{ section.id }} .nf-cal-row { display: flex; justify-content: space-between; align-items: baseline; margin: 2px 0; }
  #shopify-section-{{ section.id }} .nf-cal-label { font-size: 13px; font-weight: 700; }
  #shopify-section-{{ section.id }} .nf-cal-val { font-size: 36px; font-weight: 900; line-height: 1; }
  #shopify-section-{{ section.id }} .nf-dv-note { font-size: 10px; text-align: right; margin-bottom: 2px; }
  #shopify-section-{{ section.id }} .nf-row { display: flex; justify-content: space-between; font-size: 12px; padding: 1px 0; }
  #shopify-section-{{ section.id }} .nf-ind1 { padding-left: 16px; }
  #shopify-section-{{ section.id }} .nf-ind2 { padding-left: 28px; }
  #shopify-section-{{ section.id }} .nf-b { font-weight: 700; }
  #shopify-section-{{ section.id }} .nf-foot { font-size: 10px; margin-top: 6px; border-top: 4px solid #000; padding-top: 4px; }
  #shopify-section-{{ section.id }} .nf-vits { display: grid; grid-template-columns: 1fr 1fr; gap: 0; }
  #shopify-section-{{ section.id }} .nf-vit { font-size: 11px; padding: 1px 0; border-bottom: 1px solid #ccc; }
  #shopify-section-{{ section.id }} .nf-vit:nth-last-child(-n+2) { border-bottom: none; }
  #shopify-section-{{ section.id }} .nf-ingr { max-width: 720px; margin: clamp(44px,6vw,72px) auto 0; text-align: center; }
  #shopify-section-{{ section.id }} .nf-ingr-h { font-size: clamp(24px,3vw,32px); margin: 0 0 18px; }
  #shopify-section-{{ section.id }} .nf-ingr-p { font-size: 15px; line-height: 1.7; margin: 0 0 16px; }
  #shopify-section-{{ section.id }} .nf-ingr-p strong { color: var(--near-black,#0A0B0C); font-weight: 600; }
  #shopify-section-{{ section.id }} .nf-warn { font-size: 12px; line-height: 1.6; margin: 16px 0 0; }
{%- endstyle -%}

<div class="nutrition-facts{% if s.show_coming_soon %} is-coming-soon{% endif %}"{% if s.show_coming_soon %} data-cs-label="{{ s.badge_text | default: 'Coming soon' }}"{% endif %}>
  {%- if s.show_coming_soon -%}{%- render 'coming-soon-badge' -%}{%- endif -%}
  <div class="nf-wrap">
    {%- if s.back_link != blank -%}
      <a class="nf-back" href="{{ s.back_link }}" style="color:{{ accent }};">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg><span class="nf-back-label"{% if s.back_underline %} style="border-bottom:{{ s.back_underline_weight | default: 1 }}px solid {{ ul_color }};"{% endif %}>{{ s.back_label | default: 'Back' }}</span>
      </a>
    {%- endif -%}

    {%- if s.show_intro -%}
      <div class="nf-head">
        {%- if s.preheader != blank -%}
          <div class="nf-preheader" style="font-family:{%- render 'font-stack', key: s.preheader_font -%};color:{{ c_pre }};{%- render 'letter-spacing', mult: s.ls_preheader, base: '.26em' -%}{% if s.preheader_size > 0 %}font-size:{{ s.preheader_size }}px;{% endif %}margin-bottom:{{ s.space_preheader | default: 14 }}px;">{{ s.preheader }}</div>
        {%- endif -%}
        {%- if s.title != blank -%}
          <h1 class="nf-title" style="font-family:{%- render 'font-stack', key: s.heading_font -%};{%- render 'font-variant', key: s.heading_weight, font: s.heading_font -%}color:{{ c_head }};{%- render 'letter-spacing', mult: s.ls_heading, base: '.02em' -%}{% if s.title_size > 0 %}font-size:{{ s.title_size }}px;{% endif %}margin-bottom:{{ s.space_title | default: 10 }}px;">{{ s.title | newline_to_br }}</h1>
        {%- endif -%}
        {%- if s.subtitle != blank -%}
          <p class="nf-subtitle" style="font-family:{%- render 'font-stack', key: s.subtitle_font -%};color:{{ c_sub }};{%- render 'letter-spacing', mult: s.ls_subtitle, base: '.22em' -%}{% if s.subtitle_size > 0 %}font-size:{{ s.subtitle_size }}px;{% endif %}margin-bottom:{{ s.space_subtitle | default: 12 }}px;">{{ s.subtitle | newline_to_br }}</p>
        {%- endif -%}
        {%- if s.tagline != blank -%}
          <p class="nf-tagline" style="font-family:{%- render 'font-stack', key: s.tagline_font -%};color:{{ c_tag }};{%- render 'letter-spacing', mult: s.ls_tagline, base: '.04em' -%}{% if s.tagline_size > 0 %}font-size:{{ s.tagline_size }}px;{% endif %}margin-bottom:{{ s.space_tagline | default: 12 }}px;">{{ s.tagline | newline_to_br }}</p>
        {%- endif -%}
        {%- if s.intro_body != blank -%}
          <div class="nf-intro-body rte" style="font-family:{%- render 'font-stack', key: s.intro_body_font -%};color:{{ c_intro_body }};{%- render 'letter-spacing', mult: s.ls_intro_body, base: '.02em' -%}{% if s.intro_body_size > 0 %}font-size:{{ s.intro_body_size }}px;{% endif %}margin-bottom:{{ s.space_intro_body | default: 0 }}px;">{{ s.intro_body }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if stats.size > 0 -%}
      <div class="nf-meta">
        {%- for b in stats -%}
          <div class="nf-stat" {{ b.shopify_attributes }}>
            <div class="nf-stat-val" style="font-family:{%- render 'font-stack', key: s.content_heading_font -%};color:{{ accent }};">{{ b.settings.value }}</div>
            <div class="nf-stat-lbl">{{ b.settings.label }}</div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if labels.size > 0 -%}
      {%- if s.nf_kicker != blank -%}<div class="nf-sec-kicker" style="color:{{ c_nfk }};">{{ s.nf_kicker }}</div>{%- endif -%}
      <h2 class="nf-sec-heading" style="font-family:{%- render 'font-stack', key: s.content_heading_font -%};{%- render 'font-variant', key: s.content_heading_weight, font: s.content_heading_font -%}color:{{ c_chead }};{%- render 'letter-spacing', mult: s.content_ls_heading, base: '.02em' -%}{% if s.content_heading_size > 0 %}font-size:{{ s.content_heading_size }}px;{% endif %}">{{ s.nf_heading | default: 'Nutrition Facts' }}</h2>
      <div class="nf-labels">
        {%- for b in labels -%}
          {%- assign bs = b.settings -%}
          <div class="nf-col" {{ b.shopify_attributes }}>
            {%- if bs.col_title != blank -%}<p class="nf-col-title">{{ bs.col_title }}</p>{%- endif -%}
            <div class="nf-box">
              <div class="nf-nm">Nutrition Facts</div>
              {%- if bs.servings != blank -%}<div class="nf-servings">{{ bs.servings }}</div>{%- endif -%}
              <div class="nf-serving-size"><span>Serving size</span><span>{{ bs.serving_size }}</span></div>
              <div class="nf-bar-thick"></div>
              <div class="nf-amt-hd">Amount per serving</div>
              <div class="nf-cal-row"><span class="nf-cal-label">Calories</span><span class="nf-cal-val">{{ bs.calories }}</span></div>
              <div class="nf-bar-thick"></div>
              <div class="nf-dv-note">% Daily Value*</div>
              <div class="nf-bar-thin"></div>
              <div class="nf-row"><span><span class="nf-b">Total Fat</span> {{ bs.total_fat_amt }}</span><span class="nf-b">{{ bs.total_fat_dv }}</span></div>
              <div class="nf-bar-thin"></div>
              <div class="nf-row nf-ind1"><span>Saturated Fat {{ bs.sat_fat_amt }}</span><span>{{ bs.sat_fat_dv }}</span></div>
              <div class="nf-bar-thin"></div>
              <div class="nf-row nf-ind1"><span><em>Trans</em> Fat {{ bs.trans_fat_amt }}</span><span></span></div>
              <div class="nf-bar-thin"></div>
              <div class="nf-row"><span><span class="nf-b">Cholesterol</span> {{ bs.cholesterol_amt }}</span><span class="nf-b">{{ bs.cholesterol_dv }}</span></div>
              <div class="nf-bar-thin"></div>
              <div class="nf-row"><span><span class="nf-b">Sodium</span> {{ bs.sodium_amt }}</span><span class="nf-b">{{ bs.sodium_dv }}</span></div>
              <div class="nf-bar-thin"></div>
              <div class="nf-row"><span><span class="nf-b">Total Carbohydrate</span> {{ bs.total_carb_amt }}</span><span class="nf-b">{{ bs.total_carb_dv }}</span></div>
              <div class="nf-bar-thin"></div>
              <div class="nf-row nf-ind1"><span>Dietary Fiber {{ bs.fiber_amt }}</span><span>{{ bs.fiber_dv }}</span></div>
              <div class="nf-bar-thin"></div>
              <div class="nf-row nf-ind1"><span>Total Sugars {{ bs.total_sugars_amt }}</span><span></span></div>
              <div class="nf-bar-thin"></div>
              <div class="nf-row nf-ind2"><span>Includes {{ bs.added_sugars_amt }} Added Sugars</span><span class="nf-b">{{ bs.added_sugars_dv }}</span></div>
              <div class="nf-bar-thin"></div>
              <div class="nf-row"><span><span class="nf-b">Protein</span> {{ bs.protein_amt }}</span><span></span></div>
              <div class="nf-bar-med"></div>
              <div class="nf-vits">
                <div class="nf-vit">Vitamin D {{ bs.vit_d_amt }} <strong>{{ bs.vit_d_dv }}</strong></div>
                <div class="nf-vit">Calcium {{ bs.calcium_amt }} <strong>{{ bs.calcium_dv }}</strong></div>
                <div class="nf-vit">Iron {{ bs.iron_amt }} <strong>{{ bs.iron_dv }}</strong></div>
                <div class="nf-vit">Potassium {{ bs.potassium_amt }} <strong>{{ bs.potassium_dv }}</strong></div>
                <div class="nf-vit">Vitamin C {{ bs.vit_c_amt }} <strong>{{ bs.vit_c_dv }}</strong></div>
              </div>
              <div class="nf-foot">*The % Daily Value tells you how much a nutrient in a serving of food contributes to a daily diet. 2,000 calories a day is used for general nutrition advice.</div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if s.ingredients != blank or s.warning != blank -%}
      <div class="nf-ingr">
        {%- if s.ingr_heading != blank -%}
          <h3 class="nf-ingr-h" style="font-family:{%- render 'font-stack', key: s.content_heading_font -%};{%- render 'font-variant', key: s.content_heading_weight, font: s.content_heading_font -%}color:{{ c_chead }};{%- render 'letter-spacing', mult: s.content_ls_heading, base: '.02em' -%}{% if s.content_heading_size > 0 %}font-size:{{ s.content_heading_size }}px;{% endif %}">{{ s.ingr_heading }}</h3>
        {%- endif -%}
        {%- if s.ingredients != blank -%}
          <p class="nf-ingr-p" style="font-family:{%- render 'font-stack', key: s.content_body_font -%};color:{{ c_cbody }};{%- render 'letter-spacing', mult: s.content_ls_body, base: '.02em' -%}{% if s.content_body_size > 0 %}font-size:{{ s.content_body_size }}px;{% endif %}">{{ s.ingredients | newline_to_br }}</p>
        {%- endif -%}
        {%- if s.allergens != blank -%}
          <p class="nf-ingr-p" style="font-family:{%- render 'font-stack', key: s.content_body_font -%};color:{{ c_cbody }};{%- render 'letter-spacing', mult: s.content_ls_body, base: '.02em' -%}{% if s.content_body_size > 0 %}font-size:{{ s.content_body_size }}px;{% endif %}"><strong>Allergens:</strong> {{ s.allergens }}</p>
        {%- endif -%}
        {%- if s.warning != blank -%}
          <p class="nf-warn" style="font-family:{%- render 'font-stack', key: s.warning_font -%};color:{{ c_warn }};{%- render 'letter-spacing', mult: s.ls_warning, base: '.01em' -%}{% if s.warning_size > 0 %}font-size:{{ s.warning_size }}px;{% endif %}">{% if s.warning_label != blank %}<strong>{{ s.warning_label }}</strong> {% endif %}{{ s.warning | newline_to_br }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Nutrition & Ingredients",
  "tag": "section",
  "class": "section-nutrition",
  "settings": [
    { "type": "checkbox", "id": "show_coming_soon", "label": "Mark as \"coming soon\"", "default": false },
    { "type": "text", "id": "badge_text", "label": "Coming-soon badge text", "default": "Coming soon" },
    { "type": "color", "id": "accent", "label": "Flavor accent color", "default": "#C9851A" },

    { "type": "header", "content": "Back link" },
    { "type": "url", "id": "back_link", "label": "Back link" },
    { "type": "text", "id": "back_label", "label": "Back label", "default": "Back to product" },
    { "type": "checkbox", "id": "back_underline", "label": "Underline back label", "default": true },
    { "type": "color", "id": "back_underline_color", "label": "Underline color", "info": "Blank = accent." },
    { "type": "range", "id": "back_underline_weight", "label": "Underline weight", "min": 1, "max": 6, "step": 1, "unit": "px", "default": 1 },

    { "type": "header", "content": "Top intro", "info": "Turn off to hide the whole intro block and place a Hero section above instead." },
    { "type": "checkbox", "id": "show_intro", "label": "Show top intro", "default": true },

    { "type": "header", "content": "Intro · Preheader" },
    { "type": "text", "id": "preheader", "label": "Text", "default": "Nutrition & Ingredients" },
    { "type": "select", "id": "preheader_font", "label": "Font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" },
        { "value": "display", "label": "Neue Haas Grotesk Display" },
        { "value": "text", "label": "Neue Haas Grotesk Text" },
        { "value": "ogg", "label": "Ogg Text (serif)" } ], "default": "text" },
    { "type": "color", "id": "preheader_color", "label": "Color", "info": "Blank = accent." },
    { "type": "range", "id": "preheader_size", "label": "Size", "info": "0 = auto.", "min": 0, "max": 32, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "ls_preheader", "label": "Letter spacing", "info": "1 = default, up to 10x.", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },

    { "type": "header", "content": "Intro · Title" },
    { "type": "textarea", "id": "title", "label": "Text", "info": "Press Enter for a line break.", "default": "CLIO" },
    { "type": "select", "id": "heading_font", "label": "Font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" },
        { "value": "display", "label": "Neue Haas Grotesk Display" },
        { "value": "ogg", "label": "Ogg Text (serif)" } ], "default": "ogg" },
    { "type": "select", "id": "heading_weight", "label": "Weight & style", "options": [
        { "value": "inherit", "label": "Theme default" },
        { "value": "thin", "label": "Thin (200)" },
        { "value": "book", "label": "Book / Light (300)" },
        { "value": "book-italic", "label": "Book Italic (300)" },
        { "value": "roman", "label": "Roman / Regular (400)" },
        { "value": "roman-italic", "label": "Roman Italic (400)" },
        { "value": "medium", "label": "Medium (500)" },
        { "value": "medium-italic", "label": "Medium Italic (500)" },
        { "value": "bold", "label": "Bold (700)" },
        { "value": "black", "label": "Black (800)" } ], "default": "medium" },
    { "type": "color", "id": "heading_color", "label": "Color" },
    { "type": "range", "id": "title_size", "label": "Size", "info": "0 = auto.", "min": 0, "max": 96, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "ls_heading", "label": "Letter spacing", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },

    { "type": "header", "content": "Intro · Subtitle" },
    { "type": "textarea", "id": "subtitle", "label": "Text", "info": "Press Enter for a line break.", "default": "SPONTANEITY AT SUNSET" },
    { "type": "select", "id": "subtitle_font", "label": "Font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" },
        { "value": "display", "label": "Neue Haas Grotesk Display" },
        { "value": "text", "label": "Neue Haas Grotesk Text" },
        { "value": "ogg", "label": "Ogg Text (serif)" } ], "default": "text" },
    { "type": "color", "id": "subtitle_color", "label": "Color" },
    { "type": "range", "id": "subtitle_size", "label": "Size", "info": "0 = auto.", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "ls_subtitle", "label": "Letter spacing", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },

    { "type": "header", "content": "Intro · Tagline" },
    { "type": "textarea", "id": "tagline", "label": "Text", "info": "Press Enter for a line break.", "default": "Made with sincerity and mixed with pride." },
    { "type": "select", "id": "tagline_font", "label": "Font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" },
        { "value": "text", "label": "Neue Haas Grotesk Text" },
        { "value": "ogg", "label": "Ogg Text (serif)" } ], "default": "site" },
    { "type": "color", "id": "tagline_color", "label": "Color" },
    { "type": "range", "id": "tagline_size", "label": "Size", "info": "0 = auto.", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 0 },
