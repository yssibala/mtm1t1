{%- liquid
  assign s = section.settings
  assign has_details = false
  if s.show_details
    if s.detail_heading != blank or s.email != blank or s.phone != blank or s.address != blank or s.hours != blank
      assign has_details = true
    endif
  endif
  assign align = s.text_align | default: 'left'
  assign contact_heading = s.heading | default: page.title
  if align == 'left'
    assign head_margin = 'margin-left:0;margin-right:auto;'
  elsif align == 'right'
    assign head_margin = 'margin-left:auto;margin-right:0;'
  else
    assign head_margin = 'margin-left:auto;margin-right:auto;'
  endif
-%}
<div class="section-wrap page-contact{% unless has_details %} page-contact--solo{% endunless %}{% if s.extend_behind_header %} section-wrap--bleed{% endif %}{% if s.coming_soon %} is-coming-soon{% endif %}"{% if s.coming_soon %} data-cs-label="{{ settings.badge_text | default: 'Coming Soon' | escape }}"{% endif %} style="{%- render 'section-style', st: s -%}">
  <div class="container">
    <div class="page-contact__head" style="text-align:{{ align }};{{ head_margin }}">
      {%- if s.kicker != blank -%}<div class="kicker" style="font-family:{%- render 'font-stack', key: s.preheader_font -%};{% if s.accent_color != blank %}color:{{ s.accent_color }};{% endif %}margin-bottom:{{ s.space_preheader | default: 10 }}px;{%- render 'letter-spacing', mult: s.ls_preheader, base: '0.18em' -%}">{{ s.kicker }}</div>{%- endif -%}
      {%- if contact_heading != blank -%}<h1 style="font-family:{%- render 'font-stack', key: s.heading_font -%};{%- render 'font-variant', key: s.heading_weight, font: s.heading_font -%}{%- render 'letter-spacing', mult: s.ls_heading, base: '0.05em' -%}{% if s.heading_color != blank %}color:{{ s.heading_color }};{% endif %}font-size:{{ s.heading_size }}px;margin-bottom:{{ s.space_heading | default: 12 }}px;">{{ contact_heading | newline_to_br }}</h1>{%- endif -%}
      {%- if s.intro_text != blank -%}<div class="rte page-contact__intro" style="font-family:{%- render 'font-stack', key: s.body_font -%};{%- render 'letter-spacing', mult: s.ls_body, base: '0.03em' -%}{% if s.body_color != blank %}color:{{ s.body_color }};{% endif %}{% if s.body_size > 0 %}font-size:{{ s.body_size }}px;{% endif %}">{{ s.intro_text }}</div>{%- elsif page.content != blank -%}<div class="rte page-contact__intro" style="font-family:{%- render 'font-stack', key: s.body_font -%};{% if s.body_size > 0 %}font-size:{{ s.body_size }}px;{% endif %}">{{ page.content }}</div>{%- endif -%}
    </div>
    {%- if s.show_card -%}<div class="contact-card{% if s.card_border == false %} contact-card--flat{% endif %}"{% if s.card_bg != blank %} style="background:{{ s.card_bg }};"{% endif %}>{%- endif -%}
    <div class="page-contact__grid">
      <div class="page-contact__form">
        {%- form 'contact' -%}
          {{ form.errors | default_errors }}
          {%- if form.posted_successfully? -%}<p class="page-contact__ok">Thank you — we’ll be in touch soon.</p>{%- endif -%}
          <div class="field-row">
            <input type="text" name="contact[name]" placeholder="Name" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" aria-label="Name" required>
            <input type="email" name="contact[email]" placeholder="Email" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" aria-label="Email" required>
          </div>
          <input type="tel" name="contact[phone]" placeholder="Phone (optional)" aria-label="Phone">
          <textarea name="contact[body]" rows="5" placeholder="{{ s.ph_message | default: 'How can we help?' }}" aria-label="Message" required>{% if form.body %}{{ form.body }}{% endif %}</textarea>
          <div class="contact-submit"{% if s.btn_align == 'center' %} style="text-align:center;"{% elsif s.btn_align == 'right' %} style="text-align:right;"{% endif %}>
            <button type="submit" class="muse-pill {% if s.btn_style == 'ghost' %}muse-ghost{% else %}muse-cta{% endif %}" style="{% if s.btn_full %}width:100%;{% endif %}font-size:{{ s.btn_size | default: 12 }}px;">{{ s.btn_label | default: 'Send message' }}</button>
          </div>
        {%- endform -%}
      </div>
      {%- if has_details -%}
        <aside class="page-contact__details">
          {%- if s.detail_heading != blank -%}<h3 class="page-contact__dhead">{{ s.detail_heading }}</h3>{%- endif -%}
          {%- if s.email != blank -%}<p><span class="kicker">Email</span><br><a href="mailto:{{ s.email }}">{{ s.email }}</a></p>{%- endif -%}
          {%- if s.phone != blank -%}<p><span class="kicker">Phone</span><br><a href="tel:{{ s.phone }}">{{ s.phone }}</a></p>{%- endif -%}
          {%- if s.address != blank -%}<p><span class="kicker">Address</span><br>{{ s.address }}</p>{%- endif -%}
          {%- if s.hours != blank -%}<p><span class="kicker">Hours</span><br>{{ s.hours }}</p>{%- endif -%}
        </aside>
      {%- endif -%}
    </div>
    {%- if s.show_card -%}</div>{%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "Contact page",
  "settings": [
    { "type": "header", "content": "Coming soon" },
    { "type": "checkbox", "id": "coming_soon", "label": "Grey out + show \"coming soon\" badge", "default": false },
    { "type": "header", "content": "Header" },
    { "type": "text", "id": "kicker", "label": "Preheader", "default": "Get in touch" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Press Enter for a line break. Leave blank to use the page title." },
    { "type": "richtext", "id": "intro_text", "label": "Intro / body text", "info": "Shows under the heading. Leave blank to use the page's body content." },
    { "type": "select", "id": "text_align", "label": "Header alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ], "default": "left" },
    { "type": "header", "content": "Details column" },
    { "type": "checkbox", "id": "show_details", "label": "Show details column", "default": true },
    { "type": "text", "id": "detail_heading", "label": "Details heading", "default": "Reach us" },
    { "type": "text", "id": "email", "label": "Email" },
    { "type": "text", "id": "phone", "label": "Phone" },
    { "type": "textarea", "id": "address", "label": "Address" },
    { "type": "textarea", "id": "hours", "label": "Hours" },
    { "type": "header", "content": "Form card" },
    { "type": "paragraph", "content": "Put the form on a solid card so it stays readable over a section background image (set a Background image below)." },
    { "type": "checkbox", "id": "show_card", "label": "Put form on a card", "default": false },
    { "type": "checkbox", "id": "card_border", "label": "Card border & shadow", "default": true },
    { "type": "color", "id": "card_bg", "label": "Card background", "info": "Blank = theme default (near-white)." },
    { "type": "header", "content": "Send-message button" },
    { "type": "text", "id": "btn_label", "label": "Button label", "default": "Send message" },
    { "type": "select", "id": "btn_style", "label": "Button style", "options": [ { "value": "primary", "label": "Gold (filled)" }, { "value": "ghost", "label": "Outline" } ], "default": "primary" },
    { "type": "select", "id": "btn_align", "label": "Button alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ], "default": "left" },
    { "type": "checkbox", "id": "btn_full", "label": "Full width", "default": false },
    { "type": "range", "id": "btn_size", "label": "Button text size", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 12 },
    { "type": "text", "id": "ph_message", "label": "Message field placeholder", "default": "How can we help?" },
    { "type": "header", "content": "Typography" },
    { "type": "select", "id": "preheader_font", "label": "Preheader font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" },
        { "value": "display", "label": "Neue Haas Grotesk Display (Adobe)" },
        { "value": "text", "label": "Neue Haas Grotesk Text (Adobe)" },
        { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "site" },
    { "type": "color", "id": "accent_color", "label": "Preheader color", "info": "Blank = theme default." },
    { "type": "select", "id": "heading_font", "label": "Heading font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" },
        { "value": "display", "label": "Neue Haas Grotesk Display (Adobe)" },
        { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "site" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 80, "step": 2, "unit": "px", "default": 44 },
    { "type": "color", "id": "heading_color", "label": "Heading color", "info": "Blank = theme default." },
    { "type": "select", "id": "heading_weight", "label": "Heading weight & style", "options": [
        { "value": "inherit", "label": "Theme default" },
        { "value": "thin", "label": "Thin (200)" },
        { "value": "book", "label": "Book / Light (300)" },
        { "value": "book-italic", "label": "Book Italic (300)" },
        { "value": "roman", "label": "Roman / Regular (400)" },
        { "value": "roman-italic", "label": "Roman Italic (400)" },
        { "value": "medium", "label": "Medium (500)" },
        { "value": "medium-italic", "label": "Medium Italic (500)" },
        { "value": "bold", "label": "Bold (700)" },
        { "value": "black", "label": "Black (800)" } ], "default": "inherit" },
    { "type": "select", "id": "body_font", "label": "Intro text font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" },
        { "value": "text", "label": "Neue Haas Grotesk Text (Adobe)" },
        { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "site" },
    { "type": "range", "id": "body_size", "label": "Intro text size", "info": "0 = theme default.", "min": 0, "max": 28, "step": 1, "unit": "px", "default": 0 },
    { "type": "color", "id": "body_color", "label": "Intro text color", "info": "Blank = theme default." },
    { "type": "header", "content": "Text spacing" },
    { "type": "range", "id": "space_preheader", "label": "Space after preheader", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 10 },
    { "type": "range", "id": "space_heading", "label": "Space after heading", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 12 },
    { "type": "header", "content": "Letter spacing" },
    { "type": "range", "id": "ls_preheader", "label": "Preheader letter spacing", "info": "1 = theme default, up to 10x wider.", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },
    { "type": "range", "id": "ls_heading", "label": "Heading letter spacing", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },
    { "type": "range", "id": "ls_body", "label": "Intro letter spacing", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },
    { "type": "header", "content": "Background" },
    { "type": "select", "id": "bg_type", "label": "Background type", "options": [ { "value": "none", "label": "None" }, { "value": "solid", "label": "Solid color" }, { "value": "gradient", "label": "Gradient" }, { "value": "image", "label": "Image" } ], "default": "none" },
    { "type": "color", "id": "bg_color", "label": "Solid color", "default": "#FBF6EE" },
    { "type": "color", "id": "bg_gradient_start", "label": "Gradient start", "default": "#FBF6EE" },
    { "type": "color", "id": "bg_gradient_end", "label": "Gradient end", "default": "#E7DAC4" },
    { "type": "range", "id": "bg_gradient_angle", "label": "Gradient angle", "min": 0, "max": 360, "step": 10, "unit": "deg", "default": 180 },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "header", "content": "Spacing & height" },
    { "type": "checkbox", "id": "extend_behind_header", "label": "Extend background behind header", "info": "Pulls the section up so its background sits under the nav bar. Add Top padding to keep content clear of the nav.", "default": false },
    { "type": "select", "id": "content_valign", "label": "Vertical content position", "info": "Applies when a minimum height is set.", "options": [ { "value": "top", "label": "Top" }, { "value": "center", "label": "Center" }, { "value": "bottom", "label": "Bottom" } ], "default": "top" },
    { "type": "range", "id": "min_height", "label": "Minimum height", "min": 0, "max": 1000, "step": 20, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 }
  ],
  "presets": [{ "name": "Contact page" }]
}
{% endschema %}
