{%- liquid
  assign s = section.settings
  comment
    Build a unique, order-preserving list of category names from the blocks.
    Wrapping each in '||' guards makes the `contains` de-dupe exact.
  endcomment
  assign cat_list = ''
  for block in section.blocks
    assign c = block.settings.category | default: '' | strip
    if c != blank
      assign guard = c | prepend: '||' | append: '||'
      unless cat_list contains guard
        assign cat_list = cat_list | append: '||' | append: c | append: '||'
      endunless
    endif
  endfor
  assign cats = cat_list | split: '||'
  assign has_filters = false
  if s.show_filters and cats.size > 0
    assign has_filters = true
  endif
-%}
<div class="section-wrap page-gallery{% if s.coming_soon %} is-coming-soon{% endif %}" data-gallery="{{ section.id }}"{% if s.coming_soon %} data-cs-label="{{ settings.badge_text | default: 'Coming Soon' | escape }}"{% endif %} style="{%- render 'section-style', st: s -%}">
  <div class="container">
    <div class="page-gallery__head" style="text-align:{{ s.text_align | default: 'left' }};{% if s.text_align == 'center' %}margin-left:auto;margin-right:auto;{% endif %}">
      {%- if s.kicker != blank -%}<div class="kicker" style="font-family:{%- render 'font-stack', key: s.preheader_font -%};margin-bottom:{{ s.space_preheader | default: 10 }}px;{%- render 'letter-spacing', mult: s.ls_preheader, base: '0.18em' -%}{% if s.accent_color != blank %}color:{{ s.accent_color }};{% endif %}">{{ s.kicker }}</div>{%- endif -%}
      <h1 style="font-family:{%- render 'font-stack', key: s.heading_font -%};{%- render 'font-variant', key: s.heading_weight, font: s.heading_font -%}{%- render 'letter-spacing', mult: s.ls_heading, base: '0.05em' -%}{% if s.heading_color != blank %}color:{{ s.heading_color }};{% endif %}font-size:{{ s.heading_size }}px;">{{ s.heading | default: page.title | newline_to_br }}</h1>
      {%- if s.intro_text != blank -%}<div class="rte page-gallery__intro">{{ s.intro_text }}</div>{%- elsif page.content != blank and s.use_page_body -%}<div class="rte page-gallery__intro">{{ page.content }}</div>{%- endif -%}
    </div>

    {%- if has_filters -%}
      <div class="page-gallery__filters" style="justify-content:{% if s.text_align == 'center' %}center{% else %}flex-start{% endif %};">
        <button type="button" class="gallery-filter is-active" data-gfilter="all">{{ s.filter_all_label | default: 'All' }}</button>
        {%- for cat in cats -%}
          {%- if cat != blank -%}<button type="button" class="gallery-filter" data-gfilter="{{ cat | handleize }}">{{ cat }}</button>{%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="page-gallery__grid" style="--cols:{{ s.columns }};--cols-m:{{ s.columns_mobile | default: 2 }};--ratio:{{ s.aspect_ratio }};--gallery-overlay:{{ s.overlay_color | default: '#EFA527' }};--gallery-overlay-opacity:{% if s.overlay_enable == false %}0{% else %}{{ s.overlay_opacity | default: 20 | divided_by: 100.0 }}{% endif %};">
      {%- for block in section.blocks -%}
        <figure class="gallery-cell" data-category="{{ block.settings.category | handleize }}" {{ block.shopify_attributes }}>
          {%- capture cell_media -%}
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.caption | escape }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy">
            {%- else -%}
              {%- render 'placeholder-tile' -%}
            {%- endif -%}
          {%- endcapture -%}
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ cell_media }}</a>{%- else -%}{{ cell_media }}{%- endif -%}
          {%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption }}</figcaption>{%- endif -%}
        </figure>
      {%- endfor -%}
      {%- comment -%} Fixed #myMUSE card — always the last item in the grid, same size as the others. {%- endcomment -%}
      {%- if s.show_share -%}
        {%- capture share_inner -%}
          {%- if s.share_heading != blank -%}<div class="page-gallery__share-tag" style="font-family:{%- render 'font-stack', key: s.heading_font -%};">{{ s.share_heading }}</div>{%- endif -%}
          {%- if s.share_text != blank -%}<div class="page-gallery__share-text">{{ s.share_text }}</div>{%- endif -%}
          {%- if s.share_button_label != blank -%}<span class="page-gallery__share-cta">{{ s.share_button_label }}</span>{%- endif -%}
        {%- endcapture -%}
        <div class="gallery-cell gallery-cell--share">
          {%- if s.share_link != blank -%}<a class="page-gallery__share-inner" href="{{ s.share_link }}"{% if s.share_new_tab %} target="_blank" rel="noopener"{% endif %}>{{ share_inner }}</a>{%- else -%}<div class="page-gallery__share-inner">{{ share_inner }}</div>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{%- if has_filters -%}
<script>
  (function () {
    var root = document.querySelector('[data-gallery="{{ section.id }}"]');
    if (!root) return;
    var btns = root.querySelectorAll('[data-gfilter]');
    var cells = root.querySelectorAll('.gallery-cell');
    for (var i = 0; i < btns.length; i++) {
      (function (btn) {
        btn.addEventListener('click', function () {
          var f = btn.getAttribute('data-gfilter');
          for (var j = 0; j < btns.length; j++) { btns[j].classList.toggle('is-active', btns[j] === btn); }
          for (var k = 0; k < cells.length; k++) {
            var isShare = cells[k].classList.contains('gallery-cell--share');
            var show = isShare || (f === 'all') || (cells[k].getAttribute('data-category') === f);
            cells[k].style.display = show ? '' : 'none';
          }
        });
      })(btns[i]);
    }
  })();
</script>
{%- endif -%}
{% schema %}
{
  "name": "Gallery page",
  "settings": [
    { "type": "header", "content": "Coming soon" },
    { "type": "checkbox", "id": "coming_soon", "label": "Grey out + show \"coming soon\" badge", "default": false },
    { "type": "text", "id": "kicker", "label": "Preheader", "default": "The Gallery" },
    { "type": "richtext", "id": "intro_text", "label": "Intro / body text", "info": "Shows under the heading. Leave empty to hide it." },
    { "type": "checkbox", "id": "use_page_body", "label": "Fall back to the page body text", "info": "If the Intro field above is empty, show the page's body content instead.", "default": false },
    { "type": "color", "id": "accent_color", "label": "Preheader color", "info": "Leave blank to use the theme default." },
    { "type": "textarea", "id": "heading", "label": "Heading", "info": "Leave blank to use the page title. Press Enter for a line break." },
    { "type": "select", "id": "text_align", "label": "Heading alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ], "default": "left" },
    { "type": "range", "id": "columns", "label": "Columns", "info": "How many photos across on desktop.", "min": 2, "max": 6, "step": 1, "default": 3 },
    { "type": "range", "id": "columns_mobile", "label": "Columns (mobile ≤768px)", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "select", "id": "aspect_ratio", "label": "Image aspect ratio", "options": [ { "value": "1/1", "label": "Square (1:1)" }, { "value": "4/5", "label": "Portrait (4:5)" }, { "value": "3/4", "label": "Portrait (3:4)" }, { "value": "16/9", "label": "Landscape (16:9)" } ], "default": "1/1" },
    { "type": "header", "content": "Filtering" },
    { "type": "checkbox", "id": "show_filters", "label": "Show filter buttons", "default": false },
    { "type": "text", "id": "filter_all_label", "label": "\"Show all\" button label", "default": "All" },
    { "type": "paragraph", "content": "Give each image a Category (in its block settings) to group it under a filter button." },
    { "type": "header", "content": "Image hover overlay" },
    { "type": "checkbox", "id": "overlay_enable", "label": "Show hover overlay", "default": true },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#EFA527" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 20 },
    { "type": "header", "content": "Typography" },
    { "type": "select", "id": "preheader_font", "label": "Preheader font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" },
        { "value": "display", "label": "Neue Haas Grotesk Display (Adobe)" },
        { "value": "text", "label": "Neue Haas Grotesk Text (Adobe)" },
        { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "site" },
    { "type": "select", "id": "heading_font", "label": "Heading font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" },
        { "value": "display", "label": "Neue Haas Grotesk Display (Adobe)" },
        { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "site" },
    { "type": "select", "id": "heading_weight", "label": "Heading weight & style", "info": "Ogg Text has every option. Neue Haas Display has Thin/Book/Roman/Medium; Neue Haas Text has Roman only. Other picks get faked by the browser.", "options": [
        { "value": "inherit", "label": "Theme default" },
        { "value": "thin", "label": "Thin (200)" },
        { "value": "book", "label": "Book / Light (300)" },
        { "value": "book-italic", "label": "Book Italic (300)" },
        { "value": "roman", "label": "Roman / Regular (400)" },
        { "value": "roman-italic", "label": "Roman Italic (400)" },
        { "value": "medium", "label": "Medium (500)" },
        { "value": "medium-italic", "label": "Medium Italic (500)" },
        { "value": "bold", "label": "Bold (700)" },
        { "value": "black", "label": "Black (800)" } ], "default": "inherit" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 80, "step": 2, "unit": "px", "default": 44 },
    { "type": "color", "id": "heading_color", "label": "Heading color", "info": "Leave blank to use the theme default." },
    { "type": "header", "content": "Text spacing" },
    { "type": "range", "id": "space_preheader", "label": "Space after preheader", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 10 },
    { "type": "header", "content": "Letter spacing" },
    { "type": "range", "id": "ls_preheader", "label": "Preheader letter spacing", "info": "1 = theme default, up to 10x wider.", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },
    { "type": "range", "id": "ls_heading", "label": "Heading letter spacing", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },
    { "type": "header", "content": "Share block (#myMUSE)" },
    { "type": "checkbox", "id": "show_share", "label": "Show share block", "default": false },
    { "type": "text", "id": "share_heading", "label": "Heading", "default": "#myMUSE" },
    { "type": "text", "id": "share_text", "label": "Text", "default": "Share your moment" },
    { "type": "text", "id": "share_button_label", "label": "Button label", "default": "Tag us" },
    { "type": "url", "id": "share_link", "label": "Link", "info": "Where the block points (e.g. your Instagram profile)." },
    { "type": "checkbox", "id": "share_new_tab", "label": "Open link in a new tab", "default": true },
    { "type": "header", "content": "Background" },
    { "type": "select", "id": "bg_type", "label": "Background type", "options": [ { "value": "none", "label": "None" }, { "value": "solid", "label": "Solid color" }, { "value": "gradient", "label": "Gradient" }, { "value": "image", "label": "Image" } ], "default": "none" },
    { "type": "color", "id": "bg_color", "label": "Solid color", "default": "#FBF6EE" },
    { "type": "color", "id": "bg_gradient_start", "label": "Gradient start", "default": "#FBF6EE" },
    { "type": "color", "id": "bg_gradient_end", "label": "Gradient end", "default": "#E7DAC4" },
    { "type": "range", "id": "bg_gradient_angle", "label": "Gradient angle", "min": 0, "max": 360, "step": 10, "unit": "deg", "default": 180 },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "header", "content": "Spacing & height" },
    { "type": "select", "id": "content_valign", "label": "Vertical content position", "info": "Applies when a minimum height is set.", "options": [ { "value": "top", "label": "Top" }, { "value": "center", "label": "Center" }, { "value": "bottom", "label": "Bottom" } ], "default": "top" },
    { "type": "range", "id": "min_height", "label": "Minimum height", "min": 0, "max": 1000, "step": 20, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "header", "content": "Mobile padding (≤749px)" },
    { "type": "checkbox", "id": "pad_mobile", "label": "Use different top/bottom padding on mobile", "default": false },
    { "type": "range", "id": "pt_m", "label": "Mobile top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "pb_m", "label": "Mobile bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    { "type": "image", "name": "Image", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "caption", "label": "Caption (optional)" },
      { "type": "text", "id": "category", "label": "Category (optional)", "info": "Used for the filter buttons. Same spelling = same group." },
      { "type": "url", "id": "link", "label": "Link (optional)" } ] }
  ],
  "max_blocks": 40,
  "presets": [{ "name": "Gallery page", "blocks": [ { "type": "image" }, { "type": "image" }, { "type": "image" } ] }]
}
{% endschema %}
