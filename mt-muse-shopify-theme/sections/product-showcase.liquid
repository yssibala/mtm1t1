{%- comment -%}
  Product Showcase — a richer, fully-customizable alternative to Featured collection.
  Pulls products from a collection and renders cards with a configurable text layout
  (title / tagline / description / details / price) and a 1-, 2-, or 3-button layout
  (the 3-button option includes a quantity stepper + add-to-cart).

  Tagline + details come from product metafields; the namespace defaults to the
  product handle (e.g. the "Clio" product -> clio.tagline / clio.prod_detail_set01),
  and can be overridden per section. Create the metafield definitions in
  Shopify admin > Settings > Custom data > Products.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
-%}
<div class="section-wrap product-showcase{% if s.coming_soon %} is-coming-soon{% endif %}"{% if s.coming_soon %} data-cs-label="{{ settings.badge_text | default: 'Coming Soon' | escape }}"{% endif %} data-ps="{{ section.id }}" style="{%- render 'section-style', st: s -%}">
  <div class="container">
    {%- if s.preheader != blank or s.heading != blank or s.subheading != blank -%}
      <div class="product-showcase__head" style="text-align:{{ s.head_align | default: 'center' }};margin-bottom:var(--space-xl);">
        {%- if s.preheader != blank -%}<div class="kicker" style="font-family:{%- render 'font-stack', key: s.preheader_font -%};color:{{ s.accent_color | default: '#C9851A' }};margin-bottom:10px;{%- render 'letter-spacing', mult: s.ls_preheader, base: '0.18em' -%}">{{ s.preheader }}</div>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="{%- render 'mb-size', val: s.heading_size, def: 40, cls: 'mb-h' -%}" style="font-family:{%- render 'font-stack', key: s.heading_font -%};{%- render 'font-variant', key: s.heading_weight, font: s.heading_font -%}{%- render 'letter-spacing', mult: s.ls_heading, base: '0.05em' -%}{% if s.heading_color != blank %}color:{{ s.heading_color }};{% endif %}font-size:{{ s.heading_size }}px;margin:0;">{{ s.heading | newline_to_br }}</h2>{%- endif -%}
        {%- if s.subheading != blank -%}<div class="rte{%- render 'mb-size', val: s.subheading_size, def: 17, cls: ' mb-body' -%}" style="max-width:640px;margin-top:10px;{% if s.head_align == 'center' %}margin-left:auto;margin-right:auto;{% elsif s.head_align == 'right' %}margin-left:auto;{% endif %}font-family:{%- render 'font-stack', key: s.body_font -%};{%- render 'letter-spacing', mult: s.ls_body, base: '0.03em' -%}font-size:{{ s.subheading_size | default: 17 }}px;color:var(--text-mid);">{{ s.subheading | newline_to_br }}</div>{%- endif -%}
      </div>
    {%- endif -%}

    {%- assign showcase_collection = s.collection -%}
    {%- assign product_blocks = section.blocks | where: 'type', 'product' -%}
    {%- assign filter_blocks = section.blocks | where: 'type', 'filter' -%}
    {%- if product_blocks.size > 0 or showcase_collection != blank -%}
      {%- assign ftype = s.filter_type | default: 'collection' -%}
      {%- if filter_blocks.size > 0 -%}
        <div class="pg-filters{% if s.filter_align == 'center' %} pg-filters--center{% elsif s.filter_align == 'right' %} pg-filters--right{% endif %}" data-ps-filters data-filter-type="{{ ftype }}">
          <button type="button" class="pg-filter is-active" data-filter="">{{ s.filter_all_label | default: 'All' }}</button>
          {%- for fb in filter_blocks -%}
            {%- if ftype == 'tag' -%}
              {%- assign fval = fb.settings.tag | downcase | strip -%}
              {%- assign flabel = fb.settings.label | default: fb.settings.tag -%}
            {%- else -%}
              {%- assign fc = fb.settings.filter_collection -%}
              {%- assign fval = fc.handle -%}
              {%- assign flabel = fb.settings.label | default: fc.title -%}
            {%- endif -%}
            {%- if fval != blank -%}<button type="button" class="pg-filter" data-filter="{{ fval }}" {{ fb.shopify_attributes }}>{{ flabel }}</button>{%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
      <div class="product-showcase__grid{% if s.equal_height %} product-showcase__grid--eq{% endif %}" style="--ps-cols:{{ s.columns }};">
        {%- if product_blocks.size > 0 -%}
          {%- comment -%} Manual product list — drag the Product blocks in the sidebar to reorder the cards {%- endcomment -%}
          {%- for block in product_blocks -%}
            {%- if block.settings.product != blank -%}
              {%- render 'ps-card', product: block.settings.product, s: s, block_attrs: block.shopify_attributes -%}
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for product in showcase_collection.products limit: s.limit -%}
            {%- render 'ps-card', product: product, s: s -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- else -%}
      <p>Add Product blocks to hand-pick and order the cards, or select a collection.</p>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var root = document.querySelector('[data-ps="{{ section.id }}"]');
    if (!root) return;
    var qtys = root.querySelectorAll('.ps-qty');
    for (var i = 0; i < qtys.length; i++) {
      (function (q) {
        var input = q.querySelector('.ps-qty__n');
        var dec = q.querySelector('[data-qty-dec]');
        var inc = q.querySelector('[data-qty-inc]');
        if (dec) dec.addEventListener('click', function () { input.value = Math.max(1, (parseInt(input.value, 10) || 1) - 1); });
        if (inc) inc.addEventListener('click', function () { input.value = (parseInt(input.value, 10) || 1) + 1; });
      })(qtys[i]);
    }
    var fbar = root.querySelector('[data-ps-filters]');
    if (fbar) {
      var attr = (fbar.getAttribute('data-filter-type') === 'tag') ? 'data-tags' : 'data-collections';
      var btns = fbar.querySelectorAll('.pg-filter');
      var cards = root.querySelectorAll('.ps-card');
      fbar.addEventListener('click', function (e) {
        var b = e.target.closest ? e.target.closest('.pg-filter') : null;
        if (!b) return;
        var f = b.getAttribute('data-filter') || '';
        for (var j = 0; j < btns.length; j++) { btns[j].classList.toggle('is-active', btns[j] === b); }
        for (var k = 0; k < cards.length; k++) {
          var vals = ',' + (cards[k].getAttribute(attr) || '') + ',';
          cards[k].style.display = (!f || vals.indexOf(',' + f + ',') > -1) ? '' : 'none';
        }
      });
    }
  })();
</script>

{% schema %}
