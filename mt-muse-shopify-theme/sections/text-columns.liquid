{%- comment -%}
  Text columns — side-by-side text boxes (like a three-up "cultivate / commemorate
  / celebrate"). Each column is a block with an optional eyebrow, heading, body and
  button. Columns sit in a responsive grid that collapses to one column on mobile.
  Column count is chosen by the merchant; the grid wraps if there are more blocks
  than columns. Background / height / vertical alignment come from section-style.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign cols = s.columns | default: 3
  assign gap = s.gap | default: 32
-%}
<div class="section-wrap text-columns" style="{%- render 'section-style', st: s -%}">
  <div class="container">
    {%- if s.preheader != blank or s.heading != blank or s.subheading != blank -%}
      <div class="text-columns__head" style="text-align:{{ s.head_align | default: 'center' }};margin-bottom:{{ s.space_head | default: 48 }}px;">
        {%- if s.preheader != blank -%}
          <div class="kicker" style="color:{{ s.accent_color | default: '#C9851A' }};margin-bottom:{{ s.space_preheader | default: 10 }}px;">{{ s.preheader }}</div>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 style="font-family:{%- render 'font-stack', key: s.heading_font -%};{%- render 'font-variant', key: s.heading_weight -%}font-size:{{ s.heading_size }}px;margin:0 0 {{ s.space_heading | default: 12 }}px;">{{ s.heading }}</h2>
        {%- endif -%}
        {%- if s.subheading != blank -%}
          <div class="rte" style="max-width:620px;{% if s.head_align == 'center' %}margin-left:auto;margin-right:auto;{% elsif s.head_align == 'right' %}margin-left:auto;{% endif %}font-family:{%- render 'font-stack', key: s.body_font -%};font-size:{{ s.subheading_size }}px;color:var(--text-mid);">{{ s.subheading }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="text-columns__grid" style="display:grid;grid-template-columns:repeat({{ cols }}, minmax(0, 1fr));gap:{{ gap }}px;">
      {%- for block in section.blocks -%}
        {%- assign a = block.settings.align | default: 'left' -%}
        {%- assign justify = 'flex-start' -%}
        {%- if a == 'center' -%}{%- assign justify = 'center' -%}{%- elsif a == 'right' -%}{%- assign justify = 'flex-end' -%}{%- endif -%}
        <div class="text-columns__col" {{ block.shopify_attributes }} style="text-align:{{ a }};{% if block.settings.divider %}border-top:1px solid {{ block.settings.divider_color | default: '#E7DAC4' }};padding-top:20px;{% endif %}">
          {%- if block.settings.number != blank -%}
            <div class="text-columns__num" style="font-family:{%- render 'font-stack', key: block.settings.heading_font -%};color:{{ block.settings.accent_color | default: '#C9851A' }};font-size:{{ block.settings.number_size | default: 40 }}px;line-height:1;margin-bottom:12px;">{{ block.settings.number }}</div>
          {%- endif -%}
          {%- if block.settings.eyebrow != blank -%}
            <div class="kicker" style="color:{{ block.settings.accent_color | default: '#C9851A' }};margin-bottom:8px;">{{ block.settings.eyebrow }}</div>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h3 style="font-family:{%- render 'font-stack', key: block.settings.heading_font -%};{%- render 'font-variant', key: block.settings.heading_weight -%}font-size:{{ block.settings.heading_size }}px;color:{{ block.settings.text_color | default: '#0A0B0C' }};margin:0 0 {{ block.settings.space_heading | default: 12 }}px;">{{ block.settings.heading }}</h3>
          {%- endif -%}
          {%- if block.settings.body != blank -%}
            <div class="rte" style="font-family:{%- render 'font-stack', key: block.settings.body_font -%};{%- render 'font-variant', key: block.settings.body_weight -%}font-size:{{ block.settings.body_size }}px;color:{{ block.settings.body_color | default: '#4C4C4B' }};">{{ block.settings.body }}</div>
          {%- endif -%}
          {%- if block.settings.button_label != blank -%}
            <div style="display:flex;justify-content:{{ justify }};margin-top:{{ block.settings.space_button | default: 20 }}px;">
              {%- render 'pill-button', label: block.settings.button_label, url: block.settings.button_link, style: block.settings.button_style, icon: block.settings.button_icon, size: block.settings.button_size -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Text columns",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Section heading (optional)" },
    { "type": "text", "id": "preheader", "label": "Preheader" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    { "type": "color", "id": "accent_color", "label": "Preheader color", "default": "#C9851A" },
    { "type": "select", "id": "head_align", "label": "Heading alignment", "options": [
        { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ], "default": "center" },
    { "type": "header", "content": "Columns" },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 1, "max": 5, "step": 1, "default": 3 },
    { "type": "range", "id": "gap", "label": "Gap between columns", "min": 0, "max": 96, "step": 4, "unit": "px", "default": 32 },
    { "type": "header", "content": "Typography" },
    { "type": "select", "id": "heading_font", "label": "Section heading font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" },
        { "value": "display", "label": "Neue Haas Grotesk Display (Adobe)" },
        { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "ogg" },
    { "type": "select", "id": "heading_weight", "label": "Section heading weight & style", "info": "Ogg Text has every option. Neue Haas Display has Thin/Book/Roman/Medium; Neue Haas Text has Roman only. Other picks get faked by the browser.", "options": [
        { "value": "inherit", "label": "Theme default" },
        { "value": "thin", "label": "Thin (200)" },
        { "value": "book", "label": "Book / Light (300)" },
        { "value": "book-italic", "label": "Book Italic (300)" },
        { "value": "roman", "label": "Roman / Regular (400)" },
        { "value": "roman-italic", "label": "Roman Italic (400)" },
        { "value": "medium", "label": "Medium (500)" },
        { "value": "medium-italic", "label": "Medium Italic (500)" },
        { "value": "bold", "label": "Bold (700)" },
        { "value": "black", "label": "Black (800)" } ], "default": "inherit" },
    { "type": "range", "id": "heading_size", "label": "Section heading size", "min": 20, "max": 80, "step": 2, "unit": "px", "default": 40 },
    { "type": "select", "id": "body_font", "label": "Subheading font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" },
        { "value": "text", "label": "Neue Haas Grotesk Text (Adobe)" },
        { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "site" },
    { "type": "range", "id": "subheading_size", "label": "Subheading size", "min": 13, "max": 28, "step": 1, "unit": "px", "default": 17 },
    { "type": "header", "content": "Text spacing" },
    { "type": "range", "id": "space_preheader", "label": "Space after preheader", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 10 },
    { "type": "range", "id": "space_heading", "label": "Space after heading", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "space_head", "label": "Space below section heading", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "header", "content": "Background" },
    { "type": "select", "id": "bg_type", "label": "Background type", "options": [
        { "value": "none", "label": "None" }, { "value": "solid", "label": "Solid color" }, { "value": "gradient", "label": "Gradient" }, { "value": "image", "label": "Image" } ], "default": "none" },
    { "type": "color", "id": "bg_color", "label": "Solid color", "default": "#FBF6EE" },
    { "type": "color", "id": "bg_gradient_start", "label": "Gradient start", "default": "#FBF6EE" },
    { "type": "color", "id": "bg_gradient_end", "label": "Gradient end", "default": "#E7DAC4" },
    { "type": "range", "id": "bg_gradient_angle", "label": "Gradient angle", "min": 0, "max": 360, "step": 10, "unit": "deg", "default": 180 },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "header", "content": "Spacing & height" },
    { "type": "select", "id": "content_valign", "label": "Vertical content position", "info": "Applies when a minimum height is set.", "options": [ { "value": "top", "label": "Top" }, { "value": "center", "label": "Center" }, { "value": "bottom", "label": "Bottom" } ], "default": "top" },
    { "type": "range", "id": "min_height", "label": "Minimum height", "min": 0, "max": 1000, "step": 20, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        { "type": "text", "id": "number", "label": "Number / lead-in (optional)", "info": "A big number or word above the heading, e.g. 01." },
        { "type": "range", "id": "number_size", "label": "Number size", "min": 20, "max": 96, "step": 2, "unit": "px", "default": 40 },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow (small label)" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Cultivate" },
        { "type": "richtext", "id": "body", "label": "Body text", "default": "<p>Describe this column here.</p>" },
        { "type": "select", "id": "align", "label": "Alignment", "options": [
            { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ], "default": "left" },
        { "type": "checkbox", "id": "divider", "label": "Top divider line", "default": false },
        { "type": "color", "id": "divider_color", "label": "Divider color", "default": "#E7DAC4" },
        { "type": "header", "content": "Colors" },
        { "type": "color", "id": "accent_color", "label": "Eyebrow / number color", "default": "#C9851A" },
        { "type": "color", "id": "text_color", "label": "Heading color", "default": "#0A0B0C" },
        { "type": "color", "id": "body_color", "label": "Body color", "default": "#4C4C4B" },
        { "type": "header", "content": "Typography" },
        { "type": "select", "id": "heading_font", "label": "Heading font", "options": [
            { "value": "site", "label": "Neue Haas Display Light" },
            { "value": "display", "label": "Neue Haas Grotesk Display (Adobe)" },
            { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "ogg" },
        { "type": "select", "id": "heading_weight", "label": "Heading weight & style", "info": "Ogg Text has every option. Neue Haas Display has Thin/Book/Roman/Medium; Neue Haas Text has Roman only. Other picks get faked by the browser.", "options": [
            { "value": "inherit", "label": "Theme default" },
            { "value": "thin", "label": "Thin (200)" },
            { "value": "book", "label": "Book / Light (300)" },
            { "value": "book-italic", "label": "Book Italic (300)" },
            { "value": "roman", "label": "Roman / Regular (400)" },
            { "value": "roman-italic", "label": "Roman Italic (400)" },
            { "value": "medium", "label": "Medium (500)" },
            { "value": "medium-italic", "label": "Medium Italic (500)" },
            { "value": "bold", "label": "Bold (700)" },
            { "value": "black", "label": "Black (800)" } ], "default": "inherit" },
        { "type": "range", "id": "heading_size", "label": "Heading size", "min": 14, "max": 56, "step": 1, "unit": "px", "default": 26 },
        { "type": "select", "id": "body_font", "label": "Body font", "options": [
            { "value": "site", "label": "Neue Haas Display Light" },
            { "value": "text", "label": "Neue Haas Grotesk Text (Adobe)" },
            { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "site" },
        { "type": "select", "id": "body_weight", "label": "Body weight & style", "options": [
            { "value": "inherit", "label": "Theme default" },
            { "value": "thin", "label": "Thin (200)" },
            { "value": "book", "label": "Book / Light (300)" },
            { "value": "book-italic", "label": "Book Italic (300)" },
            { "value": "roman", "label": "Roman / Regular (400)" },
            { "value": "roman-italic", "label": "Roman Italic (400)" },
            { "value": "medium", "label": "Medium (500)" },
            { "value": "medium-italic", "label": "Medium Italic (500)" },
            { "value": "bold", "label": "Bold (700)" },
            { "value": "black", "label": "Black (800)" } ], "default": "inherit" },
        { "type": "range", "id": "body_size", "label": "Body text size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
        { "type": "range", "id": "space_heading", "label": "Space after heading", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 12 },
        { "type": "header", "content": "Button (optional)" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "select", "id": "button_style", "label": "Button style", "options": [
            { "value": "primary", "label": "Gold (filled)" }, { "value": "ghost", "label": "Outline" } ], "default": "ghost" },
        { "type": "select", "id": "button_icon", "label": "Button icon", "options": [
            { "value": "none", "label": "None" }, { "value": "arrow", "label": "Arrow" }, { "value": "cart", "label": "Cart" }, { "value": "search", "label": "Search" }, { "value": "account", "label": "Account" } ], "default": "none" },
        { "type": "select", "id": "button_size", "label": "Button size", "options": [
            { "value": "11", "label": "Standard" }, { "value": "10", "label": "10% smaller" }, { "value": "9", "label": "20% smaller" }, { "value": "8", "label": "30% smaller" }, { "value": "7", "label": "40% smaller" }, { "value": "6", "label": "50% smaller" } ], "default": "11" },
        { "type": "range", "id": "space_button", "label": "Space above button", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 20 }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Text columns",
      "blocks": [
        { "type": "column", "settings": { "heading": "Cultivate" } },
        { "type": "column", "settings": { "heading": "Commemorate" } },
        { "type": "column", "settings": { "heading": "Celebrate" } }
      ]
    }
  ]
}
{% endschema %}
