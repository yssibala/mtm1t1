{%- comment -%}
  Product-grid card:
    Always visible (below image): title, price, buttons (view / qty / add-to-cart).
    On hover (over the image): an overlay reveals the tagline + description.
  Params: product, s (section.settings), block_attrs (optional block.shopify_attributes).
{%- endcomment -%}
{%- liquid
  assign cs_tag = settings.coming_soon_tag | default: 'coming-soon'
  assign is_coming_soon = false
  if product.tags contains cs_tag
    assign is_coming_soon = true
  endif
  assign ns = product.handle
  if s.mf_namespace != blank
    assign ns = s.mf_namespace
  endif
  assign tag_key = s.tagline_key | default: 'tagline'
  assign tagline = product.metafields[ns][tag_key].value | default: s.tagline_fallback
  assign cart_disabled = false
  if is_coming_soon and settings.coming_soon_disable_cart
    assign cart_disabled = true
  endif
  assign layout = s.button_layout | default: 'triple'
  assign align = s.card_align | default: 'center'
  assign has_hover = false
  if s.show_tagline and tagline != blank
    assign has_hover = true
  endif
  if s.show_desc and product.description != blank
    assign has_hover = true
  endif
  assign buy_justify = 'center'
  if align == 'left'
    assign buy_justify = 'flex-start'
  elsif align == 'right'
    assign buy_justify = 'flex-end'
  endif
-%}
{%- capture hover_rows -%}{%- render 'hover-fields', product: product, s: s -%}{%- endcapture -%}
{%- assign hover_rows = hover_rows | strip -%}
<article class="pg-card"{% if s.card_border == false %} style="border:0;"{% endif %} data-tags="{{ product.tags | join: ',' | downcase }}" data-collections="{{ product.collections | map: 'handle' | join: ',' | downcase }}" {{ block_attrs }}>
  <a class="pg-card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
    {%- if is_coming_soon -%}{%- render 'coming-soon-badge', stamp: true -%}{%- endif -%}
    {%- if product.featured_image -%}
      <img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.title | escape }}" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}" loading="lazy">
    {%- else -%}
      <div class="ps-card__placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
    {%- endif -%}
    {%- if s.show_hover == false -%}{%- assign hover_rows = '' -%}{%- endif -%}
    {%- if has_hover or hover_rows != blank -%}
      <div class="pg-card__overlay" style="--pg-ov:{{ s.overlay_color | default: '#0A0B0C' }};--pg-ov-alpha:{{ s.overlay_opacity | default: 88 | divided_by: 100.0 }};text-align:{{ align }};font-family:{%- render 'font-stack', key: s.ov_font -%};">
        <div class="pg-card__ov-inner">
          {%- if s.show_tagline and tagline != blank -%}<div class="pg-card__tagline" style="{%- render 'letter-spacing', mult: s.ls_ov_body, base: '0.03em' -%}{% if s.tagline_color != blank %}color:{{ s.tagline_color }};{% endif %}font-size:{{ s.tagline_size | default: 14 }}px;">{{ tagline }}</div>{%- endif -%}
          {%- if s.show_desc and product.description != blank -%}<div class="pg-card__desc" style="{%- render 'letter-spacing', mult: s.ls_ov_body, base: '0.02em' -%}{% if s.desc_color != blank %}color:{{ s.desc_color }};{% endif %}font-size:{{ s.desc_size | default: 13 }}px;{% if s.desc_lines > 0 %}display:-webkit-box;-webkit-line-clamp:{{ s.desc_lines }};line-clamp:{{ s.desc_lines }};-webkit-box-orient:vertical;overflow:hidden;{% endif %}">{{ product.description | strip_html }}</div>{%- endif -%}
          {{ hover_rows }}
        </div>
      </div>
    {%- endif -%}
  </a>
  <div class="pg-card__info" style="text-align:{{ align }};">
    <h3 class="pg-card__title" style="font-family:{%- render 'font-stack', key: s.title_font -%};{%- render 'font-variant', key: s.title_weight, font: s.title_font -%}{%- render 'letter-spacing', mult: s.ls_title, base: '0.02em' -%}{% if s.title_color != blank %}color:{{ s.title_color }};{% endif %}font-size:{{ s.title_size | default: 18 }}px;">{{ product.title }}</h3>
    <div class="pg-card__price" style="{% if s.price_color != blank %}color:{{ s.price_color }};{% else %}color:var(--muse-gold-dark);{% endif %}font-size:{{ s.price_size | default: 15 }}px;">{%- if is_coming_soon -%}{{ settings.badge_text | default: 'Coming Soon' }}{%- else -%}{{ product.price | money }}{%- endif -%}</div>
    {%- capture qty_ctrl -%}
      <span class="pill pill--ghost ps-qty" style="font-size:min({{ s.btn_size | default: 10 }}px, 5cqi);">
        <button type="button" class="ps-qty__b" data-qty-dec aria-label="Decrease quantity">&minus;</button>
        <input class="ps-qty__n" type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="Quantity">
        <button type="button" class="ps-qty__b" data-qty-inc aria-label="Increase quantity">+</button>
      </span>
    {%- endcapture -%}
    {%- capture view_btn -%}{%- render 'ps-pill', mode: 'product', product: product, label: s.view_label, style: 'ghost', size: s.btn_size -%}{%- endcapture -%}
    {%- capture cart_btn -%}{%- render 'ps-pill', mode: 'cart', label: s.cart_label, style: s.cart_style, size: s.btn_size, disabled: cart_disabled -%}{%- endcapture -%}
    {%- if layout != 'none' -%}
      <form class="pg-card__buy" method="post" action="{{ routes.cart_add_url }}" accept-charset="UTF-8" style="justify-content:{{ buy_justify }};">
        <input type="hidden" name="form_type" value="product">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {%- if layout == 'triple' -%}{{ view_btn }}{{ qty_ctrl }}{{ cart_btn }}
        {%- elsif layout == 'cart_qty' -%}{{ qty_ctrl }}{{ cart_btn }}
        {%- elsif layout == 'view_cart' -%}{{ view_btn }}{{ cart_btn }}
        {%- else -%}{{ cart_btn }}
        {%- endif -%}
      </form>
    {%- endif -%}
  </div>
</article>
