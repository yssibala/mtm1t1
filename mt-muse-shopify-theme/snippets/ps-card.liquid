{%- comment -%}
  One Product Showcase card. Params:
    product      — the product object
    s            — the section settings (pass section.settings)
    block_attrs  — optional block.shopify_attributes (for editor selection when using product blocks)
{%- endcomment -%}
{%- liquid
  assign cs_tag = settings.coming_soon_tag | default: 'coming-soon'
  assign is_coming_soon = false
  if product.tags contains cs_tag
    assign is_coming_soon = true
  endif
  assign ns = product.handle
  if s.mf_namespace != blank
    assign ns = s.mf_namespace
  endif
  assign tk = s.tagline_key | default: 'tagline' | remove_first: '@'
  assign tparts = tk | split: '.'
  if tparts.size > 1
    assign tagline = product.metafields[tparts[0]][tparts[1]].value | default: s.tagline_fallback
  else
    assign tagline = product.metafields[ns][tk].value | default: s.tagline_fallback
  endif
  assign dk = s.details_key | default: 'prod_detail_set01' | remove_first: '@'
  assign dparts = dk | split: '.'
  if dparts.size > 1
    assign details = product.metafields[dparts[0]][dparts[1]].value
  else
    assign details = product.metafields[ns][dk].value
  endif
  assign cart_disabled = false
  if is_coming_soon and settings.coming_soon_disable_cart
    assign cart_disabled = true
  endif
  assign uses_cart = false
  if s.btn_a_mode == 'cart' or s.btn_b_mode == 'cart'
    assign uses_cart = true
  endif
-%}
<article class="ps-card{% if is_coming_soon %} ps-card--cs{% endif %}"{% if s.card_border == false %} style="border:0;background:transparent;"{% endif %} data-tags="{{ product.tags | join: ',' | downcase }}" data-collections="{{ product.collections | map: 'handle' | join: ',' | downcase }}" {{ block_attrs }}>
  <a class="ps-card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
    {%- if is_coming_soon -%}{%- render 'coming-soon-badge', stamp: true -%}{%- endif -%}
    {%- if product.featured_image -%}
      <img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.title | escape }}" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}" loading="lazy">
    {%- else -%}
      <div class="ps-card__placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
    {%- endif -%}
    {%- capture hover_rows -%}{%- render 'hover-fields', product: product, s: s -%}{%- endcapture -%}
    {%- assign hover_rows = hover_rows | strip -%}
    {%- if s.show_hover and hover_rows != blank -%}
      <div class="card-hover" style="--hov:{{ s.hover_overlay_color | default: '#0A0B0C' }};--hov-a:{{ s.hover_overlay_opacity | default: 88 | divided_by: 100.0 }};text-align:{{ s.hover_align | default: 'center' }};font-family:{%- render 'font-stack', key: s.hover_font -%};">{{ hover_rows }}</div>
    {%- endif -%}
  </a>
  <div class="ps-card__body" style="text-align:{{ s.card_align | default: 'left' }};">
    <div class="ps-card__top">
      <h3 class="ps-card__title" style="font-family:{%- render 'font-stack', key: s.title_font -%};{%- render 'font-variant', key: s.title_weight, font: s.title_font -%}{%- render 'letter-spacing', mult: s.title_ls, base: '0.02em' -%}{% if s.title_color != blank %}color:{{ s.title_color }};{% endif %}font-size:{{ s.title_size }}px;">{{ product.title }}</h3>
      {%- if s.show_tagline and tagline != blank -%}<div class="ps-card__tagline" style="font-family:{%- render 'font-stack', key: s.tagline_font -%};{%- render 'letter-spacing', mult: s.tagline_ls, base: '0.03em' -%}{% if s.tagline_color != blank %}color:{{ s.tagline_color }};{% endif %}font-size:{{ s.tagline_size }}px;">{{ tagline }}</div>{%- endif -%}
    </div>
    <div class="ps-card__mid">{%- if s.show_desc and product.description != blank -%}<div class="ps-card__desc" style="font-family:{%- render 'font-stack', key: s.desc_font -%};{%- render 'letter-spacing', mult: s.desc_ls, base: '0.02em' -%}{% if s.desc_color != blank %}color:{{ s.desc_color }};{% else %}color:var(--text-mid);{% endif %}font-size:{{ s.desc_size }}px;{% if s.desc_lines > 0 %}display:-webkit-box;-webkit-line-clamp:{{ s.desc_lines }};line-clamp:{{ s.desc_lines }};-webkit-box-orient:vertical;overflow:hidden;{% endif %}">{%- if s.desc_words > 0 -%}{{ product.description | strip_html | truncatewords: s.desc_words }}{%- else -%}{{ product.description | strip_html }}{%- endif -%}</div>{%- endif -%}</div>
    <div class="ps-card__bottom">
    {%- if s.show_details and details != blank -%}
      <div class="ps-card__details" style="font-family:{%- render 'font-stack', key: s.details_font -%};{%- render 'letter-spacing', mult: s.details_ls, base: '0.02em' -%}{% if s.details_color != blank %}color:{{ s.details_color }};{% else %}color:var(--text-meta);{% endif %}font-size:{{ s.details_size }}px;">{{ details }}</div>
    {%- endif -%}
    <div class="ps-card__price" style="font-family:{%- render 'font-stack', key: s.price_font -%};{% if s.price_color != blank %}color:{{ s.price_color }};{% else %}color:var(--muse-gold-dark);{% endif %}font-size:{{ s.price_size }}px;">
      {%- if is_coming_soon -%}{{ settings.badge_text | default: 'Coming Soon' }}{%- else -%}{{ product.price | money }}{%- endif -%}
    </div>
    {%- capture qty_ctrl -%}
      <span class="pill pill--ghost ps-qty" style="font-size:min({{ s.btn_size | default: 11 }}px, 4cqi);">
        <button type="button" class="ps-qty__b" data-qty-dec aria-label="Decrease quantity">&minus;</button>
        <input class="ps-qty__n" type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="Quantity">
        <button type="button" class="ps-qty__b" data-qty-inc aria-label="Increase quantity">+</button>
      </span>
    {%- endcapture -%}
    {%- capture btn_a -%}{%- render 'ps-pill', mode: s.btn_a_mode, label: s.btn_a_label, url: s.btn_a_url, product: product, style: s.btn_a_style, size: s.btn_size, disabled: cart_disabled -%}{%- endcapture -%}
    {%- capture btn_b -%}{%- render 'ps-pill', mode: s.btn_b_mode, label: s.btn_b_label, url: s.btn_b_url, product: product, style: s.btn_b_style, size: s.btn_size, disabled: cart_disabled -%}{%- endcapture -%}
    {%- capture btnrow -%}
      {%- if s.btn_layout == 'single' -%}{{ btn_a }}
      {%- elsif s.btn_layout == 'double' -%}{{ btn_a }}{{ btn_b }}
      {%- elsif s.btn_layout == 'triple' -%}{{ btn_a }}{{ qty_ctrl }}{{ btn_b }}
      {%- endif -%}
    {%- endcapture -%}
    {%- if s.btn_layout != 'none' -%}
      <div class="ps-card__buttons">
        {%- if uses_cart -%}
          <form class="ps-btnrow ps-btnrow--{{ s.btn_layout }}" method="post" action="{{ routes.cart_add_url }}" accept-charset="UTF-8">
            <input type="hidden" name="form_type" value="product">
            <input type="hidden" name="utf8" value="✓">
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            {{ btnrow }}
          </form>
        {%- else -%}
          <div class="ps-btnrow ps-btnrow--{{ s.btn_layout }}">{{ btnrow }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}
    </div>
  </div>
</article>
