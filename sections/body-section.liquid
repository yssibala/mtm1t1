{%- liquid
  assign s = section.settings
  assign img_right = false
  if s.image_position == 'right'
    assign img_right = true
  endif
-%}
<div class="section-wrap body-section" style="{%- render 'section-style', st: s -%}">
  <div class="container body-section__inner{% if img_right %} body-section--img-right{% endif %}">
    <div class="body-section__text" style="text-align:{{ s.text_align | default: 'left' }};">
      {%- if s.preheader != blank -%}
        <div class="kicker" style="color:{{ s.accent_color | default: '#C9851A' }};margin-bottom:{{ s.space_preheader | default: 12 }}px;">{{ s.preheader }}</div>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 style="font-family:{%- render 'font-stack', key: s.heading_font -%};{%- render 'font-variant', key: s.heading_weight -%}font-size:{{ s.heading_size }}px;margin-bottom:{{ s.space_heading | default: 16 }}px;">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.body != blank -%}
        <div class="rte body-section__body" style="font-family:{%- render 'font-stack', key: s.body_font -%};{%- render 'font-variant', key: s.body_weight -%}font-size:{{ s.body_size }}px;color:var(--text-mid);">{{ s.body }}</div>
      {%- endif -%}
      {%- if s.button_label != blank -%}
        <div style="margin-top:24px;">
          {%- render 'pill-button', label: s.button_label, url: s.button_link, style: s.button_style, icon: s.button_icon, size: s.button_size -%}
        </div>
      {%- endif -%}
    </div>
    <div class="body-section__media">
      {%- if s.image != blank -%}
        <img src="{{ s.image | image_url: width: 1200 }}" alt="{{ s.image.alt | default: s.heading | escape }}" width="{{ s.image.width }}" height="{{ s.image.height }}" loading="lazy">
      {%- else -%}
        <div class="body-section__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Body section",
  "settings": [
    { "type": "text", "id": "preheader", "label": "Preheader", "default": "OUR STORY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Celebrating Those Who Inspire" },
    { "type": "richtext", "id": "body", "label": "Body text", "default": "<p>Share the story behind your brand here.</p>" },
    { "type": "select", "id": "image_position", "label": "Image side", "options": [
        { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ], "default": "right" },
    { "type": "select", "id": "text_align", "label": "Text alignment", "options": [
        { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ], "default": "left" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "color", "id": "accent_color", "label": "Preheader color", "default": "#C9851A" },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "button_style", "label": "Button style", "options": [
        { "value": "primary", "label": "Gold (filled)" }, { "value": "ghost", "label": "Outline" } ], "default": "primary" },
    { "type": "select", "id": "button_size", "label": "Button size", "options": [
        { "value": "11", "label": "Standard" }, { "value": "10", "label": "10% smaller" }, { "value": "9", "label": "20% smaller" }, { "value": "8", "label": "30% smaller" }, { "value": "7", "label": "40% smaller" }, { "value": "6", "label": "50% smaller" } ], "default": "11" },
    { "type": "select", "id": "button_icon", "label": "Button icon", "options": [
        { "value": "none", "label": "None" }, { "value": "arrow", "label": "Arrow" }, { "value": "cart", "label": "Cart" }, { "value": "search", "label": "Search" }, { "value": "account", "label": "Account" } ], "default": "none" },
    { "type": "header", "content": "Typography" },
    { "type": "select", "id": "heading_font", "label": "Heading font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" },
        { "value": "display", "label": "Neue Haas Grotesk Display (Adobe)" },
        { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "site" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 80, "step": 2, "unit": "px", "default": 40 },
    { "type": "select", "id": "heading_weight", "label": "Heading weight & style", "info": "Ogg Text has every option. Neue Haas Display has Thin/Book/Roman/Medium; Neue Haas Text has Roman only. Other picks get faked by the browser.", "options": [
        { "value": "inherit", "label": "Theme default" },
        { "value": "thin", "label": "Thin (200)" },
        { "value": "book", "label": "Book / Light (300)" },
        { "value": "book-italic", "label": "Book Italic (300)" },
        { "value": "roman", "label": "Roman / Regular (400)" },
        { "value": "roman-italic", "label": "Roman Italic (400)" },
        { "value": "medium", "label": "Medium (500)" },
        { "value": "medium-italic", "label": "Medium Italic (500)" },
        { "value": "bold", "label": "Bold (700)" },
        { "value": "black", "label": "Black (800)" } ], "default": "inherit" },
    { "type": "select", "id": "body_font", "label": "Body font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" },
        { "value": "text", "label": "Neue Haas Grotesk Text (Adobe)" },
        { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "site" },
    { "type": "range", "id": "body_size", "label": "Body text size", "min": 13, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "select", "id": "body_weight", "label": "Body weight & style", "options": [
        { "value": "inherit", "label": "Theme default" },
        { "value": "thin", "label": "Thin (200)" },
        { "value": "book", "label": "Book / Light (300)" },
        { "value": "book-italic", "label": "Book Italic (300)" },
        { "value": "roman", "label": "Roman / Regular (400)" },
        { "value": "roman-italic", "label": "Roman Italic (400)" },
        { "value": "medium", "label": "Medium (500)" },
        { "value": "medium-italic", "label": "Medium Italic (500)" },
        { "value": "bold", "label": "Bold (700)" },
        { "value": "black", "label": "Black (800)" } ], "default": "inherit" },
    { "type": "header", "content": "Text spacing" },
    { "type": "range", "id": "space_preheader", "label": "Space after preheader", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "space_heading", "label": "Space after heading", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 16 },
    { "type": "header", "content": "Background" },
    { "type": "select", "id": "bg_type", "label": "Background type", "options": [
        { "value": "none", "label": "None" }, { "value": "solid", "label": "Solid color" }, { "value": "gradient", "label": "Gradient" }, { "value": "image", "label": "Image" } ], "default": "none" },
    { "type": "color", "id": "bg_color", "label": "Solid color", "default": "#FBF6EE" },
    { "type": "color", "id": "bg_gradient_start", "label": "Gradient start", "default": "#FBF6EE" },
    { "type": "color", "id": "bg_gradient_end", "label": "Gradient end", "default": "#E7DAC4" },
    { "type": "range", "id": "bg_gradient_angle", "label": "Gradient angle", "min": 0, "max": 360, "step": 10, "unit": "deg", "default": 180 },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "header", "content": "Spacing & height" },
    { "type": "select", "id": "content_valign", "label": "Vertical content position", "info": "Applies when a minimum height is set.", "options": [ { "value": "top", "label": "Top" }, { "value": "center", "label": "Center" }, { "value": "bottom", "label": "Bottom" } ], "default": "top" },
    { "type": "range", "id": "min_height", "label": "Minimum height", "min": 0, "max": 1000, "step": 20, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 }
  ],
  "presets": [{ "name": "Body section" }]
}
{% endschema %}
