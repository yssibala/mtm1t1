{%- comment -%}
  Flexible section — compose freely from blocks (text, image, button, carousel,
  and decorative background shapes). Blocks stack vertically with per-block
  alignment controls. Shape blocks are positioned decorative rectangles behind
  the content. Background / height / padding come from the section settings.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
-%}
<div class="section-wrap flexible{% if s.coming_soon %} is-coming-soon{% endif %}"{% if s.coming_soon %} data-cs-label="{{ settings.badge_text | default: 'Coming Soon' | escape }}"{% endif %} style="{%- render 'section-style', st: s -%}position:relative;overflow:hidden;">

  {%- comment -%} Decorative shapes first, positioned behind content {%- endcomment -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'shape' -%}
      <div class="fx-shape" {{ block.shopify_attributes }} style="position:absolute;left:{{ block.settings.pos_x }}%;top:{{ block.settings.pos_y }}%;width:{{ block.settings.width }}%;height:{{ block.settings.height }}px;background:{{ block.settings.color }};border-radius:{{ block.settings.radius }}px;opacity:{{ block.settings.opacity | divided_by: 100.0 }};z-index:0;pointer-events:none;"></div>
    {%- endif -%}
  {%- endfor -%}

  <div class="container" style="position:relative;z-index:1;">
    {%- for block in section.blocks -%}
      {%- assign a = block.settings.align | default: 'left' -%}
      {%- assign justify = 'flex-start' -%}
      {%- if a == 'center' -%}{%- assign justify = 'center' -%}{%- elsif a == 'right' -%}{%- assign justify = 'flex-end' -%}{%- endif -%}

      {%- case block.type -%}
        {%- when 'text' -%}
          <div class="fx-block" {{ block.shopify_attributes }} style="text-align:{{ a }};max-width:{{ block.settings.max_width }}px;{% if a == 'center' %}margin-left:auto;margin-right:auto;{% elsif a == 'right' %}margin-left:auto;{% endif %}margin-top:{{ block.settings.margin_top }}px;margin-bottom:{{ block.settings.margin_bottom }}px;">
            {%- if block.settings.preheader != blank -%}<div class="kicker" style="font-family:{%- render 'font-stack', key: block.settings.preheader_font -%};color:{{ block.settings.accent_color | default: '#C9851A' }};margin-bottom:{{ block.settings.space_preheader | default: 10 }}px;{%- render 'letter-spacing', mult: block.settings.ls_preheader, base: '0.18em' -%}">{{ block.settings.preheader }}</div>{%- endif -%}
            {%- if block.settings.heading != blank -%}<h2 style="font-family:{%- render 'font-stack', key: block.settings.heading_font -%};{%- render 'font-variant', key: block.settings.heading_weight, font: block.settings.heading_font -%}{%- render 'letter-spacing', mult: block.settings.ls_heading, base: '0.05em' -%}{% if block.settings.lh_heading > 0 %}line-height:{{ block.settings.lh_heading }};{% endif %}font-size:{{ block.settings.heading_size }}px;color:{{ block.settings.text_color | default: '#0A0B0C' }};margin:0 0 {{ block.settings.space_heading | default: 12 }}px;">{{ block.settings.heading | newline_to_br }}</h2>{%- endif -%}
            {%- if block.settings.body != blank -%}<div class="rte" style="font-family:{%- render 'font-stack', key: block.settings.body_font -%};{%- render 'font-variant', key: block.settings.body_weight, font: block.settings.body_font -%}{%- render 'letter-spacing', mult: block.settings.ls_body, base: '0.03em' -%}{% if block.settings.lh_body > 0 %}line-height:{{ block.settings.lh_body }};{% endif %}font-size:{{ block.settings.body_size }}px;color:{{ block.settings.body_color | default: '#4C4C4B' }};">{{ block.settings.body }}</div>{%- endif -%}
          </div>

        {%- when 'image' -%}
          <div class="fx-block" {{ block.shopify_attributes }} style="text-align:{{ a }};margin-top:{{ block.settings.margin_top }}px;margin-bottom:{{ block.settings.margin_bottom }}px;">
            {%- if block.settings.image != blank -%}
              {%- capture fx_img -%}<img src="{{ block.settings.image | image_url: width: 1600 }}" alt="{{ block.settings.image.alt | escape }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy" style="display:inline-block;width:{{ block.settings.width }}%;height:auto;border-radius:{{ block.settings.radius }}px;">{%- endcapture -%}
              {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ fx_img }}</a>{%- else -%}{{ fx_img }}{%- endif -%}
            {%- else -%}
              <div class="fx-placeholder" style="width:{{ block.settings.width }}%;display:inline-block;">{{ 'image' | placeholder_svg_tag }}</div>
            {%- endif -%}
          </div>

        {%- when 'button' -%}
          <div class="fx-block" {{ block.shopify_attributes }} style="display:flex;justify-content:{{ justify }};margin-top:{{ block.settings.margin_top }}px;margin-bottom:{{ block.settings.margin_bottom }}px;">
            {%- render 'pill-button', label: block.settings.label, url: block.settings.url, style: block.settings.style, icon: block.settings.icon, size: block.settings.btn_size, label2: block.settings.label2, url2: block.settings.url2, icon2: block.settings.icon2 -%}
          </div>

        {%- when 'buttons' -%}
          <div class="fx-block" {{ block.shopify_attributes }} style="display:flex;flex-wrap:wrap;align-items:center;gap:{{ block.settings.gap | default: 16 }}px;justify-content:{{ justify }};margin-top:{{ block.settings.margin_top }}px;margin-bottom:{{ block.settings.margin_bottom }}px;">
            {%- if block.settings.label_1 != blank -%}{%- render 'pill-button', label: block.settings.label_1, url: block.settings.url_1, style: block.settings.style_1, icon: block.settings.icon_1, size: block.settings.btn_size -%}{%- endif -%}
            {%- if block.settings.label_2 != blank -%}{%- render 'pill-button', label: block.settings.label_2, url: block.settings.url_2, style: block.settings.style_2, icon: block.settings.icon_2, size: block.settings.btn_size -%}{%- endif -%}
            {%- if block.settings.label_3 != blank -%}{%- render 'pill-button', label: block.settings.label_3, url: block.settings.url_3, style: block.settings.style_3, icon: block.settings.icon_3, size: block.settings.btn_size -%}{%- endif -%}
          </div>

        {%- when 'carousel' -%}
          {%- assign slides = '' -%}
          {%- for i in (1..6) -%}
            {%- assign lk = 'slide_' | append: i | append: '_label' -%}
            {%- assign lbl = block.settings[lk] -%}
            {%- if lbl != blank -%}
              {%- assign uk = 'slide_' | append: i | append: '_link' -%}
              {%- capture item -%}{"name":{{ lbl | json }},"url":{{ block.settings[uk] | default: '#' | json }}}{%- endcapture -%}
              {%- if slides == '' -%}{%- assign slides = item -%}{%- else -%}{%- assign slides = slides | append: ',' | append: item -%}{%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          <div class="fx-block fx-carousel" data-fx-carousel="{{ block.id }}" {{ block.shopify_attributes }} style="margin-top:{{ block.settings.margin_top }}px;margin-bottom:{{ block.settings.margin_bottom }}px;">
            <div class="spc-switcher" style="justify-content:{{ justify }};">
              <button type="button" class="spc-arrow" data-fx-prev aria-label="Previous"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m15 18-6-6 6-6"/></svg></button>
              <a class="spc-name" data-fx-name href="#" style="font-family:{%- render 'font-stack', key: block.settings.font -%};font-size:{{ block.settings.size }}px;"></a>
              <button type="button" class="spc-arrow" data-fx-next aria-label="Next"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m9 18 6-6-6-6"/></svg></button>
            </div>
          </div>
          <script>
            (function () {
              var root = document.querySelector('[data-fx-carousel="{{ block.id }}"]');
              if (!root) return;
              var items = [{{ slides }}];
              if (!items.length) return;
              var name = root.querySelector('[data-fx-name]');
              var idx = 0, t = null;
              var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
              function apply() { name.textContent = items[idx].name; name.setAttribute('href', items[idx].url); name.classList.remove('is-swapping'); }
              function step(d) {
                idx = (idx + d + items.length) % items.length;
                if (reduce) { apply(); return; }
                name.classList.add('is-swapping');
                if (t) clearTimeout(t);
                t = setTimeout(apply, 160);
              }
              root.querySelector('[data-fx-prev]').addEventListener('click', function () { step(-1); });
              root.querySelector('[data-fx-next]').addEventListener('click', function () { step(1); });
              apply();
            })();
          </script>

        {%- when 'image_carousel' -%}
          {%- assign ic_align = block.settings.align | default: 'center' -%}
          {%- assign slide_count = 0 -%}
          {%- for i in (1..8) -%}
            {%- assign ik = 'image_' | append: i -%}
            {%- if block.settings[ik] != blank -%}{%- assign slide_count = slide_count | plus: 1 -%}{%- endif -%}
          {%- endfor -%}
          <div class="fx-block" {{ block.shopify_attributes }} style="text-align:{{ ic_align }};margin-top:{{ block.settings.margin_top }}px;margin-bottom:{{ block.settings.margin_bottom }}px;">
            {%- if slide_count > 0 -%}
              <div class="fx-imgcar" data-imgcar="{{ block.id }}" data-autoplay="{{ block.settings.autoplay }}" data-interval="{{ block.settings.interval | default: 5 }}" style="display:inline-block;width:{{ block.settings.width | default: 100 }}%;max-width:100%;--imgcar-ratio:{{ block.settings.aspect_ratio | default: '16/9' }};">
                <div class="fx-imgcar__viewport" style="border-radius:{{ block.settings.radius | default: 10 }}px;">
                  <div class="fx-imgcar__track">
                    {%- for i in (1..8) -%}
                      {%- assign ik = 'image_' | append: i -%}
                      {%- assign lk = 'link_' | append: i -%}
                      {%- assign im = block.settings[ik] -%}
                      {%- if im != blank -%}
                        <div class="fx-imgcar__slide">
                          {%- capture ic_img -%}<img src="{{ im | image_url: width: 1600 }}" alt="{{ im.alt | escape }}" width="{{ im.width }}" height="{{ im.height }}" loading="lazy">{%- endcapture -%}
                          {%- if block.settings[lk] != blank -%}<a href="{{ block.settings[lk] }}">{{ ic_img }}</a>{%- else -%}{{ ic_img }}{%- endif -%}
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                </div>
                {%- if slide_count > 1 and block.settings.show_arrows or slide_count > 1 and block.settings.show_dots -%}
                  <div class="fx-imgcar__controls">
                    {%- if slide_count > 1 and block.settings.show_arrows -%}<button type="button" class="fx-imgcar__arrow fx-imgcar__arrow--prev" data-imgcar-prev aria-label="Previous image"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m15 18-6-6 6-6"/></svg></button>{%- endif -%}
                    {%- if slide_count > 1 and block.settings.show_dots -%}<div class="fx-imgcar__dots">{%- for i in (1..slide_count) -%}<button type="button" class="fx-imgcar__dot{% if forloop.first %} is-active{% endif %}" data-imgcar-dot="{{ forloop.index0 }}" aria-label="Go to image {{ forloop.index }}"></button>{%- endfor -%}</div>{%- endif -%}
                    {%- if slide_count > 1 and block.settings.show_arrows -%}<button type="button" class="fx-imgcar__arrow fx-imgcar__arrow--next" data-imgcar-next aria-label="Next image"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m9 18 6-6-6-6"/></svg></button>{%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            {%- else -%}
              <div class="fx-placeholder" style="display:inline-block;width:{{ block.settings.width | default: 100 }}%;aspect-ratio:{{ block.settings.aspect_ratio | default: '16/9' }};">{{ 'image' | placeholder_svg_tag }}</div>
            {%- endif -%}
          </div>
          {%- if slide_count > 1 -%}
          <script>
            (function () {
              var root = document.querySelector('[data-imgcar="{{ block.id }}"]');
              if (!root) return;
              var track = root.querySelector('.fx-imgcar__track');
              var slides = Array.prototype.slice.call(root.querySelectorAll('.fx-imgcar__slide'));
              var dots = root.querySelectorAll('[data-imgcar-dot]');
              var n = slides.length;
              if (n < 2) return;
              var autoplay = root.getAttribute('data-autoplay') === 'true';
              var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
              var interval = (parseFloat(root.getAttribute('data-interval')) || 5) * 1000;
              var firstClone = slides[0].cloneNode(true);
              var lastClone = slides[n - 1].cloneNode(true);
              firstClone.setAttribute('aria-hidden', 'true');
              lastClone.setAttribute('aria-hidden', 'true');
              track.appendChild(firstClone);
              track.insertBefore(lastClone, slides[0]);
              var pos = 1, animating = false, timer = null;
              function dur() { return (parseFloat(getComputedStyle(track).transitionDuration) || 0) * 1000; }
              function paint() {
                track.style.transform = 'translateX(' + (-pos * 100) + '%)';
                var ri = (pos - 1 + n) % n;
                for (var d = 0; d < dots.length; d++) { dots[d].classList.toggle('is-active', d === ri); }
              }
              function snap(p) { track.style.transition = 'none'; pos = p; track.style.transform = 'translateX(' + (-pos * 100) + '%)'; void track.offsetWidth; track.style.transition = ''; }
              function step(delta) {
                if (animating) return;
                animating = true;
                pos += delta;
                paint();
                setTimeout(function () {
                  if (pos === 0) { snap(n); } else if (pos === n + 1) { snap(1); }
                  animating = false;
                }, dur() + 30);
              }
              function goDot(k) { if (animating) return; animating = true; pos = k + 1; paint(); setTimeout(function () { animating = false; }, dur() + 30); }
              function start() { if (autoplay && !reduce && interval > 0 && !timer) { timer = setInterval(function () { step(1); }, interval); } }
              function stop() { if (timer) { clearInterval(timer); timer = null; } }
              function restart() { stop(); start(); }
              snap(1);
              var pv = root.querySelector('[data-imgcar-prev]'); if (pv) pv.addEventListener('click', function () { step(-1); restart(); });
              var nx = root.querySelector('[data-imgcar-next]'); if (nx) nx.addEventListener('click', function () { step(1); restart(); });
              for (var d = 0; d < dots.length; d++) { (function (k) { dots[k].addEventListener('click', function () { goDot(k); restart(); }); })(d); }
              root.addEventListener('mouseenter', stop);
              root.addEventListener('mouseleave', start);
              start();
            })();
          </script>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Flexible section",
  "settings": [
    { "type": "header", "content": "Coming soon" },
    { "type": "checkbox", "id": "coming_soon", "label": "Grey out + show \"coming soon\" badge", "default": false },
    { "type": "header", "content": "Background" },
    { "type": "select", "id": "bg_type", "label": "Background type", "options": [
        { "value": "none", "label": "None" }, { "value": "solid", "label": "Solid color" }, { "value": "gradient", "label": "Gradient" }, { "value": "image", "label": "Image" } ], "default": "none" },
    { "type": "color", "id": "bg_color", "label": "Solid color", "default": "#FBF6EE" },
    { "type": "color", "id": "bg_gradient_start", "label": "Gradient start", "default": "#FBF6EE" },
    { "type": "color", "id": "bg_gradient_end", "label": "Gradient end", "default": "#E7DAC4" },
    { "type": "range", "id": "bg_gradient_angle", "label": "Gradient angle", "min": 0, "max": 360, "step": 10, "unit": "deg", "default": 180 },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "header", "content": "Spacing & height" },
    { "type": "select", "id": "content_valign", "label": "Vertical content position", "info": "Applies when a minimum height is set.", "options": [ { "value": "top", "label": "Top" }, { "value": "center", "label": "Center" }, { "value": "bottom", "label": "Bottom" } ], "default": "top" },
    { "type": "range", "id": "min_height", "label": "Minimum height", "min": 0, "max": 1000, "step": 20, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 80 },
    { "type": "header", "content": "Mobile padding (≤749px)" },
    { "type": "checkbox", "id": "pad_mobile", "label": "Use different top/bottom padding on mobile", "default": false },
    { "type": "range", "id": "pt_m", "label": "Mobile top padding", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "pb_m", "label": "Mobile bottom padding", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "preheader", "label": "Preheader" },
        { "type": "color", "id": "accent_color", "label": "Preheader color", "default": "#C9851A" },
        { "type": "textarea", "id": "heading", "label": "Heading", "info": "Press Enter for a line break." },
        { "type": "richtext", "id": "body", "label": "Body text" },
        { "type": "color", "id": "text_color", "label": "Heading color", "default": "#0A0B0C" },
        { "type": "color", "id": "body_color", "label": "Body color", "default": "#4C4C4B" },
        { "type": "select", "id": "align", "label": "Alignment", "options": [
            { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ], "default": "left" },
        { "type": "range", "id": "max_width", "label": "Max width", "min": 200, "max": 1180, "step": 20, "unit": "px", "default": 640 },
        { "type": "select", "id": "preheader_font", "label": "Preheader font", "options": [
            { "value": "site", "label": "Neue Haas Display Light" },
            { "value": "display", "label": "Neue Haas Grotesk Display (Adobe)" },
            { "value": "text", "label": "Neue Haas Grotesk Text (Adobe)" },
            { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "site" },
        { "type": "select", "id": "heading_font", "label": "Heading font", "options": [
            { "value": "site", "label": "Neue Haas Display Light" },
            { "value": "display", "label": "Neue Haas Grotesk Display (Adobe)" },
            { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "site" },
        { "type": "range", "id": "heading_size", "label": "Heading size", "min": 16, "max": 80, "step": 2, "unit": "px", "default": 36 },
        { "type": "select", "id": "heading_weight", "label": "Heading weight & style", "info": "Ogg Text has every option. Neue Haas Display has Thin/Book/Roman/Medium; Neue Haas Text has Roman only. Other picks get faked by the browser.", "options": [
            { "value": "inherit", "label": "Theme default" },
            { "value": "thin", "label": "Thin (200)" },
            { "value": "book", "label": "Book / Light (300)" },
            { "value": "book-italic", "label": "Book Italic (300)" },
            { "value": "roman", "label": "Roman / Regular (400)" },
            { "value": "roman-italic", "label": "Roman Italic (400)" },
            { "value": "medium", "label": "Medium (500)" },
            { "value": "medium-italic", "label": "Medium Italic (500)" },
            { "value": "bold", "label": "Bold (700)" },
            { "value": "black", "label": "Black (800)" } ], "default": "inherit" },
        { "type": "select", "id": "body_font", "label": "Body font", "options": [
            { "value": "site", "label": "Neue Haas Display Light" },
            { "value": "text", "label": "Neue Haas Grotesk Text (Adobe)" },
            { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "site" },
        { "type": "range", "id": "body_size", "label": "Body text size", "min": 12, "max": 28, "step": 1, "unit": "px", "default": 16 },
        { "type": "select", "id": "body_weight", "label": "Body weight & style", "options": [
            { "value": "inherit", "label": "Theme default" },
            { "value": "thin", "label": "Thin (200)" },
            { "value": "book", "label": "Book / Light (300)" },
            { "value": "book-italic", "label": "Book Italic (300)" },
            { "value": "roman", "label": "Roman / Regular (400)" },
            { "value": "roman-italic", "label": "Roman Italic (400)" },
            { "value": "medium", "label": "Medium (500)" },
            { "value": "medium-italic", "label": "Medium Italic (500)" },
            { "value": "bold", "label": "Bold (700)" },
            { "value": "black", "label": "Black (800)" } ], "default": "inherit" },
        { "type": "range", "id": "space_preheader", "label": "Space after preheader", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 10 },
        { "type": "range", "id": "space_heading", "label": "Space after heading", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 12 },
        { "type": "range", "id": "ls_preheader", "label": "Preheader letter spacing", "info": "1 = theme default, up to 10x wider.", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },
        { "type": "range", "id": "ls_heading", "label": "Heading letter spacing", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },
        { "type": "range", "id": "ls_body", "label": "Body letter spacing", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },
        { "type": "range", "id": "lh_heading", "label": "Heading line height", "info": "0 = theme default; typical 1.0–1.4.", "min": 0, "max": 2.4, "step": 0.1, "default": 0 },
        { "type": "range", "id": "lh_body", "label": "Body line height", "info": "0 = theme default; typical 1.4–2.0.", "min": 0, "max": 2.4, "step": 0.1, "default": 0 },
        { "type": "range", "id": "margin_top", "label": "Space above", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
        { "type": "range", "id": "margin_bottom", "label": "Space below", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link (optional)" },
        { "type": "select", "id": "align", "label": "Alignment", "options": [
            { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ], "default": "center" },
        { "type": "range", "id": "width", "label": "Width", "min": 5, "max": 100, "step": 5, "unit": "%", "default": 100 },
        { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 4 },
        { "type": "range", "id": "margin_top", "label": "Space above", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
        { "type": "range", "id": "margin_bottom", "label": "Space below", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 }
      ]
    },
    {
      "type": "button",
      "name": "Button",
