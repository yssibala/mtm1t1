{%- liquid
  assign s = section.settings
  assign ratio = s.aspect_ratio | default: '1/1'
-%}
<div class="section-wrap gallery-row" style="{%- render 'section-style', st: s -%}">
  <div class="container">
    <div class="gallery-row__head" style="text-align:{{ s.text_align | default: 'left' }};">
      <div>
        {%- if s.preheader != blank -%}
          <div class="kicker" style="font-family:{%- render 'font-stack', key: s.preheader_font -%};color:{{ s.accent_color | default: '#C9851A' }};margin-bottom:{{ s.space_preheader | default: 10 }}px;{%- render 'letter-spacing', mult: s.ls_preheader, base: '0.18em' -%}">{{ s.preheader }}</div>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 style="font-family:{%- render 'font-stack', key: s.heading_font -%};{%- render 'font-variant', key: s.heading_weight, font: s.heading_font -%}{%- render 'letter-spacing', mult: s.ls_heading, base: '0.05em' -%}font-size:{{ s.heading_size }}px;margin:0;">{{ s.heading }}</h2>
        {%- endif -%}
      </div>
      {%- if s.button_label != blank -%}
        <div class="gallery-row__cta">
          {%- render 'pill-button', label: s.button_label, url: s.button_link, style: s.button_style, icon: 'arrow', size: s.button_size -%}
        </div>
      {%- endif -%}
    </div>

    <div class="gallery-row__grid" style="--gr-ratio:{{ ratio }};">
      {%- for i in (1..4) -%}
        {%- assign img_key = 'image_' | append: i -%}
        {%- assign link_key = 'link_' | append: i -%}
        {%- assign img = s[img_key] -%}
        {%- assign lnk = s[link_key] -%}
        <div class="gallery-cell">
          {%- capture cell_media -%}
            {%- if img != blank -%}
              <img src="{{ img | image_url: width: 800 }}" alt="{{ img.alt | escape }}" width="{{ img.width }}" height="{{ img.height }}" loading="lazy">
            {%- else -%}
              <div class="gallery-cell__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
            {%- endif -%}
          {%- endcapture -%}
          {%- if lnk != blank -%}<a href="{{ lnk }}">{{ cell_media }}</a>{%- else -%}{{ cell_media }}{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Gallery row",
  "settings": [
    { "type": "text", "id": "preheader", "label": "Preheader", "default": "THE GALLERY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Moments Worth Toasting" },
    { "type": "color", "id": "accent_color", "label": "Preheader color", "default": "#C9851A" },
    { "type": "select", "id": "text_align", "label": "Heading alignment", "options": [
        { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ], "default": "left" },
    { "type": "select", "id": "aspect_ratio", "label": "Image aspect ratio", "options": [
        { "value": "1/1", "label": "Square (1:1)" }, { "value": "4/5", "label": "Portrait (4:5)" }, { "value": "9/16", "label": "Tall (9:16)" } ], "default": "1/1" },
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "image_1", "label": "Image 1" },
    { "type": "url", "id": "link_1", "label": "Image 1 link" },
    { "type": "image_picker", "id": "image_2", "label": "Image 2" },
    { "type": "url", "id": "link_2", "label": "Image 2 link" },
    { "type": "image_picker", "id": "image_3", "label": "Image 3" },
    { "type": "url", "id": "link_3", "label": "Image 3 link" },
    { "type": "image_picker", "id": "image_4", "label": "Image 4" },
    { "type": "url", "id": "link_4", "label": "Image 4 link" },
    { "type": "header", "content": "View-all button" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View all" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "button_style", "label": "Button style", "options": [
        { "value": "primary", "label": "Gold (filled)" }, { "value": "ghost", "label": "Outline" } ], "default": "ghost" },
    { "type": "select", "id": "button_size", "label": "Button size", "options": [
        { "value": "11", "label": "Standard" }, { "value": "10", "label": "10% smaller" }, { "value": "9", "label": "20% smaller" }, { "value": "8", "label": "30% smaller" }, { "value": "7", "label": "40% smaller" }, { "value": "6", "label": "50% smaller" } ], "default": "11" },
    { "type": "header", "content": "Typography" },
    { "type": "select", "id": "preheader_font", "label": "Preheader font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" },
        { "value": "display", "label": "Neue Haas Grotesk Display (Adobe)" },
        { "value": "text", "label": "Neue Haas Grotesk Text (Adobe)" },
        { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "site" },
    { "type": "select", "id": "heading_font", "label": "Heading font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" },
        { "value": "display", "label": "Neue Haas Grotesk Display (Adobe)" },
        { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "site" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 80, "step": 2, "unit": "px", "default": 40 },
    { "type": "select", "id": "heading_weight", "label": "Heading weight & style", "info": "Ogg Text has every option. Neue Haas Display has Thin/Book/Roman/Medium; Neue Haas Text has Roman only. Other picks get faked by the browser.", "options": [
        { "value": "inherit", "label": "Theme default" },
        { "value": "thin", "label": "Thin (200)" },
        { "value": "book", "label": "Book / Light (300)" },
        { "value": "book-italic", "label": "Book Italic (300)" },
        { "value": "roman", "label": "Roman / Regular (400)" },
        { "value": "roman-italic", "label": "Roman Italic (400)" },
        { "value": "medium", "label": "Medium (500)" },
        { "value": "medium-italic", "label": "Medium Italic (500)" },
        { "value": "bold", "label": "Bold (700)" },
        { "value": "black", "label": "Black (800)" } ], "default": "inherit" },
    { "type": "header", "content": "Text spacing" },
    { "type": "range", "id": "space_preheader", "label": "Space after preheader", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 10 },
    { "type": "header", "content": "Letter spacing" },
    { "type": "range", "id": "ls_preheader", "label": "Preheader letter spacing", "info": "1 = theme default, up to 10x wider.", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },
    { "type": "range", "id": "ls_heading", "label": "Heading letter spacing", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },
    { "type": "header", "content": "Background" },
    { "type": "select", "id": "bg_type", "label": "Background type", "options": [
        { "value": "none", "label": "None" }, { "value": "solid", "label": "Solid color" }, { "value": "gradient", "label": "Gradient" }, { "value": "image", "label": "Image" } ], "default": "none" },
    { "type": "color", "id": "bg_color", "label": "Solid color", "default": "#FBF6EE" },
    { "type": "color", "id": "bg_gradient_start", "label": "Gradient start", "default": "#FBF6EE" },
    { "type": "color", "id": "bg_gradient_end", "label": "Gradient end", "default": "#E7DAC4" },
    { "type": "range", "id": "bg_gradient_angle", "label": "Gradient angle", "min": 0, "max": 360, "step": 10, "unit": "deg", "default": 180 },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "header", "content": "Spacing & height" },
    { "type": "select", "id": "content_valign", "label": "Vertical content position", "info": "Applies when a minimum height is set.", "options": [ { "value": "top", "label": "Top" }, { "value": "center", "label": "Center" }, { "value": "bottom", "label": "Bottom" } ], "default": "top" },
    { "type": "range", "id": "min_height", "label": "Minimum height", "min": 0, "max": 1000, "step": 20, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 }
  ],
  "presets": [{ "name": "Gallery row" }]
}
{% endschema %}
