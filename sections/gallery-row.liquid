{%- liquid
  assign s = section.settings
  assign ratio = s.aspect_ratio | default: '1/1'
-%}
<div class="section-wrap gallery-row" style="{%- render 'section-style', st: s -%}">
  <div class="container">
    <div class="gallery-row__head" style="text-align:{{ s.text_align | default: 'left' }};">
      <div>
        {%- if s.preheader != blank -%}
          <div class="kicker" style="color:{{ s.accent_color | default: '#C9851A' }};margin-bottom:10px;">{{ s.preheader }}</div>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 style="font-family:{{ s.heading_font }};font-size:{{ s.heading_size }}px;margin:0;">{{ s.heading }}</h2>
        {%- endif -%}
      </div>
      {%- if s.button_label != blank -%}
        <div class="gallery-row__cta">
          {%- render 'pill-button', label: s.button_label, url: s.button_link, style: s.button_style, icon: 'arrow' -%}
        </div>
      {%- endif -%}
    </div>

    <div class="gallery-row__grid" style="--gr-ratio:{{ ratio }};">
      {%- for i in (1..4) -%}
        {%- assign img_key = 'image_' | append: i -%}
        {%- assign link_key = 'link_' | append: i -%}
        {%- assign img = s[img_key] -%}
        {%- assign lnk = s[link_key] -%}
        <div class="gallery-cell">
          {%- if lnk != blank -%}<a href="{{ lnk }}">{%- endif -%}
            {%- if img != blank -%}
              <img src="{{ img | image_url: width: 800 }}" alt="{{ img.alt | escape }}" loading="lazy">
            {%- else -%}
              <div class="gallery-cell__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
            {%- endif -%}
          {%- if lnk != blank -%}</a>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Gallery row",
  "settings": [
    { "type": "text", "id": "preheader", "label": "Preheader", "default": "THE GALLERY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Moments Worth Toasting" },
    { "type": "color", "id": "accent_color", "label": "Preheader color", "default": "#C9851A" },
    { "type": "select", "id": "text_align", "label": "Heading alignment", "options": [
        { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ], "default": "left" },
    { "type": "select", "id": "aspect_ratio", "label": "Image aspect ratio", "options": [
        { "value": "1/1", "label": "Square (1:1)" }, { "value": "4/5", "label": "Portrait (4:5)" }, { "value": "9/16", "label": "Tall (9:16)" } ], "default": "1/1" },
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "image_1", "label": "Image 1" },
    { "type": "url", "id": "link_1", "label": "Image 1 link" },
    { "type": "image_picker", "id": "image_2", "label": "Image 2" },
    { "type": "url", "id": "link_2", "label": "Image 2 link" },
    { "type": "image_picker", "id": "image_3", "label": "Image 3" },
    { "type": "url", "id": "link_3", "label": "Image 3 link" },
    { "type": "image_picker", "id": "image_4", "label": "Image 4" },
    { "type": "url", "id": "link_4", "label": "Image 4 link" },
    { "type": "header", "content": "View-all button" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View all" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "button_style", "label": "Button style", "options": [
        { "value": "primary", "label": "Gold (filled)" }, { "value": "ghost", "label": "Outline" } ], "default": "ghost" },
    { "type": "header", "content": "Typography" },
    { "type": "select", "id": "heading_font", "label": "Heading font", "options": [
        { "value": "'neuehaasdisplaylight','Helvetica Neue',Arial,sans-serif", "label": "Neue Haas Display Light" },
        { "value": "'neue-haas-grotesk-display','Helvetica Neue',Arial,sans-serif", "label": "Neue Haas Grotesk Display (Adobe)" },
        { "value": "'ogg-text',Georgia,serif", "label": "Ogg Text (Adobe serif)" } ], "default": "'neuehaasdisplaylight','Helvetica Neue',Arial,sans-serif" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 80, "step": 2, "unit": "px", "default": 40 },
    { "type": "header", "content": "Background" },
    { "type": "select", "id": "bg_type", "label": "Background type", "options": [
        { "value": "none", "label": "None" }, { "value": "solid", "label": "Solid color" }, { "value": "gradient", "label": "Gradient" }, { "value": "image", "label": "Image" } ], "default": "none" },
    { "type": "color", "id": "bg_color", "label": "Solid color", "default": "#FBF6EE" },
    { "type": "color", "id": "bg_gradient_start", "label": "Gradient start", "default": "#FBF6EE" },
    { "type": "color", "id": "bg_gradient_end", "label": "Gradient end", "default": "#E7DAC4" },
    { "type": "range", "id": "bg_gradient_angle", "label": "Gradient angle", "min": 0, "max": 360, "step": 10, "unit": "deg", "default": 180 },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "header", "content": "Spacing & height" },
    { "type": "range", "id": "min_height", "label": "Minimum height", "min": 0, "max": 1000, "step": 20, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 }
  ],
  "presets": [{ "name": "Gallery row" }]
}
{% endschema %}
