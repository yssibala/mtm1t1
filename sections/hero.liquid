{%- liquid
  assign s = section.settings
  assign img_pos = s.image_position | default: 'below'
  assign has_image = false
  if s.image != blank
    assign has_image = true
  endif
  assign is_split = false
  if has_image
    if img_pos == 'left' or img_pos == 'right'
      assign is_split = true
    endif
  endif
  assign img_align = s.image_align | default: 'center'
-%}
<div class="section-wrap hero{% if has_image %} hero--img-{{ img_pos }}{% endif %}{% if s.extend_behind_header %} hero--bleed{% endif %}{% if s.coming_soon %} is-coming-soon{% endif %}"{% if s.coming_soon %} data-cs-label="{{ settings.badge_text | default: 'Coming Soon' | escape }}"{% endif %} style="{%- render 'section-style', st: s -%}text-align:{{ s.text_align | default: 'center' }};{% if has_image and img_pos == 'background' %}position:relative;{% endif %}">
  {%- if has_image and img_pos == 'background' -%}
    <div class="hero__bg" style="position:absolute;inset:0;z-index:0;overflow:hidden;">
      <img src="{{ s.image | image_url: width: 2200 }}" alt="{{ s.image.alt | escape }}" width="{{ s.image.width }}" height="{{ s.image.height }}" style="width:100%;height:100%;object-fit:cover;object-position:{{ s.image_focal | default: 'center' }};opacity:{{ s.image_opacity | default: 100 | divided_by: 100.0 }};">
    </div>
  {%- endif -%}
  <div class="hero__grid{% if is_split %} hero__grid--split{% endif %}" style="position:relative;z-index:1;">
    {%- comment -%} Free-standing image: above the text (centered/aligned) or in the split column {%- endcomment -%}
    {%- if has_image and img_pos == 'above' -%}
      <div class="hero__media hero__media--stack" style="text-align:{{ img_align }};margin-bottom:{{ s.space_image | default: 32 }}px;">
        <img src="{{ s.image | image_url: width: 1600 }}" alt="{{ s.image.alt | escape }}" width="{{ s.image.width }}" height="{{ s.image.height }}" style="display:inline-block;width:{{ s.image_width | default: 100 }}%;max-width:100%;height:{% if s.image_height > 0 %}{{ s.image_height }}px{% else %}auto{% endif %};object-fit:cover;object-position:{{ s.image_focal | default: 'center' }};border-radius:{{ s.image_radius | default: 0 }}px;">
      </div>
    {%- endif -%}
    {%- if is_split -%}
      <div class="hero__media">
        <img src="{{ s.image | image_url: width: 1400 }}" alt="{{ s.image.alt | escape }}" width="{{ s.image.width }}" height="{{ s.image.height }}" style="width:100%;height:{% if s.image_height > 0 %}{{ s.image_height }}px{% else %}auto{% endif %};object-fit:cover;object-position:{{ s.image_focal | default: 'center' }};border-radius:{{ s.image_radius | default: 0 }}px;">
      </div>
    {%- endif -%}
    <div class="hero__text container">
      {%- if s.show_coming_soon -%}
        <div style="margin-bottom:16px;">{%- render 'coming-soon-badge' -%}</div>
      {%- endif -%}
      {%- if s.preheader != blank -%}
        <div class="kicker" style="font-family:{%- render 'font-stack', key: s.preheader_font -%};color:{{ s.accent_color | default: '#C9851A' }};margin-bottom:{{ s.space_preheader | default: 12 }}px;{%- render 'letter-spacing', mult: s.ls_preheader, base: '0.18em' -%}{% if s.text_align == 'center' %}text-align:center;{% endif %}">{{ s.preheader }}</div>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h1 style="font-family:{%- render 'font-stack', key: s.heading_font -%};{%- render 'font-variant', key: s.heading_weight, font: s.heading_font -%}{%- render 'letter-spacing', mult: s.ls_heading, base: '0.05em' -%}{% if s.heading_color != blank %}color:{{ s.heading_color }};{% endif %}font-size:{{ s.heading_size }}px;margin-bottom:{{ s.space_heading | default: 16 }}px;">{{ s.heading | newline_to_br }}</h1>
      {%- endif -%}
      {%- if s.subheading != blank -%}
        <p style="max-width:620px;{% if s.text_align == 'center' %}margin-left:auto;margin-right:auto;{% endif %}font-family:{%- render 'font-stack', key: s.body_font -%};{%- render 'font-variant', key: s.body_weight, font: s.body_font -%}{%- render 'letter-spacing', mult: s.ls_body, base: '0.03em' -%}{% if s.body_color != blank %}color:{{ s.body_color }};{% endif %}font-size:{{ s.body_size }}px;margin-bottom:0;">{{ s.subheading | newline_to_br }}</p>
      {%- endif -%}
      {%- if s.button_label != blank or s.button2_label != blank -%}
        <div style="margin-top:{{ s.space_buttons | default: 24 }}px;display:flex;gap:16px;flex-wrap:wrap;{% if s.text_align == 'center' %}justify-content:center;{% elsif s.text_align == 'right' %}justify-content:flex-end;{% endif %}">
          {%- render 'pill-button', label: s.button_label, url: s.button_link, style: s.button_style, icon: s.button_icon, size: s.button_size, label2: s.button2_label, url2: s.button2_link, icon2: s.button2_icon -%}
        </div>
      {%- endif -%}
    </div>
    {%- if has_image and img_pos == 'below' -%}
      <div class="hero__media hero__media--stack" style="text-align:{{ img_align }};margin-top:{{ s.space_image | default: 32 }}px;">
        <img src="{{ s.image | image_url: width: 1600 }}" alt="{{ s.image.alt | escape }}" width="{{ s.image.width }}" height="{{ s.image.height }}" style="display:inline-block;width:{{ s.image_width | default: 100 }}%;max-width:100%;height:{% if s.image_height > 0 %}{{ s.image_height }}px{% else %}auto{% endif %};object-fit:cover;object-position:{{ s.image_focal | default: 'center' }};border-radius:{{ s.image_radius | default: 0 }}px;">
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "header", "content": "Coming soon" },
    { "type": "checkbox", "id": "coming_soon", "label": "Grey out + show \"coming soon\" badge", "default": false },
    { "type": "text", "id": "preheader", "label": "Preheader (eyebrow)" },
    { "type": "color", "id": "accent_color", "label": "Preheader color", "default": "#C9851A" },
    { "type": "textarea", "id": "heading", "label": "Heading", "info": "Press Enter for a line break.", "default": "Welcome to MT-MUSE" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "info": "Press Enter for a line break.", "default": "Explore our curated selection of products crafted with intention." },
    { "type": "select", "id": "text_align", "label": "Alignment", "options": [
        { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ], "default": "center" },
    { "type": "checkbox", "id": "show_coming_soon", "label": "Show coming soon badge", "default": false },
    { "type": "header", "content": "Button (single or dual pill)" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "button_icon", "label": "Button icon", "options": [
        { "value": "none", "label": "None" }, { "value": "arrow", "label": "Arrow" }, { "value": "cart", "label": "Cart" }, { "value": "search", "label": "Search" }, { "value": "account", "label": "Account" } ], "default": "none" },
    { "type": "select", "id": "button_style", "label": "Button style", "options": [
        { "value": "primary", "label": "Gold (filled)" }, { "value": "ghost", "label": "Outline" } ], "default": "primary" },
    { "type": "text", "id": "button2_label", "label": "Second button label (adds a dual pill)" },
    { "type": "url", "id": "button2_link", "label": "Second button link" },
    { "type": "select", "id": "button2_icon", "label": "Second button icon", "options": [
        { "value": "none", "label": "None" }, { "value": "arrow", "label": "Arrow" }, { "value": "cart", "label": "Cart" }, { "value": "search", "label": "Search" }, { "value": "account", "label": "Account" } ], "default": "none" },
    { "type": "select", "id": "button_size", "label": "Button size", "options": [
        { "value": "11", "label": "Standard" }, { "value": "10", "label": "10% smaller" }, { "value": "9", "label": "20% smaller" }, { "value": "8", "label": "30% smaller" }, { "value": "7", "label": "40% smaller" }, { "value": "6", "label": "50% smaller" } ], "default": "11" },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "image_position", "label": "Image position", "info": "Above / Below let you set the image width and horizontal alignment (e.g. centered above the heading). Left / Right place it beside the text.", "options": [
        { "value": "above", "label": "Above text" }, { "value": "below", "label": "Below text" }, { "value": "left", "label": "Left of text" }, { "value": "right", "label": "Right of text" }, { "value": "background", "label": "Background (full-bleed)" } ], "default": "below" },
    { "type": "select", "id": "image_align", "label": "Image alignment (above / below)", "options": [
        { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ], "default": "center" },
    { "type": "range", "id": "image_width", "label": "Image width (above / below)", "min": 20, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "select", "id": "image_focal", "label": "Focal point (crop)", "options": [
        { "value": "center", "label": "Center" }, { "value": "top", "label": "Top" }, { "value": "bottom", "label": "Bottom" }, { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ], "default": "center" },
    { "type": "range", "id": "image_height", "label": "Image height (0 = auto)", "min": 0, "max": 900, "step": 20, "unit": "px", "default": 0 },
    { "type": "range", "id": "image_radius", "label": "Image corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "image_opacity", "label": "Background image opacity", "min": 10, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Typography" },
    { "type": "select", "id": "preheader_font", "label": "Preheader font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" },
        { "value": "display", "label": "Neue Haas Grotesk Display (Adobe)" },
        { "value": "text", "label": "Neue Haas Grotesk Text (Adobe)" },
        { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "site" },
    { "type": "select", "id": "heading_font", "label": "Heading font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" },
        { "value": "display", "label": "Neue Haas Grotesk Display (Adobe)" },
        { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "site" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 28, "max": 96, "step": 2, "unit": "px", "default": 56 },
    { "type": "color", "id": "heading_color", "label": "Heading color", "info": "Leave blank to use the theme default." },
    { "type": "select", "id": "heading_weight", "label": "Heading weight & style", "info": "Ogg Text has every option. Neue Haas Display has Thin/Book/Roman/Medium; Neue Haas Text has Roman only. Other picks get faked by the browser.", "options": [
        { "value": "inherit", "label": "Theme default" },
        { "value": "thin", "label": "Thin (200)" },
        { "value": "book", "label": "Book / Light (300)" },
        { "value": "book-italic", "label": "Book Italic (300)" },
        { "value": "roman", "label": "Roman / Regular (400)" },
        { "value": "roman-italic", "label": "Roman Italic (400)" },
        { "value": "medium", "label": "Medium (500)" },
        { "value": "medium-italic", "label": "Medium Italic (500)" },
        { "value": "bold", "label": "Bold (700)" },
        { "value": "black", "label": "Black (800)" } ], "default": "inherit" },
    { "type": "select", "id": "body_font", "label": "Body font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" },
        { "value": "text", "label": "Neue Haas Grotesk Text (Adobe)" },
        { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "site" },
    { "type": "range", "id": "body_size", "label": "Body text size", "min": 14, "max": 28, "step": 1, "unit": "px", "default": 20 },
    { "type": "color", "id": "body_color", "label": "Subheading color", "info": "Leave blank to use the theme default." },
    { "type": "select", "id": "body_weight", "label": "Body weight & style", "options": [
        { "value": "inherit", "label": "Theme default" },
        { "value": "thin", "label": "Thin (200)" },
        { "value": "book", "label": "Book / Light (300)" },
        { "value": "book-italic", "label": "Book Italic (300)" },
        { "value": "roman", "label": "Roman / Regular (400)" },
        { "value": "roman-italic", "label": "Roman Italic (400)" },
        { "value": "medium", "label": "Medium (500)" },
        { "value": "medium-italic", "label": "Medium Italic (500)" },
        { "value": "bold", "label": "Bold (700)" },
        { "value": "black", "label": "Black (800)" } ], "default": "inherit" },
    { "type": "header", "content": "Text spacing" },
    { "type": "range", "id": "space_preheader", "label": "Space after preheader", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "space_heading", "label": "Space after heading", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "space_buttons", "label": "Space above buttons", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "space_image", "label": "Space between image and text (above / below)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "header", "content": "Letter spacing" },
    { "type": "range", "id": "ls_preheader", "label": "Preheader letter spacing", "info": "1 = theme default, up to 10x wider.", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },
    { "type": "range", "id": "ls_heading", "label": "Heading letter spacing", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },
    { "type": "range", "id": "ls_body", "label": "Body letter spacing", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },
    { "type": "header", "content": "Background" },
    { "type": "select", "id": "bg_type", "label": "Background type", "options": [
        { "value": "none", "label": "None" }, { "value": "solid", "label": "Solid color" }, { "value": "gradient", "label": "Gradient" }, { "value": "image", "label": "Image" } ], "default": "none" },
    { "type": "color", "id": "bg_color", "label": "Solid color", "default": "#FBF6EE" },
    { "type": "color", "id": "bg_gradient_start", "label": "Gradient start", "default": "#FBF6EE" },
    { "type": "color", "id": "bg_gradient_end", "label": "Gradient end", "default": "#E7DAC4" },
    { "type": "range", "id": "bg_gradient_angle", "label": "Gradient angle", "min": 0, "max": 360, "step": 10, "unit": "deg", "default": 180 },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "header", "content": "Spacing & height" },
    { "type": "checkbox", "id": "extend_behind_header", "label": "Extend background behind header", "info": "Pulls the hero up so its background sits under the nav bar (no gap above it). Add Top padding below to keep the heading clear of the nav.", "default": false },
    { "type": "select", "id": "content_valign", "label": "Vertical content position", "info": "Applies when a minimum height is set.", "options": [ { "value": "top", "label": "Top" }, { "value": "center", "label": "Center" }, { "value": "bottom", "label": "Bottom" } ], "default": "top" },
    { "type": "range", "id": "min_height", "label": "Minimum height", "min": 0, "max": 1000, "step": 20, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 96 },
    { "type": "header", "content": "Mobile padding (≤749px)" },
    { "type": "checkbox", "id": "pad_mobile", "label": "Use different top/bottom padding on mobile", "default": false },
    { "type": "range", "id": "pt_m", "label": "Mobile top padding", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "pb_m", "label": "Mobile bottom padding", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
