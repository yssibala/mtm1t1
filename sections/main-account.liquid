<div class="container" style="padding:var(--section-pad) 0;">
  <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;">
    <h1>My account</h1>
    <div style="display:flex;gap:12px;">
      <a href="{{ routes.account_addresses_url }}" class="muse-pill muse-ghost">Addresses</a>
      <a href="{{ routes.account_logout_url }}" class="muse-pill muse-ghost">Log out</a>
    </div>
  </div>
  <p style="color:var(--text-meta);">Welcome{% if customer.first_name %}, {{ customer.first_name }}{% endif %}.</p>

  <h2 style="font-size:var(--fs-h3);margin-top:32px;">Order history</h2>
  {%- paginate customer.orders by 20 -%}
    {%- if customer.orders.size > 0 -%}
      <table style="width:100%;border-collapse:collapse;">
        <thead><tr style="text-align:left;border-bottom:1px solid var(--sand-border);">
          <th style="padding:10px 8px;">Order</th><th>Date</th><th>Total</th><th>Status</th>
        </tr></thead>
        <tbody>
          {%- for order in customer.orders -%}
            <tr style="border-bottom:1px solid var(--sand-border);">
              <td style="padding:10px 8px;"><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
              <td>{{ order.created_at | date: '%b %d, %Y' }}</td>
              <td>{{ order.total_price | money }}</td>
              <td>{{ order.financial_status_label }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
      {{ paginate | default_pagination }}
    {%- else -%}
      <p>You haven&rsquo;t placed any orders yet.</p>
    {%- endif -%}
  {%- endpaginate -%}
</div>
{% schema %}
{ "name": "Account", "settings": [] }
{% endschema %}
