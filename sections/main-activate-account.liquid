<div class="container" style="padding:var(--section-pad) 0;max-width:460px;">
  <h1 style="text-align:center;">Activate account</h1>
  <p style="text-align:center;color:var(--text-meta);">Create your password to activate your account.</p>
  {%- form 'activate_customer_password' -%}
    {{ form.errors | default_errors }}
    <label for="ac-pass">Password</label>
    <input type="password" name="customer[password]" id="ac-pass" autocomplete="new-password" required>
    <label for="ac-conf">Confirm password</label>
    <input type="password" name="customer[password_confirmation]" id="ac-conf" autocomplete="new-password" required>
    <div style="display:flex;gap:12px;margin-top:12px;">
      <button type="submit" name="commit" class="muse-pill muse-cta">Activate</button>
      <button type="submit" name="decline" class="muse-pill muse-ghost">Decline</button>
    </div>
  {%- endform -%}
</div>
{% schema %}
{ "name": "Activate account", "settings": [] }
{% endschema %}
