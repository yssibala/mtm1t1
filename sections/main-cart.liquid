{%- liquid
  assign s = section.settings
  assign align = s.text_align | default: 'left'
  if align == 'left'
    assign head_margin = 'margin-left:0;margin-right:auto;'
  elsif align == 'right'
    assign head_margin = 'margin-left:auto;margin-right:0;'
  else
    assign head_margin = 'margin-left:auto;margin-right:auto;'
  endif
-%}
<div class="section-wrap cart-page{% if s.extend_behind_header %} section-wrap--bleed{% endif %}{% if s.coming_soon %} is-coming-soon{% endif %}"{% if s.coming_soon %} data-cs-label="{{ settings.badge_text | default: 'Coming Soon' | escape }}"{% endif %} style="{%- render 'section-style', st: s -%}">
  <div class="container">
    <div class="page-contact__head" style="text-align:{{ align }};{{ head_margin }}">
      {%- if s.preheader != blank -%}<div class="kicker" style="font-family:{%- render 'font-stack', key: s.preheader_font -%};{% if s.accent_color != blank %}color:{{ s.accent_color }};{% endif %}margin-bottom:{{ s.space_preheader | default: 10 }}px;{%- render 'letter-spacing', mult: s.ls_preheader, base: '0.18em' -%}">{{ s.preheader }}</div>{%- endif -%}
      <h1 style="font-family:{%- render 'font-stack', key: s.heading_font -%};{%- render 'font-variant', key: s.heading_weight, font: s.heading_font -%}{%- render 'letter-spacing', mult: s.ls_heading, base: '0.05em' -%}{% if s.heading_color != blank %}color:{{ s.heading_color }};{% endif %}font-size:{{ s.heading_size | default: 44 }}px;margin-bottom:{{ s.space_heading | default: 12 }}px;">{{ s.heading | default: 'Your cart' }}</h1>
      {%- if s.intro_text != blank -%}<div class="rte page-contact__intro" style="font-family:{%- render 'font-stack', key: s.body_font -%};{% if s.body_color != blank %}color:{{ s.body_color }};{% endif %}{% if s.body_size > 0 %}font-size:{{ s.body_size }}px;{% endif %}">{{ s.intro_text }}</div>{%- endif -%}
    </div>

    <div class="cart-wrap"><div class="cart-card{% if s.card_border == false %} cart-card--noborder{% endif %}"{% if s.card_bg != blank %} style="background:{{ s.card_bg }};"{% endif %}>
    {%- if cart.item_count == 0 -%}
      <p style="color:var(--text-mid);">{{ s.empty_text | default: 'Your cart is currently empty.' }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="muse-pill muse-cta" style="margin-top:16px;">{{ s.empty_button | default: 'Continue shopping' }}</a>
    {%- else -%}
      {%- form 'cart', cart -%}
        {%- for item in cart.items -%}
          <div style="display:flex;align-items:flex-start;gap:16px;padding:16px 0;border-bottom:1px solid var(--sand-border);">
            {%- if item.image -%}
              <img src="{{ item.image | image_url: width: 120 }}" alt="{{ item.title | escape }}" width="60" height="60" style="width:60px;height:60px;object-fit:cover;border-radius:var(--radius-card);">
            {%- endif -%}
            <div style="flex:1;">
              <a href="{{ item.url }}" style="color:var(--near-black);font-weight:var(--fw-medium);">{{ item.product.title }}</a>
              {%- unless item.variant.title contains 'Default' -%}<div style="color:var(--text-meta);font-size:var(--fs-small);">{{ item.variant.title }}</div>{%- endunless -%}
              {%- if s.show_item_desc and item.product.description != blank -%}<div class="cart-item-note">{%- if s.item_desc_words > 0 -%}{{ item.product.description | strip_html | truncatewords: s.item_desc_words }}{%- else -%}{{ item.product.description | strip_html }}{%- endif -%}</div>{%- endif -%}
              {%- for n in (1..3) -%}
                {%- assign mk = 'item_mf_' | append: n -%}
                {%- assign mkey = s[mk] -%}
                {%- if mkey != blank -%}
                  {%- assign parts = mkey | split: '.' -%}
                  {%- if parts.size > 1 -%}{%- assign fns = parts[0] -%}{%- assign fkey = parts[1] -%}{%- else -%}{%- assign fns = item.product.handle -%}{%- assign fkey = mkey -%}{%- endif -%}
                  {%- assign mval = item.product.metafields[fns][fkey].value -%}
                  {%- if mval != blank -%}<div class="cart-item-note cart-item-note--mf">{{ mval }}</div>{%- endif -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if s.show_disclosure and s.item_disclosure != blank -%}<div class="cart-item-note cart-item-note--disclosure">{{ s.item_disclosure }}</div>{%- endif -%}
            </div>
            <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity" style="width:64px;padding:8px;border:1px solid var(--sand-border);border-radius:var(--radius-card);">
            <div style="min-width:90px;text-align:right;color:var(--muse-gold-dark);font-weight:var(--fw-semibold);">
              {%- if item.original_line_price > item.final_line_price -%}<s style="color:var(--text-meta);font-weight:400;">{{ item.original_line_price | money }}</s><br>{%- endif -%}
              {{ item.final_line_price | money }}
              {%- for alloc in item.line_level_discount_allocations -%}<div style="color:var(--muse-gold-dark);font-size:var(--fs-small);font-weight:400;">{{ alloc.discount_application.title }} (&minus;{{ alloc.amount | money }})</div>{%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
        {%- if cart.total_discount > 0 -%}
        <div style="display:flex;justify-content:flex-end;align-items:center;gap:20px;margin-top:16px;color:var(--muse-gold-dark);">
          <span>You save</span>
          <strong style="min-width:90px;text-align:right;">&minus;{{ cart.total_discount | money }}</strong>
        </div>
        {%- endif -%}
        {%- for d in cart.cart_level_discount_applications -%}
        <div style="display:flex;justify-content:flex-end;align-items:center;gap:20px;margin-top:8px;color:var(--muse-gold-dark);">
          <span>{{ d.title }} <em style="color:var(--text-meta);font-style:normal;font-size:var(--fs-small);">(applied at checkout)</em></span>
          <strong style="min-width:90px;text-align:right;">&minus;{{ d.total_allocated_amount | money }}</strong>
        </div>
        {%- endfor -%}
        <div style="display:flex;justify-content:flex-end;align-items:center;gap:20px;margin-top:24px;">
          <span style="color:var(--text-meta);">{{ s.subtotal_label | default: 'Subtotal' }}</span>
          <strong style="font-size:var(--fs-h3);">{{ cart.total_price | money }}</strong>
        </div>
        {%- if s.note_text != blank -%}<p style="text-align:right;color:var(--text-meta);font-size:var(--fs-small);margin-top:8px;">{{ s.note_text }}</p>{%- endif -%}
        <div style="display:flex;gap:12px;justify-content:flex-end;margin-top:20px;">
          {%- if s.show_update -%}<button type="submit" name="update" class="muse-pill muse-ghost">{{ s.update_label | default: 'Update' }}</button>{%- endif -%}
          <button type="submit" name="checkout" class="muse-pill muse-cta">{{ s.checkout_label | default: 'Checkout' }}</button>
        </div>
      {%- endform -%}
    {%- endif -%}
    </div></div>
  </div>
</div>
{% schema %}
{
  "name": "Cart",
  "settings": [
    { "type": "header", "content": "Coming soon" },
    { "type": "checkbox", "id": "coming_soon", "label": "Grey out + show \"coming soon\" badge", "default": false },
    { "type": "header", "content": "Header" },
    { "type": "text", "id": "preheader", "label": "Preheader" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your cart" },
    { "type": "richtext", "id": "intro_text", "label": "Intro / body text", "info": "Shows under the heading." },
    { "type": "select", "id": "text_align", "label": "Header alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ], "default": "left" },
    { "type": "header", "content": "Labels" },
    { "type": "text", "id": "empty_text", "label": "Empty-cart text", "default": "Your cart is currently empty." },
    { "type": "text", "id": "empty_button", "label": "Empty-cart button", "default": "Continue shopping" },
    { "type": "text", "id": "subtotal_label", "label": "Subtotal label", "default": "Subtotal" },
    { "type": "text", "id": "note_text", "label": "Note under subtotal", "info": "e.g. \"Taxes & shipping calculated at checkout.\" Leave blank to hide." },
    { "type": "checkbox", "id": "show_update", "label": "Show \"Update\" button", "default": true },
    { "type": "text", "id": "update_label", "label": "Update button", "default": "Update" },
    { "type": "text", "id": "checkout_label", "label": "Checkout button", "default": "Checkout" },
    { "type": "header", "content": "Per-item text (compliance)" },
    { "type": "paragraph", "content": "Optional text shown under each cart line — useful for descriptions, disclosures, and legal metafields." },
    { "type": "checkbox", "id": "show_item_desc", "label": "Show product description", "default": false },
    { "type": "range", "id": "item_desc_words", "label": "Trim description to words", "info": "0 = full text.", "min": 0, "max": 60, "step": 5, "default": 20 },
    { "type": "text", "id": "item_mf_1", "label": "Metafield 1", "info": "namespace.key (e.g. prod.legal-text). A bare key uses the product's handle as the namespace." },
    { "type": "text", "id": "item_mf_2", "label": "Metafield 2" },
    { "type": "text", "id": "item_mf_3", "label": "Metafield 3" },
    { "type": "checkbox", "id": "show_disclosure", "label": "Show disclosure line", "default": false },
    { "type": "textarea", "id": "item_disclosure", "label": "Disclosure text", "info": "The same line shown under every item." },
    { "type": "header", "content": "Card" },
    { "type": "checkbox", "id": "card_border", "label": "Card border & shadow", "info": "Sits the cart on a card, so a section background image shows behind it.", "default": true },
    { "type": "color", "id": "card_bg", "label": "Card background", "info": "Blank = theme default." },
    { "type": "header", "content": "Typography" },
    { "type": "select", "id": "preheader_font", "label": "Preheader font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" },
        { "value": "display", "label": "Neue Haas Grotesk Display (Adobe)" },
        { "value": "text", "label": "Neue Haas Grotesk Text (Adobe)" },
        { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "site" },
    { "type": "color", "id": "accent_color", "label": "Preheader color", "info": "Blank = theme default." },
    { "type": "select", "id": "heading_font", "label": "Heading font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" },
        { "value": "display", "label": "Neue Haas Grotesk Display (Adobe)" },
        { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "site" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 80, "step": 2, "unit": "px", "default": 44 },
    { "type": "color", "id": "heading_color", "label": "Heading color", "info": "Blank = theme default." },
    { "type": "select", "id": "heading_weight", "label": "Heading weight & style", "options": [
        { "value": "inherit", "label": "Theme default" },
        { "value": "thin", "label": "Thin (200)" },
        { "value": "book", "label": "Book / Light (300)" },
        { "value": "book-italic", "label": "Book Italic (300)" },
        { "value": "roman", "label": "Roman / Regular (400)" },
        { "value": "roman-italic", "label": "Roman Italic (400)" },
        { "value": "medium", "label": "Medium (500)" },
        { "value": "medium-italic", "label": "Medium Italic (500)" },
        { "value": "bold", "label": "Bold (700)" },
        { "value": "black", "label": "Black (800)" } ], "default": "inherit" },
    { "type": "select", "id": "body_font", "label": "Intro text font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" },
        { "value": "text", "label": "Neue Haas Grotesk Text (Adobe)" },
        { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "site" },
    { "type": "range", "id": "body_size", "label": "Intro text size", "info": "0 = theme default.", "min": 0, "max": 28, "step": 1, "unit": "px", "default": 0 },
    { "type": "color", "id": "body_color", "label": "Intro text color", "info": "Blank = theme default." },
    { "type": "header", "content": "Text spacing" },
    { "type": "range", "id": "space_preheader", "label": "Space after preheader", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 10 },
    { "type": "range", "id": "space_heading", "label": "Space after heading", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 12 },
    { "type": "header", "content": "Letter spacing" },
    { "type": "range", "id": "ls_preheader", "label": "Preheader letter spacing", "info": "1 = theme default, up to 10x wider.", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },
    { "type": "range", "id": "ls_heading", "label": "Heading letter spacing", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },
    { "type": "header", "content": "Background" },
    { "type": "select", "id": "bg_type", "label": "Background type", "options": [ { "value": "none", "label": "None" }, { "value": "solid", "label": "Solid color" }, { "value": "gradient", "label": "Gradient" }, { "value": "image", "label": "Image" } ], "default": "none" },
    { "type": "color", "id": "bg_color", "label": "Solid color", "default": "#FBF6EE" },
    { "type": "color", "id": "bg_gradient_start", "label": "Gradient start", "default": "#FBF6EE" },
    { "type": "color", "id": "bg_gradient_end", "label": "Gradient end", "default": "#E7DAC4" },
    { "type": "range", "id": "bg_gradient_angle", "label": "Gradient angle", "min": 0, "max": 360, "step": 10, "unit": "deg", "default": 180 },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "header", "content": "Spacing & height" },
    { "type": "checkbox", "id": "extend_behind_header", "label": "Extend background behind header", "info": "Pulls the section up so its background sits under the nav bar. Add Top padding to keep content clear of the nav.", "default": false },
    { "type": "select", "id": "content_valign", "label": "Vertical content position", "info": "Applies when a minimum height is set.", "options": [ { "value": "top", "label": "Top" }, { "value": "center", "label": "Center" }, { "value": "bottom", "label": "Bottom" } ], "default": "top" },
    { "type": "range", "id": "min_height", "label": "Minimum height", "min": 0, "max": 1000, "step": 20, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 40 }
  ]
}
{% endschema %}
