<div class="container" style="padding:var(--section-pad) 0;">
  <h1>Your cart</h1>
  {%- if cart.item_count == 0 -%}
    <p>Your cart is currently empty.</p>
    <a href="{{ routes.all_products_collection_url }}" class="muse-pill muse-cta">Continue shopping</a>
  {%- else -%}
    {%- form 'cart', cart -%}
      {%- for item in cart.items -%}
        <div style="display:flex;align-items:center;gap:16px;padding:16px 0;border-bottom:1px solid var(--sand-border);">
          {%- if item.image -%}
            <img src="{{ item.image | image_url: width: 120 }}" alt="{{ item.title | escape }}" width="60" style="width:60px;height:60px;object-fit:cover;border-radius:var(--radius-card);">
          {%- endif -%}
          <div style="flex:1;">
            <a href="{{ item.url }}" style="color:var(--near-black);font-weight:var(--fw-medium);">{{ item.product.title }}</a>
            {%- unless item.variant.title contains 'Default' -%}<div style="color:var(--text-meta);font-size:var(--fs-small);">{{ item.variant.title }}</div>{%- endunless -%}
          </div>
          <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity" style="width:64px;padding:8px;border:1px solid var(--sand-border);border-radius:var(--radius-card);">
          <div style="min-width:90px;text-align:right;color:var(--muse-gold-dark);font-weight:var(--fw-semibold);">{{ item.final_line_price | money }}</div>
        </div>
      {%- endfor -%}
      <div style="display:flex;justify-content:flex-end;align-items:center;gap:20px;margin-top:24px;">
        <span style="color:var(--text-meta);">Subtotal</span>
        <strong style="font-size:var(--fs-h3);">{{ cart.total_price | money }}</strong>
      </div>
      <div style="display:flex;gap:12px;justify-content:flex-end;margin-top:20px;">
        <button type="submit" name="update" class="muse-pill muse-ghost">Update</button>
        <button type="submit" name="checkout" class="muse-pill muse-cta">Checkout</button>
      </div>
    {%- endform -%}
  {%- endif -%}
</div>
{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
