{%- liquid
  assign s = section.settings
  comment
    'presale'  = storefront is locked; show the Shopify password field + email capture.
    'launched' = store is open; hide the password field entirely (use this section on a
                 normal page, since the password template only renders while locked).
    'message'  = announcement only; no password field and no signup form.
  endcomment
  assign mode = s.page_mode | default: 'presale'
  assign show_password = false
  if mode == 'presale' and template.name == 'password'
    assign show_password = true
  endif
  assign show_newsletter = false
  if s.show_newsletter and mode != 'message'
    assign show_newsletter = true
  endif
  assign align = s.text_align | default: 'center'
  assign flex_align = 'center'
  if align == 'left'
    assign flex_align = 'flex-start'
  elsif align == 'right'
    assign flex_align = 'flex-end'
  endif
  assign side_margin = 'auto'
  if align == 'left'
    assign side_margin = '0'
  endif
  assign eyebrow = s.kicker | default: settings.brand_eyebrow | default: 'Amongst the Clouds'
-%}
<div class="cloud-page" style="align-items:{{ flex_align }};text-align:{{ align }};{% if s.bg_color != blank %}background:{{ s.bg_color }};{% endif %}{% if s.bg_image != blank %}background-image:url('{{ s.bg_image | image_url: width: 2200 }}');background-size:cover;background-position:center;{% endif %}{% if s.padding_top %}padding-top:{{ s.padding_top }}px;{% endif %}{% if s.padding_bottom %}padding-bottom:{{ s.padding_bottom }}px;{% endif %}">
  {%- if s.show_monogram -%}
    {%- if settings.logo_2 != blank -%}{%- assign mono_src = settings.logo_2 | image_url: width: 500 -%}{%- assign mono_w = settings.logo_2.width -%}{%- assign mono_h = settings.logo_2.height -%}{%- else -%}{%- assign mono_src = 'muse-monogram-solo-gld.png' | asset_url -%}{%- assign mono_w = 497 -%}{%- assign mono_h = 477 -%}{%- endif -%}
    <img class="cloud-monogram" src="{{ mono_src }}" alt="{{ shop.name | escape }}" width="{{ mono_w }}" height="{{ mono_h }}" style="height:clamp(108px,14vw,{{ s.monogram_size | default: 150 }}px);">
  {%- endif -%}
  {%- if eyebrow != blank -%}
    <div class="cloud-kicker" style="font-family:{%- render 'font-stack', key: s.preheader_font -%};{% if s.accent_color != blank %}color:{{ s.accent_color }};{% endif %}margin-bottom:{{ s.space_preheader | default: 16 }}px;{%- render 'letter-spacing', mult: s.ls_preheader, base: '0.32em' -%}">{{ eyebrow }}</div>
  {%- endif -%}
  <h1 class="cloud-title" style="font-family:{%- render 'font-stack', key: s.heading_font -%};{%- render 'font-variant', key: s.heading_weight, font: s.heading_font -%}{%- render 'letter-spacing', mult: s.ls_heading, base: '0.01em' -%}{% if s.heading_color != blank %}color:{{ s.heading_color }};{% endif %}{% if s.heading_size > 0 %}font-size:{{ s.heading_size }}px;{% endif %}{% unless align == 'center' %}max-width:none;{% endunless %}">{{ s.heading | default: 'Coming Soon' | newline_to_br }}</h1>
  {%- if s.text != blank -%}
    <p class="cloud-text" style="font-family:{%- render 'font-stack', key: s.body_font -%};{%- render 'letter-spacing', mult: s.ls_body, base: '0.03em' -%}{% if s.body_color != blank %}color:{{ s.body_color }};{% endif %}{% if s.body_size > 0 %}font-size:{{ s.body_size }}px;{% endif %}margin-top:{{ s.space_heading | default: 20 }}px;margin-left:{{ side_margin }};margin-right:{% if align == 'right' %}0{% else %}{{ side_margin }}{% endif %};">{{ s.text | newline_to_br }}</p>
  {%- endif -%}

  {%- if show_newsletter -%}
    <div style="margin-top:{{ s.space_form | default: 28 }}px;position:relative;z-index:1;width:100%;max-width:460px;{% if align == 'center' %}margin-left:auto;margin-right:auto;{% elsif align == 'right' %}margin-left:auto;{% endif %}">
      {%- form 'customer' -%}
        <input type="hidden" name="contact[tags]" value="newsletter, prelaunch">
        {%- if form.posted_successfully? -%}
          <p class="cloud-text" style="margin-top:0;">{{ s.success_text | default: 'Thank you — we’ll be in touch soon.' }}</p>
        {%- else -%}
          <div class="cloud-password">
            <input type="email" name="contact[email]" placeholder="{{ s.email_label | default: 'Email address' }}" aria-label="Email" required>
            <button type="submit" class="muse-pill muse-cta">{{ s.newsletter_button | default: settings.newsletter_button | default: 'Notify me' }}</button>
          </div>
          {%- if s.show_consent -%}
            <label class="cloud-consent">
              <input type="checkbox" name="contact[accepts_marketing]" value="true" required>
              <span>{{ s.consent_text | default: settings.newsletter_consent | default: 'Email me about the launch. I can unsubscribe at any time.' }}</span>
            </label>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
  {%- endif -%}

  {%- if show_password -%}
    <div style="margin-top:34px;position:relative;z-index:1;">
      {%- form 'storefront_password' -%}
        {{ form.errors | default_errors }}
        <div class="cloud-password">
          <input type="password" name="password" placeholder="{{ s.password_label | default: 'Enter store password' }}" aria-label="Store password">
          <button type="submit" class="muse-pill muse-ghost">Enter</button>
        </div>
      {%- endform -%}
    </div>
  {%- endif -%}

  <div class="cloud-foot">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }} &middot; {{ s.foot_text | default: settings.age_statement | default: 'Enjoy Responsibly · 21+' }}</div>
</div>
{% schema %}
{
  "name": "Coming soon / Password",
  "settings": [
    { "type": "select", "id": "page_mode", "label": "Version", "info": "Presale shows the store-password field (Password template only). Launched hides it — use that version on a normal page once the store is open. Message only shows no forms at all.", "options": [
        { "value": "presale", "label": "Presale — password + email signup" },
        { "value": "launched", "label": "Launched — email signup, no password" },
        { "value": "message", "label": "Message only — no password, no email" } ], "default": "presale" },
    { "type": "text", "id": "kicker", "label": "Preheader", "info": "Leave blank to use the global tagline from Theme settings → Wording & brand voice." },
    { "type": "textarea", "id": "heading", "label": "Heading", "info": "Press Enter for a line break.", "default": "Coming Soon" },
    { "type": "textarea", "id": "text", "label": "Text", "info": "Press Enter for a line break.", "default": "We’re crafting something worth celebrating. This page is still amongst the clouds — check back soon to raise a glass with us." },
    { "type": "select", "id": "text_align", "label": "Alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ], "default": "center" },
    { "type": "header", "content": "Monogram" },
    { "type": "checkbox", "id": "show_monogram", "label": "Show floating monogram", "default": true },
    { "type": "range", "id": "monogram_size", "label": "Monogram max size", "min": 80, "max": 240, "step": 10, "unit": "px", "default": 150 },
    { "type": "header", "content": "Email signup" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show email signup", "info": "Ignored in \"Message only\" mode.", "default": true },
    { "type": "text", "id": "email_label", "label": "Email field placeholder", "default": "Email address" },
    { "type": "text", "id": "newsletter_button", "label": "Signup button label", "info": "Leave blank to use the global label from Theme settings → Wording." },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "Thank you — we’ll be in touch soon." },
    { "type": "checkbox", "id": "show_consent", "label": "Require marketing-consent checkbox", "info": "Visitors must tick this before the form will submit — makes opt-in explicit.", "default": true },
    { "type": "textarea", "id": "consent_text", "label": "Consent text", "info": "Leave blank to use the global consent line from Theme settings → Wording." },
    { "type": "header", "content": "Password field" },
    { "type": "text", "id": "password_label", "label": "Password field placeholder", "default": "Enter store password" },
    { "type": "header", "content": "Footer line" },
    { "type": "text", "id": "foot_text", "label": "Footer text (after © year)", "info": "Leave blank to use the global responsibility line from Theme settings → Wording." },
    { "type": "header", "content": "Typography" },
    { "type": "select", "id": "preheader_font", "label": "Preheader font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" },
        { "value": "display", "label": "Neue Haas Grotesk Display (Adobe)" },
        { "value": "text", "label": "Neue Haas Grotesk Text (Adobe)" },
        { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "site" },
    { "type": "color", "id": "accent_color", "label": "Preheader color", "info": "Blank = theme gold." },
    { "type": "select", "id": "heading_font", "label": "Heading font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" },
        { "value": "display", "label": "Neue Haas Grotesk Display (Adobe)" },
        { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "ogg" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "info": "0 = responsive (auto).", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 0 },
    { "type": "color", "id": "heading_color", "label": "Heading color", "info": "Blank = theme default." },
    { "type": "select", "id": "heading_weight", "label": "Heading weight & style", "options": [
        { "value": "inherit", "label": "Theme default" },
        { "value": "thin", "label": "Thin (200)" },
        { "value": "book", "label": "Book / Light (300)" },
        { "value": "book-italic", "label": "Book Italic (300)" },
        { "value": "roman", "label": "Roman / Regular (400)" },
        { "value": "roman-italic", "label": "Roman Italic (400)" },
        { "value": "medium", "label": "Medium (500)" },
        { "value": "medium-italic", "label": "Medium Italic (500)" },
        { "value": "bold", "label": "Bold (700)" },
        { "value": "black", "label": "Black (800)" } ], "default": "inherit" },
    { "type": "select", "id": "body_font", "label": "Body font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" },
        { "value": "text", "label": "Neue Haas Grotesk Text (Adobe)" },
        { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "site" },
    { "type": "range", "id": "body_size", "label": "Body text size", "info": "0 = responsive (auto).", "min": 0, "max": 28, "step": 1, "unit": "px", "default": 0 },
    { "type": "color", "id": "body_color", "label": "Body color", "info": "Blank = theme default." },
    { "type": "header", "content": "Text spacing" },
    { "type": "range", "id": "space_preheader", "label": "Space after preheader", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "space_heading", "label": "Space after heading", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "space_form", "label": "Space above signup", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 28 },
    { "type": "header", "content": "Letter spacing" },
    { "type": "range", "id": "ls_preheader", "label": "Preheader letter spacing", "info": "1 = theme default, up to 10x wider.", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },
    { "type": "range", "id": "ls_heading", "label": "Heading letter spacing", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },
    { "type": "range", "id": "ls_body", "label": "Body letter spacing", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },
    { "type": "header", "content": "Background" },
    { "type": "color", "id": "bg_color", "label": "Background color", "info": "Blank = theme default." },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "header", "content": "Spacing & height" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 40 }
  ],
  "presets": [{ "name": "Coming soon" }]
}
{% endschema %}
