<div class="container" style="padding:var(--section-pad) 0;max-width:460px;">
  <h1 style="text-align:center;">Reset password</h1>
  {%- form 'reset_customer_password' -%}
    {{ form.errors | default_errors }}
    <label for="rp-pass">New password</label>
    <input type="password" name="customer[password]" id="rp-pass" autocomplete="new-password" required>
    <label for="rp-conf">Confirm password</label>
    <input type="password" name="customer[password_confirmation]" id="rp-conf" autocomplete="new-password" required>
    <button type="submit" class="muse-pill muse-cta" style="width:100%;margin-top:12px;">Reset password</button>
  {%- endform -%}
</div>
{% schema %}
{ "name": "Reset password", "settings": [] }
{% endschema %}
