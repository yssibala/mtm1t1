{%- liquid
  assign s = section.settings
-%}
<div class="section-wrap product-grid{% if s.coming_soon %} is-coming-soon{% endif %}"{% if s.coming_soon %} data-cs-label="{{ settings.badge_text | default: 'Coming Soon' | escape }}"{% endif %} data-pg="{{ section.id }}" style="{%- render 'section-style', st: s -%}">
  <div class="container">
    {%- if s.preheader != blank or s.heading != blank or s.subheading != blank -%}
      <div class="product-grid__head" style="text-align:{{ s.text_align | default: 'left' }};margin-bottom:var(--space-lg);">
        {%- if s.preheader != blank -%}<div class="kicker" style="font-family:{%- render 'font-stack', key: s.preheader_font -%};color:{{ s.accent_color | default: '#C9851A' }};margin-bottom:{{ s.space_preheader | default: 10 }}px;{%- render 'letter-spacing', mult: s.ls_preheader, base: '0.18em' -%}">{{ s.preheader }}</div>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="{%- render 'mb-size', val: s.heading_size, def: 36, cls: 'mb-h' -%}" style="font-family:{%- render 'font-stack', key: s.heading_font -%};{%- render 'font-variant', key: s.heading_weight, font: s.heading_font -%}{%- render 'letter-spacing', mult: s.ls_heading, base: '0.05em' -%}{% if s.heading_color != blank %}color:{{ s.heading_color }};{% endif %}font-size:{{ s.heading_size }}px;margin:0;">{{ s.heading | newline_to_br }}</h2>{%- endif -%}
        {%- if s.subheading != blank -%}<div class="rte{%- render 'mb-size', val: s.body_size, def: 16, cls: ' mb-body' -%}" style="font-family:{%- render 'font-stack', key: s.body_font -%};{%- render 'letter-spacing', mult: s.ls_body, base: '0.03em' -%}font-size:{{ s.body_size | default: 16 }}px;color:{% if s.body_color != blank %}{{ s.body_color }}{% else %}var(--text-mid){% endif %};margin:10px 0 0;">{{ s.subheading | newline_to_br }}</div>{%- endif -%}
      </div>
    {%- endif -%}
    {%- assign grid_collection = s.collection -%}
    {%- assign product_blocks = section.blocks | where: 'type', 'product' -%}
    {%- assign filter_blocks = section.blocks | where: 'type', 'filter' -%}
    {%- if product_blocks.size > 0 or grid_collection != blank -%}
      {%- assign ftype = s.filter_type | default: 'collection' -%}
      {%- if filter_blocks.size > 0 -%}
        <div class="pg-filters{% if s.filter_align == 'center' %} pg-filters--center{% elsif s.filter_align == 'right' %} pg-filters--right{% endif %}" data-pg-filters data-filter-type="{{ ftype }}">
          <button type="button" class="pg-filter is-active" data-filter="">{{ s.filter_all_label | default: 'All' }}</button>
          {%- for fb in filter_blocks -%}
            {%- if ftype == 'tag' -%}
              {%- assign fval = fb.settings.tag | downcase | strip -%}
              {%- assign flabel = fb.settings.label | default: fb.settings.tag -%}
            {%- else -%}
              {%- assign fc = fb.settings.filter_collection -%}
              {%- assign fval = fc.handle -%}
              {%- assign flabel = fb.settings.label | default: fc.title -%}
            {%- endif -%}
            {%- if fval != blank -%}<button type="button" class="pg-filter" data-filter="{{ fval }}" {{ fb.shopify_attributes }}>{{ flabel }}</button>{%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
      <div class="grid pg-grid">
        {%- if product_blocks.size > 0 -%}
          {%- for block in product_blocks -%}
            {%- if block.settings.product != blank -%}
              {%- render 'pg-card', product: block.settings.product, s: s, block_attrs: block.shopify_attributes -%}
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for product in grid_collection.products limit: s.limit -%}
            {%- render 'pg-card', product: product, s: s -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- else -%}
      <p>Select a collection, or add Product blocks to hand-pick and order products.</p>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var root = document.querySelector('[data-pg="{{ section.id }}"]');
    if (!root) return;
    var qtys = root.querySelectorAll('.ps-qty');
    for (var i = 0; i < qtys.length; i++) {
      (function (q) {
        var input = q.querySelector('.ps-qty__n');
        var dec = q.querySelector('[data-qty-dec]');
        var inc = q.querySelector('[data-qty-inc]');
        if (dec) dec.addEventListener('click', function () { input.value = Math.max(1, (parseInt(input.value, 10) || 1) - 1); });
        if (inc) inc.addEventListener('click', function () { input.value = (parseInt(input.value, 10) || 1) + 1; });
      })(qtys[i]);
    }
    var fbar = root.querySelector('[data-pg-filters]');
    if (fbar) {
      var attr = (fbar.getAttribute('data-filter-type') === 'tag') ? 'data-tags' : 'data-collections';
      var btns = fbar.querySelectorAll('.pg-filter');
      var cards = root.querySelectorAll('.pg-card');
      fbar.addEventListener('click', function (e) {
        var b = e.target.closest ? e.target.closest('.pg-filter') : null;
        if (!b) return;
        var f = b.getAttribute('data-filter') || '';
        for (var j = 0; j < btns.length; j++) { btns[j].classList.toggle('is-active', btns[j] === b); }
        for (var k = 0; k < cards.length; k++) {
          var vals = ',' + (cards[k].getAttribute(attr) || '') + ',';
          cards[k].style.display = (!f || vals.indexOf(',' + f + ',') > -1) ? '' : 'none';
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Product grid",
  "settings": [
    { "type": "header", "content": "Coming soon" },
    { "type": "checkbox", "id": "coming_soon", "label": "Grey out + show \"coming soon\" badge", "default": false },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "number", "id": "limit", "label": "Products to show", "default": 12 },
    { "type": "text", "id": "preheader", "label": "Preheader (optional)" },
    { "type": "textarea", "id": "heading", "label": "Heading (optional)", "info": "Press Enter for a line break." },
    { "type": "textarea", "id": "subheading", "label": "Subheading (optional)", "info": "Shows under the heading only when filled. Press Enter for a line break." },
    { "type": "color", "id": "accent_color", "label": "Preheader color", "default": "#C9851A" },
    { "type": "select", "id": "text_align", "label": "Heading alignment", "options": [
        { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ], "default": "left" },
    { "type": "header", "content": "Typography" },
    { "type": "select", "id": "preheader_font", "label": "Preheader font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" },
        { "value": "display", "label": "Neue Haas Grotesk Display (Adobe)" },
        { "value": "text", "label": "Neue Haas Grotesk Text (Adobe)" },
        { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "site" },
    { "type": "select", "id": "heading_font", "label": "Heading font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" },
        { "value": "display", "label": "Neue Haas Grotesk Display (Adobe)" },
        { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "site" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 80, "step": 2, "unit": "px", "default": 36 },
    { "type": "color", "id": "heading_color", "label": "Heading color", "info": "Leave blank to use the theme default." },
    { "type": "select", "id": "body_font", "label": "Subheading font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" },
        { "value": "text", "label": "Neue Haas Grotesk Text (Adobe)" },
        { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "site" },
    { "type": "range", "id": "body_size", "label": "Subheading size", "min": 12, "max": 28, "step": 1, "unit": "px", "default": 16 },
    { "type": "color", "id": "body_color", "label": "Subheading color", "info": "Leave blank to use the theme default." },
    { "type": "range", "id": "ls_preheader", "label": "Preheader letter spacing", "info": "1 = theme default, up to 10x wider.", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },
    { "type": "range", "id": "ls_heading", "label": "Heading letter spacing", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },
    { "type": "range", "id": "ls_body", "label": "Subheading letter spacing", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },
    { "type": "select", "id": "heading_weight", "label": "Heading weight & style", "info": "Ogg Text has every option. Neue Haas Display has Thin/Book/Roman/Medium; Neue Haas Text has Roman only. Other picks get faked by the browser.", "options": [
        { "value": "inherit", "label": "Theme default" },
        { "value": "thin", "label": "Thin (200)" },
        { "value": "book", "label": "Book / Light (300)" },
        { "value": "book-italic", "label": "Book Italic (300)" },
        { "value": "roman", "label": "Roman / Regular (400)" },
        { "value": "roman-italic", "label": "Roman Italic (400)" },
        { "value": "medium", "label": "Medium (500)" },
        { "value": "medium-italic", "label": "Medium Italic (500)" },
        { "value": "bold", "label": "Bold (700)" },
        { "value": "black", "label": "Black (800)" } ], "default": "inherit" },
    { "type": "header", "content": "Product card" },
    { "type": "paragraph", "content": "Title, price and buttons show on the card itself. Whatever you want revealed when the image is hovered is set under \"Hover overlay\" below. Add Product blocks below to hand-pick and drag to reorder (overrides the collection); add Filter blocks for filter buttons." },
    { "type": "select", "id": "card_align", "label": "Card text alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ], "default": "center" },
    { "type": "color", "id": "overlay_color", "label": "Hover overlay color", "default": "#0A0B0C" },
    { "type": "range", "id": "overlay_opacity", "label": "Hover overlay opacity", "min": 0, "max": 100, "step": 4, "unit": "%", "default": 88 },
    { "type": "checkbox", "id": "card_border", "label": "Card border", "default": true },
    { "type": "select", "id": "ov_font", "label": "Overlay text font", "info": "Font for the hover overlay lines.", "options": [
        { "value": "site", "label": "Neue Haas Display Light" }, { "value": "display", "label": "Neue Haas Grotesk Display (Adobe)" }, { "value": "text", "label": "Neue Haas Grotesk Text (Adobe)" }, { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "text" },
    { "type": "select", "id": "title_font", "label": "Title font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" }, { "value": "display", "label": "Neue Haas Grotesk Display (Adobe)" }, { "value": "text", "label": "Neue Haas Grotesk Text (Adobe)" }, { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "site" },
    { "type": "select", "id": "title_weight", "label": "Title weight & style", "options": [
        { "value": "inherit", "label": "Theme default" },
        { "value": "thin", "label": "Thin (200)" },
        { "value": "book", "label": "Book / Light (300)" },
        { "value": "book-italic", "label": "Book Italic (300)" },
        { "value": "roman", "label": "Roman / Regular (400)" },
        { "value": "roman-italic", "label": "Roman Italic (400)" },
        { "value": "medium", "label": "Medium (500)" },
        { "value": "medium-italic", "label": "Medium Italic (500)" },
        { "value": "bold", "label": "Bold (700)" },
        { "value": "black", "label": "Black (800)" } ], "default": "inherit" },
    { "type": "range", "id": "title_size", "label": "Title size", "min": 12, "max": 32, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "ls_title", "label": "Title letter spacing", "info": "1 = default, up to 10x wider.", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },
    { "type": "color", "id": "title_color", "label": "Title color", "info": "Blank = theme default." },
    { "type": "range", "id": "price_size", "label": "Price size", "min": 12, "max": 26, "step": 1, "unit": "px", "default": 15 },
    { "type": "color", "id": "price_color", "label": "Price color", "info": "Blank = gold." },
    { "type": "text", "id": "mf_namespace", "label": "Metafield namespace", "info": "Used by @tagline and by bare metafield keys. e.g. custom. Blank = each product's handle." },
    { "type": "text", "id": "tagline_key", "label": "Tagline metafield key", "info": "Which metafield @tagline reads.", "default": "tagline" },
    { "type": "header", "content": "Product card — hover overlay (over image)" },
    { "type": "paragraph", "content": "The hover overlay shows these lines, top to bottom. Each box takes a built-in — @title, @tagline, @price, @description — or a metafield as namespace.key (e.g. prod.legal-text). A bare key uses the namespace above / the product handle. For title, tagline, description, legal: @title, @tagline, @description, prod.legal-text." },
    { "type": "checkbox", "id": "show_hover", "label": "Show hover overlay", "default": true },
    { "type": "text", "id": "hover_key_1", "label": "Line 1" },
    { "type": "text", "id": "hover_key_2", "label": "Line 2" },
    { "type": "text", "id": "hover_key_3", "label": "Line 3" },
    { "type": "text", "id": "hover_key_4", "label": "Line 4" },
    { "type": "text", "id": "hover_key_5", "label": "Line 5" },
    { "type": "range", "id": "hover_size", "label": "Hover text size", "min": 10, "max": 24, "step": 1, "unit": "px", "default": 14 },
    { "type": "color", "id": "hover_color", "label": "Hover text color", "info": "Blank = light text on the overlay." },
    { "type": "range", "id": "hover_ls", "label": "Hover letter spacing", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },
    { "type": "range", "id": "hover_lines", "label": "Hover text height (lines)", "info": "0 = no cap.", "min": 0, "max": 16, "step": 1, "default": 0 },
    { "type": "header", "content": "Product card — buttons" },
    { "type": "select", "id": "button_layout", "label": "Button arrangement", "options": [
        { "value": "triple", "label": "View · − 1 + · Add to cart" },
        { "value": "cart_qty", "label": "− 1 + · Add to cart" },
        { "value": "view_cart", "label": "View · Add to cart" },
        { "value": "cart", "label": "Add to cart only" } ], "default": "triple" },
    { "type": "text", "id": "view_label", "label": "View button label", "default": "View" },
    { "type": "text", "id": "cart_label", "label": "Add-to-cart label", "default": "Add to cart" },
    { "type": "select", "id": "cart_style", "label": "Add-to-cart style", "options": [ { "value": "primary", "label": "Gold (filled)" }, { "value": "ghost", "label": "Outline" } ], "default": "primary" },
    { "type": "select", "id": "btn_size", "label": "Button size", "options": [
        { "value": "11", "label": "Standard" }, { "value": "10", "label": "10% smaller" }, { "value": "9", "label": "20% smaller" }, { "value": "8", "label": "30% smaller" }, { "value": "7", "label": "40% smaller" } ], "default": "10" },
    { "type": "header", "content": "Filters" },
    { "type": "paragraph", "content": "Add \"Filter button\" blocks below. Choose whether filters match a product's collections or its tags, then fill the matching field on each block. Selecting a filter shows only the cards that match." },
    { "type": "select", "id": "filter_type", "label": "Filter by", "options": [ { "value": "collection", "label": "Collection" }, { "value": "tag", "label": "Product tag" } ], "default": "collection" },
    { "type": "text", "id": "filter_all_label", "label": "\"All\" button label", "default": "All" },
    { "type": "select", "id": "filter_align", "label": "Filter alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ], "default": "center" },
    { "type": "header", "content": "Background" },
    { "type": "select", "id": "bg_type", "label": "Background type", "options": [
        { "value": "none", "label": "None" }, { "value": "solid", "label": "Solid color" }, { "value": "gradient", "label": "Gradient" }, { "value": "image", "label": "Image" } ], "default": "none" },
    { "type": "color", "id": "bg_color", "label": "Solid color", "default": "#FBF6EE" },
    { "type": "color", "id": "bg_gradient_start", "label": "Gradient start", "default": "#FBF6EE" },
    { "type": "color", "id": "bg_gradient_end", "label": "Gradient end", "default": "#E7DAC4" },
    { "type": "range", "id": "bg_gradient_angle", "label": "Gradient angle", "min": 0, "max": 360, "step": 10, "unit": "deg", "default": 180 },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "header", "content": "Spacing & height" },
    { "type": "select", "id": "content_valign", "label": "Vertical content position", "info": "Applies when a minimum height is set.", "options": [ { "value": "top", "label": "Top" }, { "value": "center", "label": "Center" }, { "value": "bottom", "label": "Bottom" } ], "default": "top" },
    { "type": "range", "id": "min_height", "label": "Minimum height", "min": 0, "max": 1000, "step": 20, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 64 },
    { "type": "header", "content": "Mobile padding (≤749px)" },
    { "type": "checkbox", "id": "pad_mobile", "label": "Use different top/bottom padding on mobile", "default": false },
    { "type": "range", "id": "pt_m", "label": "Mobile top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "pb_m", "label": "Mobile bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    { "type": "product", "name": "Product", "settings": [
      { "type": "product", "id": "product", "label": "Product" } ] },
    { "type": "filter", "name": "Filter button", "settings": [
      { "type": "text", "id": "label", "label": "Button label", "info": "Blank = collection name (collection mode) or the tag (tag mode)." },
      { "type": "collection", "id": "filter_collection", "label": "Collection", "info": "Used when \"Filter by\" is Collection." },
      { "type": "text", "id": "tag", "label": "Product tag", "info": "Used when \"Filter by\" is Product tag." } ] }
  ],
  "max_blocks": 30,
  "presets": [{ "name": "Product grid" }]
}
{% endschema %}
