{%- comment -%}
  Product Showcase — a richer, fully-customizable alternative to Featured collection.
  Pulls products from a collection and renders cards with a configurable text layout
  (title / tagline / description / details / price) and a 1-, 2-, or 3-button layout
  (the 3-button option includes a quantity stepper + add-to-cart).

  Tagline + details come from product metafields; the namespace defaults to the
  product handle (e.g. the "Clio" product -> clio.tagline / clio.prod_detail_set01),
  and can be overridden per section. Create the metafield definitions in
  Shopify admin > Settings > Custom data > Products.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
-%}
<div class="section-wrap product-showcase{% if s.coming_soon %} is-coming-soon{% endif %}"{% if s.coming_soon %} data-cs-label="{{ settings.badge_text | default: 'Coming Soon' | escape }}"{% endif %} data-ps="{{ section.id }}" style="{%- render 'section-style', st: s -%}">
  <div class="container">
    {%- if s.preheader != blank or s.heading != blank or s.subheading != blank -%}
      <div class="product-showcase__head" style="text-align:{{ s.head_align | default: 'center' }};margin-bottom:var(--space-xl);">
        {%- if s.preheader != blank -%}<div class="kicker" style="font-family:{%- render 'font-stack', key: s.preheader_font -%};color:{{ s.accent_color | default: '#C9851A' }};margin-bottom:10px;{%- render 'letter-spacing', mult: s.ls_preheader, base: '0.18em' -%}">{{ s.preheader }}</div>{%- endif -%}
        {%- if s.heading != blank -%}<h2 style="font-family:{%- render 'font-stack', key: s.heading_font -%};{%- render 'font-variant', key: s.heading_weight, font: s.heading_font -%}{%- render 'letter-spacing', mult: s.ls_heading, base: '0.05em' -%}{% if s.heading_color != blank %}color:{{ s.heading_color }};{% endif %}font-size:{{ s.heading_size }}px;margin:0;">{{ s.heading | newline_to_br }}</h2>{%- endif -%}
        {%- if s.subheading != blank -%}<div class="rte" style="max-width:640px;margin-top:10px;{% if s.head_align == 'center' %}margin-left:auto;margin-right:auto;{% elsif s.head_align == 'right' %}margin-left:auto;{% endif %}font-family:{%- render 'font-stack', key: s.body_font -%};font-size:{{ s.subheading_size | default: 17 }}px;color:var(--text-mid);">{{ s.subheading | newline_to_br }}</div>{%- endif -%}
      </div>
    {%- endif -%}

    {%- assign showcase_collection = s.collection -%}
    {%- if section.blocks.size > 0 or showcase_collection != blank -%}
      <div class="product-showcase__grid" style="--ps-cols:{{ s.columns }};">
        {%- if section.blocks.size > 0 -%}
          {%- comment -%} Manual product list — reorder the blocks to reorder the cards {%- endcomment -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.product != blank -%}
              {%- render 'ps-card', product: block.settings.product, s: s, block_attrs: block.shopify_attributes -%}
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for product in showcase_collection.products limit: s.limit -%}
            {%- render 'ps-card', product: product, s: s -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- else -%}
      <p>Select a collection, or add Product blocks to hand-pick and order products.</p>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var root = document.querySelector('[data-ps="{{ section.id }}"]');
    if (!root) return;
    var qtys = root.querySelectorAll('.ps-qty');
    for (var i = 0; i < qtys.length; i++) {
      (function (q) {
        var input = q.querySelector('.ps-qty__n');
        var dec = q.querySelector('[data-qty-dec]');
        var inc = q.querySelector('[data-qty-inc]');
        if (dec) dec.addEventListener('click', function () { input.value = Math.max(1, (parseInt(input.value, 10) || 1) - 1); });
        if (inc) inc.addEventListener('click', function () { input.value = (parseInt(input.value, 10) || 1) + 1; });
      })(qtys[i]);
    }
  })();
</script>

{% schema %}
{
  "name": "Product showcase",
  "settings": [
    { "type": "header", "content": "Coming soon" },
    { "type": "checkbox", "id": "coming_soon", "label": "Grey out + show \"coming soon\" badge", "default": false },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 24, "step": 1, "default": 6 },
    { "type": "paragraph", "content": "To hand-pick products and set their order, add Product blocks below and drag to reorder — that overrides the collection above." },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 1, "max": 5, "step": 1, "default": 3 },
    { "type": "header", "content": "Section heading (optional)" },
    { "type": "text", "id": "preheader", "label": "Preheader" },
    { "type": "color", "id": "accent_color", "label": "Preheader color", "default": "#C9851A" },
    { "type": "textarea", "id": "heading", "label": "Heading", "info": "Press Enter for a line break." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "info": "Press Enter for a line break." },
    { "type": "select", "id": "head_align", "label": "Heading alignment", "options": [
        { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ], "default": "center" },
    { "type": "select", "id": "preheader_font", "label": "Preheader font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" }, { "value": "display", "label": "Neue Haas Grotesk Display (Adobe)" }, { "value": "text", "label": "Neue Haas Grotesk Text (Adobe)" }, { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "site" },
    { "type": "select", "id": "heading_font", "label": "Heading font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" }, { "value": "display", "label": "Neue Haas Grotesk Display (Adobe)" }, { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "site" },
    { "type": "select", "id": "heading_weight", "label": "Heading weight & style", "options": [
        { "value": "inherit", "label": "Theme default" }, { "value": "thin", "label": "Thin (200)" }, { "value": "book", "label": "Book / Light (300)" }, { "value": "book-italic", "label": "Book Italic (300)" }, { "value": "roman", "label": "Roman / Regular (400)" }, { "value": "roman-italic", "label": "Roman Italic (400)" }, { "value": "medium", "label": "Medium (500)" }, { "value": "medium-italic", "label": "Medium Italic (500)" }, { "value": "bold", "label": "Bold (700)" }, { "value": "black", "label": "Black (800)" } ], "default": "inherit" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 80, "step": 2, "unit": "px", "default": 40 },
    { "type": "color", "id": "heading_color", "label": "Heading color", "info": "Leave blank to use the theme default." },
    { "type": "range", "id": "ls_preheader", "label": "Preheader letter spacing", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },
    { "type": "range", "id": "ls_heading", "label": "Heading letter spacing", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },
    { "type": "select", "id": "body_font", "label": "Subheading font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" }, { "value": "text", "label": "Neue Haas Grotesk Text (Adobe)" }, { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "site" },
    { "type": "range", "id": "subheading_size", "label": "Subheading size", "min": 13, "max": 28, "step": 1, "unit": "px", "default": 17 },
    { "type": "header", "content": "Card layout" },
    { "type": "select", "id": "card_align", "label": "Card text alignment", "options": [
        { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ], "default": "left" },
    { "type": "checkbox", "id": "card_border", "label": "Card background + border", "default": true },
    { "type": "header", "content": "Card — Metafields (tagline + details)" },
    { "type": "paragraph", "content": "Tagline and details are read per product from metafields. Recommended: create one shared namespace (e.g. custom) and put its name below, then set each product's own value. Leave the namespace blank to instead read each product's handle as the namespace (clio.tagline, thalia.tagline, ...)." },
    { "type": "text", "id": "mf_namespace", "label": "Metafield namespace", "info": "e.g. custom. Blank = use each product's handle." },
    { "type": "text", "id": "tagline_key", "label": "Tagline key", "default": "tagline" },
    { "type": "text", "id": "details_key", "label": "Details key", "default": "prod_detail_set01" },
    { "type": "header", "content": "Card — Title" },
    { "type": "select", "id": "title_font", "label": "Font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" }, { "value": "display", "label": "Neue Haas Grotesk Display (Adobe)" }, { "value": "text", "label": "Neue Haas Grotesk Text (Adobe)" }, { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "site" },
    { "type": "select", "id": "title_weight", "label": "Weight & style", "options": [
        { "value": "inherit", "label": "Theme default" }, { "value": "thin", "label": "Thin (200)" }, { "value": "book", "label": "Book / Light (300)" }, { "value": "book-italic", "label": "Book Italic (300)" }, { "value": "roman", "label": "Roman / Regular (400)" }, { "value": "roman-italic", "label": "Roman Italic (400)" }, { "value": "medium", "label": "Medium (500)" }, { "value": "medium-italic", "label": "Medium Italic (500)" }, { "value": "bold", "label": "Bold (700)" }, { "value": "black", "label": "Black (800)" } ], "default": "inherit" },
    { "type": "range", "id": "title_size", "label": "Size", "min": 12, "max": 40, "step": 1, "unit": "px", "default": 20 },
    { "type": "color", "id": "title_color", "label": "Color", "info": "Leave blank to use the theme default." },
    { "type": "range", "id": "title_ls", "label": "Letter spacing", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },
    { "type": "header", "content": "Card — Tagline" },
    { "type": "checkbox", "id": "show_tagline", "label": "Show tagline", "default": true },
    { "type": "text", "id": "tagline_fallback", "label": "Fallback tagline", "info": "Shown when a product has no tagline metafield. Leave blank to hide when empty." },
    { "type": "select", "id": "tagline_font", "label": "Font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" }, { "value": "display", "label": "Neue Haas Grotesk Display (Adobe)" }, { "value": "text", "label": "Neue Haas Grotesk Text (Adobe)" }, { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "ogg" },
    { "type": "range", "id": "tagline_size", "label": "Size", "min": 11, "max": 28, "step": 1, "unit": "px", "default": 15 },
    { "type": "color", "id": "tagline_color", "label": "Color", "info": "Leave blank to use the theme default." },
    { "type": "range", "id": "tagline_ls", "label": "Letter spacing", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },
    { "type": "header", "content": "Card — Description" },
    { "type": "checkbox", "id": "show_desc", "label": "Show product description", "default": false },
    { "type": "range", "id": "desc_words", "label": "Trim to word count", "info": "0 = show the full description.", "min": 0, "max": 80, "step": 5, "default": 20 },
    { "type": "range", "id": "desc_lines", "label": "Text height (lines)", "info": "Caps the description to this many lines on every card (equal height, extra text is clipped). 0 = no cap.", "min": 0, "max": 16, "step": 1, "default": 4 },
    { "type": "select", "id": "desc_font", "label": "Font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" }, { "value": "display", "label": "Neue Haas Grotesk Display (Adobe)" }, { "value": "text", "label": "Neue Haas Grotesk Text (Adobe)" }, { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "site" },
    { "type": "range", "id": "desc_size", "label": "Size", "min": 11, "max": 22, "step": 1, "unit": "px", "default": 14 },
    { "type": "color", "id": "desc_color", "label": "Color", "info": "Leave blank to use the theme default." },
    { "type": "range", "id": "desc_ls", "label": "Letter spacing", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },
    { "type": "header", "content": "Card — Details line" },
    { "type": "checkbox", "id": "show_details", "label": "Show details line", "default": false },
    { "type": "select", "id": "details_font", "label": "Font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" }, { "value": "display", "label": "Neue Haas Grotesk Display (Adobe)" }, { "value": "text", "label": "Neue Haas Grotesk Text (Adobe)" }, { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "text" },
    { "type": "range", "id": "details_size", "label": "Size", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 12 },
    { "type": "color", "id": "details_color", "label": "Color", "info": "Leave blank to use the theme default." },
    { "type": "range", "id": "details_ls", "label": "Letter spacing", "min": 1, "max": 10, "step": 1, "unit": "x", "default": 1 },
    { "type": "header", "content": "Card — Price" },
    { "type": "select", "id": "price_font", "label": "Font", "options": [
        { "value": "site", "label": "Neue Haas Display Light" }, { "value": "display", "label": "Neue Haas Grotesk Display (Adobe)" }, { "value": "text", "label": "Neue Haas Grotesk Text (Adobe)" }, { "value": "ogg", "label": "Ogg Text (Adobe serif)" } ], "default": "text" },
    { "type": "range", "id": "price_size", "label": "Size", "min": 12, "max": 28, "step": 1, "unit": "px", "default": 15 },
    { "type": "color", "id": "price_color", "label": "Color", "info": "Leave blank to use the theme gold." },
    { "type": "header", "content": "Card — Buttons" },
    { "type": "select", "id": "btn_layout", "label": "Button layout", "options": [
        { "value": "none", "label": "No buttons" },
        { "value": "single", "label": "1 — single centered button" },
        { "value": "double", "label": "2 — two buttons, spaced" },
        { "value": "triple", "label": "3 — button · quantity · button" } ], "default": "single" },
    { "type": "select", "id": "btn_size", "label": "Button size (all buttons)", "options": [
        { "value": "11", "label": "Standard" }, { "value": "10", "label": "10% smaller" }, { "value": "9", "label": "20% smaller" }, { "value": "8", "label": "30% smaller" }, { "value": "7", "label": "40% smaller" } ], "default": "9" },
    { "type": "paragraph", "content": "Button A is the left/only button; Button B is the right button (2- and 3-button layouts)." },
    { "type": "text", "id": "btn_a_label", "label": "Button A label", "default": "View" },
    { "type": "select", "id": "btn_a_mode", "label": "Button A action", "options": [
        { "value": "product", "label": "Go to product page" }, { "value": "url", "label": "Custom link" }, { "value": "cart", "label": "Add to cart" } ], "default": "product" },
    { "type": "url", "id": "btn_a_url", "label": "Button A custom link" },
    { "type": "select", "id": "btn_a_style", "label": "Button A style", "options": [
        { "value": "primary", "label": "Gold (filled)" }, { "value": "ghost", "label": "Outline" } ], "default": "ghost" },
    { "type": "text", "id": "btn_b_label", "label": "Button B label", "default": "Add to cart" },
    { "type": "select", "id": "btn_b_mode", "label": "Button B action", "options": [
        { "value": "product", "label": "Go to product page" }, { "value": "url", "label": "Custom link" }, { "value": "cart", "label": "Add to cart" } ], "default": "cart" },
    { "type": "url", "id": "btn_b_url", "label": "Button B custom link" },
    { "type": "select", "id": "btn_b_style", "label": "Button B style", "options": [
        { "value": "primary", "label": "Gold (filled)" }, { "value": "ghost", "label": "Outline" } ], "default": "primary" },
    { "type": "header", "content": "Background" },
    { "type": "select", "id": "bg_type", "label": "Background type", "options": [
        { "value": "none", "label": "None" }, { "value": "solid", "label": "Solid color" }, { "value": "gradient", "label": "Gradient" }, { "value": "image", "label": "Image" } ], "default": "none" },
    { "type": "color", "id": "bg_color", "label": "Solid color", "default": "#FBF6EE" },
    { "type": "color", "id": "bg_gradient_start", "label": "Gradient start", "default": "#FBF6EE" },
    { "type": "color", "id": "bg_gradient_end", "label": "Gradient end", "default": "#E7DAC4" },
    { "type": "range", "id": "bg_gradient_angle", "label": "Gradient angle", "min": 0, "max": 360, "step": 10, "unit": "deg", "default": 180 },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "header", "content": "Spacing & height" },
    { "type": "select", "id": "content_valign", "label": "Vertical content position", "info": "Applies when a minimum height is set.", "options": [ { "value": "top", "label": "Top" }, { "value": "center", "label": "Center" }, { "value": "bottom", "label": "Bottom" } ], "default": "top" },
    { "type": "range", "id": "min_height", "label": "Minimum height", "min": 0, "max": 1000, "step": 20, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    { "type": "product", "name": "Product", "settings": [
      { "type": "product", "id": "product", "label": "Product" } ] }
  ],
  "max_blocks": 24,
  "presets": [{ "name": "Product showcase" }]
}
{% endschema %}
