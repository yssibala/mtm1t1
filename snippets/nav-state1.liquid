{%- comment -%}
  Shared State-1 bar (full-width, top-of-page) used by both nav bars.
  Params: menu_left, menu_right (linklists), section_logo, show_account, show_search.
{%- endcomment -%}
<div id="nav-state1" class="nav-bar nav-bar--1">
  <div class="nav-links nav-links--spread" style="flex:1;justify-content:space-evenly;">
    {%- render 'nav-links', menu: menu_left, fallback: 'left' -%}
  </div>
  {%- render 'nav-logo', section_logo: section_logo -%}
  <div class="nav-right" style="flex:1;display:flex;align-items:center;">
    <div class="nav-links nav-links--spread" style="flex:1;justify-content:space-evenly;">
      {%- render 'nav-links', menu: menu_right, fallback: 'right' -%}
    </div>
    {%- render 'nav-icons', show_account: show_account, show_search: show_search -%}
  </div>
</div>
