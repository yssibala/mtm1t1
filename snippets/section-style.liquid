{%- comment -%}Inline style for a section wrapper. Param: st (pass section.settings).{%- endcomment -%}
{%- if st.bg_type == 'solid' -%}background:{{ st.bg_color }};{%- endif -%}
{%- if st.bg_type == 'gradient' -%}background:linear-gradient({{ st.bg_gradient_angle | default: 180 }}deg, {{ st.bg_gradient_start }}, {{ st.bg_gradient_end }});{%- endif -%}
{%- if st.bg_type == 'image' and st.bg_image != blank -%}background-image:url({{ st.bg_image | image_url: width: 2200 }});background-size:cover;background-position:center;{%- endif -%}
{%- if st.min_height and st.min_height > 0 -%}
  {%- assign valign = st.content_valign | default: 'top' -%}
  min-height:{{ st.min_height }}px;
  {%- comment -%}Only switch to flex when centering is actually asked for, so default layouts are untouched.{%- endcomment -%}
  {%- unless valign == 'top' -%}
    display:flex;flex-direction:column;justify-content:{% if valign == 'center' %}center{% else %}flex-end{% endif %};
  {%- endunless -%}
{%- endif -%}
--sec-pt:{{ st.padding_top | default: 64 }}px;--sec-pb:{{ st.padding_bottom | default: 64 }}px;{%- if st.pad_mobile -%}--sec-pt-m:{{ st.pt_m | default: 40 }}px;--sec-pb-m:{{ st.pb_m | default: 40 }}px;{%- endif -%}
