      "blocks": {
        "gt1": { "type": "column", "settings": { "eyebrow": "Your Code", "body": "<p>A code arrives by text and email with your ticket. Quote it at the door — we cross-reference it against your name.</p>", "align": "left" } },
        "gt2": { "type": "column", "settings": { "eyebrow": "House Rules", "body": "<p>21+ with government-issued ID. Tickets are named and non-transferable; every guest buys their own.</p>", "align": "left" } },
