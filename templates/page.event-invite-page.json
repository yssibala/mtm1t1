      "blocks": {
        "t1": { "type": "column", "settings": { "eyebrow": "Noon", "heading": "Thalia", "body": "<p>Elations After Noon — made with Joy and mixed with drops of Sunshine.</p><p>12.1% ABV · 6 fl oz</p>", "align": "center", "accent_color": "#EFA527", "heading_font": "ogg" } },
        "t2": { "type": "column", "settings": { "eyebrow": "Sunset", "heading": "Clio", "body": "<p>Spontaneity at Sunset — made with Sincerity and mixed with Pride.</p><p>12% ABV · 6 fl oz</p>", "align": "center", "accent_color": "#CC2200", "heading_font": "ogg" } },
        "t3": { "type": "column", "settings": { "eyebrow": "Night", "heading": "Ourania", "body": "<p>Elegance at Eventide — made with Purpose and mixed with Intention.</p><p>12.1% ABV · 6 fl oz</p>", "align": "center", "accent_color": "#8B5CF6", "heading_font": "ogg" } }
      },
