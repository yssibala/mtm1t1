    "dresscode": {
      "type": "text-columns",
      "settings": {
        "preheader": "Dress Code",
        "heading": "Cocktail, in Eventide",
        "subheading": "<p>Dress to the hour: lavender and violet for Ourania, or navy and beige for the house. Black is always welcome as a base.</p><p><strong>Encouraged:</strong> cocktail attire · suiting and separates · slip dresses · a violet accent worn somewhere visible. <strong>Please skip:</strong> denim · athletic wear · red — the night belongs to Ourania, not Clio.</p>",
        "accent_color": "#8B5CF6",
        "head_align": "center",
        "columns": 4,
        "heading_font": "ogg",
        "padding_top": 56,
        "padding_bottom": 40
      },
      "blocks": {
        "d1": { "type": "column", "settings": { "eyebrow": "Lavender", "body": "<p>The soft edge of eventide.</p>", "align": "center", "accent_color": "#B9A7E8" } },
        "d2": { "type": "column", "settings": { "eyebrow": "Violet", "body": "<p>Ourania herself. Wear it boldly.</p>", "align": "center", "accent_color": "#8B5CF6" } },
        "d3": { "type": "column", "settings": { "eyebrow": "Navy", "body": "<p>House color. Suiting, velvet, silk.</p>", "align": "center", "accent_color": "#1A2340" } },
        "d4": { "type": "column", "settings": { "eyebrow": "Beige", "body": "<p>House color. Warm, never stark white.</p>", "align": "center", "accent_color": "#B39B72" } }
      },
      "block_order": ["d1", "d2", "d3", "d4"]
    },
    "evening": {
      "type": "text-columns",
      "settings": {
        "preheader": "What the night includes",
        "heading": "The Evening",
        "subheading": "<p>A single seating, a single SKU at the center, and the people who inspired it. Ourania closes the day — so we open the doors as the light goes violet.</p>",
        "accent_color": "#8B5CF6",
        "head_align": "center",
        "columns": 3,
        "heading_font": "ogg",
        "padding_top": 56,
        "padding_bottom": 24
      },
      "blocks": {
        "e1": { "type": "column", "settings": { "heading": "Two Cocktails on the House", "body": "<p>Your first two pours are ours — Ourania over a single clear cube, or whichever sister you prefer.</p>", "align": "left", "heading_size": 20 } },
        "e2": { "type": "column", "settings": { "heading": "Guided Tasting of the Trio", "body": "<p>A led flight of all three recipes with the team who built them, in the order the day intends.</p>", "align": "left", "heading_size": 20 } },
        "e3": { "type": "column", "settings": { "heading": "Catered Dinner Service", "body": "<p>Full catering through the evening, styled to the line — passed plates and seated bites.</p>", "align": "left", "heading_size": 20 } }
      },
      "block_order": ["e1", "e2", "e3"]
    },
    "evening2": {
      "type": "text-columns",
      "settings": {
        "head_align": "center",
        "columns": 3,
        "padding_top": 0,
        "padding_bottom": 56
      },
      "blocks": {
        "e4": { "type": "column", "settings": { "heading": "Shuttle & Valet", "body": "<p>Complimentary valet at the door, plus a shuttle loop running to nearby parking all night.</p>", "align": "left", "heading_size": 20 } },
        "e5": { "type": "column", "settings": { "heading": "The Room, and the People In It", "body": "<p>Founders, makers, hospitality and creative professionals — an evening built for real introductions.</p>", "align": "left", "heading_size": 20 } },
        "e6": { "type": "column", "settings": { "heading": "Live Set & the Muses Toast", "body": "<p>One live set, one toast to the people who inspired the line, and an open floor after.</p>", "align": "left", "heading_size": 20 } }
      },
      "block_order": ["e4", "e5", "e6"]
    },
    "trio": {
      "type": "text-columns",
      "settings": {
        "preheader": "The full trio, poured once",
        "heading": "The Flagship Trio — In Full Attendance",
        "subheading": "<p>The night belongs to eventide, but noon and sunset make an appearance — one guided flight, all three recipes, in the order the day intends.</p>",
        "accent_color": "#8B5CF6",
        "head_align": "center",
        "columns": 3,
